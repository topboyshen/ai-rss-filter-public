[Unit]
Description=AI Filter historical exact-date pending close repair
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/ai-rss-filter
ExecStart=/usr/bin/python3 /root/ai-rss-filter/scripts/repair_market_close.py --scope=history
TimeoutStartSec=5min
UMask=0077
Nice=10
NoNewPrivileges=true
