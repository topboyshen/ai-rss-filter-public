+	hash := sha256.Sum256(received)
+	if preserved.DeliveryID != hex.EncodeToString(hash[:]) || preserved.BodySHA256 != preserved.DeliveryID || preserved.Contract != "synthetic-contract" {
+		t.Fatal("wrong exact-body identity")
+	}
+	var decoded map[string]any
+	if err = json.Unmarshal(preserved.Body, &decoded); err != nil || decoded["event_type"] != "save_entry" {
+		t.Fatal("not save-entry payload", err)
+	}
+	entry.Feed.WebhookURL = "https://override.invalid/webhook"
+	override, err := prepareLegacySave(entry, settings)
