+		if json.Unmarshal(body, &payload) != nil || payload["event_type"] != "save_entry" {
+			t.Fatal("legacy body changed")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("disabled legacy async delivery absent")
+	}
+}
