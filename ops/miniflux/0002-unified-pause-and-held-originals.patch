+	for _, mutate := range []func(*model.Entry){func(e *model.Entry) { e.ID = 0 }, func(e *model.Entry) { e.Feed = nil }, func(e *model.Entry) { e.Feed.Category = nil }, func(e *model.Entry) { e.FeedID = 9 }, func(e *model.Entry) { e.UserID = 2 }, func(e *model.Entry) { e.Content = strings.Repeat("x", webhook.MaxDurableBody) }} {
+		entry := legacyEntry()
