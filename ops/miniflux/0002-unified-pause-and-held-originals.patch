+func upgradeSeed(t *testing.T, db *sql.DB, legacy bool) string {
+	t.Helper()
+	_, err := db.Exec(`INSERT INTO webhook_outbox(delivery_id,body_sha256,user_id,feed_id,entry_id,target_url,signature,contract,body,state)
+ SELECT encode(sha256('old-held'::bytea),'hex'),encode(sha256('old-held'::bytea),'hex'),1,1,1,'https://synthetic.invalid',repeat('a',64),'synthetic','old-held'::bytea,'held'`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if legacy {
+		_, err = db.Exec(`INSERT INTO webhook_legacy_originals(delivery_id,body_sha256,event_type,user_id,feed_id,entry_id,target_url,signature,contract,body)
+ SELECT encode(sha256('legacy-held'::bytea),'hex'),encode(sha256('legacy-held'::bytea),'hex'),'save_entry',1,1,1,'https://synthetic.invalid',repeat('a',64),'synthetic','legacy-held'::bytea`)
+		if err != nil {
+			t.Fatal(err)
+		}
+		r, e := handoff.Initialize(context.Background(), db, strings.Repeat("a", 64), strings.Repeat("b", 64))
+		if e != nil || !r.Confirmed {
+			t.Fatal(r, e)
+		}
+	}
+	return upgradeEvidence(t, db, legacy)
+}
