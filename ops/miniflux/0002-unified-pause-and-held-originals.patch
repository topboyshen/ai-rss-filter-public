+// SPDX-License-Identifier: Apache-2.0
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestHandoffConfigurationFailClosedAndDefaultOff(t *testing.T) {
+	var unset *configOptions
+	if unset.HasHandoff() {
+		t.Fatal("uninitialized options must preserve default-off behavior")
+	}
+	if NewConfigOptions().HasHandoff() {
+		t.Fatal("default open control")
+	}
+	valid := []string{"HANDOFF_ENABLED=1", "WEBHOOK_OUTBOX=1", "WEBHOOK_OUTBOX_CONTRACT=synthetic",
+		"HANDOFF_MANIFEST=" + strings.Repeat("a", 64), "HANDOFF_CONTROL_TOKEN=" + strings.Repeat("b", 64),
+		"HANDOFF_CONTROL_ADDR=127.0.0.1:19002"}
+	cp := NewConfigParser()
+	if err := cp.parseLines(valid); err != nil {
+		t.Fatal(err)
+	}
+	if err := cp.options.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	for _, invalid := range []string{"WEBHOOK_OUTBOX=0", "WEBHOOK_OUTBOX_CONTRACT=", "WEBHOOK_OUTBOX_CONTRACT=   ", "HANDOFF_MANIFEST=bad", "HANDOFF_MANIFEST=" + strings.Repeat("A", 64), "HANDOFF_CONTROL_TOKEN=bad", "HANDOFF_CONTROL_TOKEN=" + strings.Repeat("B", 64), "HANDOFF_CONTROL_ADDR=:19002", "HANDOFF_CONTROL_ADDR=localhost:19002", "HANDOFF_CONTROL_ADDR=127.0.0.1:0", "HANDOFF_CONTROL_ADDR=127.0.0.1:banana", "HANDOFF_CONTROL_ADDR=192.0.2.1:19002"} {
+		t.Run(invalid, func(t *testing.T) {
+			cp := NewConfigParser()
+			key := strings.SplitN(invalid, "=", 2)[0] + "="
+			lines := []string{}
+			for _, line := range valid {
+				if !strings.HasPrefix(line, key) {
+					lines = append(lines, line)
+				}
+			}
+			if err := cp.parseLines(append(lines, invalid)); err != nil {
+				return
+			}
+			if cp.options.Validate() == nil {
+				t.Fatal("invalid handoff configuration accepted")
+			}
+		})
+	}
+}
