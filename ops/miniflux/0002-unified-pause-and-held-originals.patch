+         'legacy',(SELECT jsonb_agg(to_jsonb(l) ORDER BY delivery_id) FROM webhook_legacy_originals l),
+         'operations',(SELECT jsonb_agg(to_jsonb(o) ORDER BY operation_id) FROM handoff_operations o))::text`
+	}
+	var value string
+	if err := db.QueryRow(query).Scan(&value); err != nil {
