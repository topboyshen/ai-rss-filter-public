+)
+
+func legacyPGStore(t *testing.T) (*storage.Storage, *sql.DB) {
+	t.Helper()
+	dsn := os.Getenv("MINIFLUX_OUTBOX_TEST_DSN")
+	if dsn == "" {
+		t.Skip("explicit isolated PostgreSQL DSN not configured")
+	}
+	u, err := url.Parse(dsn)
+	if err != nil || (u.Hostname() != "127.0.0.1" && u.Hostname() != "localhost") || u.Path != "/synthetic_outbox" {
+		t.Fatal("only explicit local synthetic_outbox database is allowed")
+	}
+	db, err := sql.Open("postgres", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	schema := fmt.Sprintf("legacy_integration_%d", time.Now().UnixNano())
+	if _, err = db.Exec(`CREATE SCHEMA ` + schema); err != nil {
+		db.Close()
+		t.Fatal(err)
+	}
+	db.Close()
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err = sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	if err = database.Migrate(db); err != nil {
+		t.Fatal(err)
+	}
+	leaseDB, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaseDB.SetMaxOpenConns(8)
+	t.Cleanup(func() { leaseDB.Close() })
+	store := storage.NewStorage(db)
+	store.ConfigureHandoff(leaseDB)
+	if _, err = handoff.Initialize(context.Background(), db, strings.Repeat("a", 64), strings.Repeat("1", 64)); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("retained schema", schema)
+	return store, db
+}
+
+func TestPostgresLegacySavePreservedBeforeAsyncAndPauseWaitsForProvider(t *testing.T) {
+	configureLegacyTest(t, true)
+	store, db := legacyPGStore(t)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var once sync.Once
+	defer once.Do(func() { close(release) })
+	var webhookHits atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/webhook" {
+			webhookHits.Add(1)
+			w.WriteHeader(http.StatusAccepted)
+			return
+		}
+		close(entered)
+		<-release
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	// Release before server.Close even on an assertion failure.
+	defer once.Do(func() { close(release) })
+	entry := legacyEntry()
+	settings := &model.Integration{UserID: 1, WebhookEnabled: true, WebhookURL: server.URL + "/webhook", WebhookSecret: "synthetic-key", BetulaEnabled: true, BetulaURL: server.URL, BetulaToken: "synthetic-token"}
+	original, err := prepareLegacySave(entry, settings)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = StartSaveEntry(store, entry, settings); err != nil {
+		t.Fatal(err)
+	}
+	var body []byte
+	var state, signature string
+	if err = db.QueryRow(`SELECT body,state,signature FROM webhook_legacy_originals WHERE delivery_id=$1`, original.DeliveryID).Scan(&body, &state, &signature); err != nil || string(body) != string(original.Body) || state != "held" || signature != original.Signature {
+		t.Fatal("accepted before exact original committed", err)
+	}
+	select {
+	case <-entered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("tracked provider did not start")
+	}
+	pauseOp := strings.Repeat("2", 64)
+	receipt, err := handoff.Pause(context.Background(), db, strings.Repeat("a", 64), pauseOp)
+	if err != nil || receipt.Confirmed || receipt.ActiveLeases != 1 {
+		t.Fatal("inflight provider incorrectly declared drained", receipt, err)
+	}
+	changed := legacyEntry()
+	changed.ID = 8
+	if err = StartSaveEntry(store, changed, settings); err == nil {
+		t.Fatal("closing gate admitted another legacy save")
+	}
+	once.Do(func() { close(release) })
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		receipt, err = handoff.Query(context.Background(), db, strings.Repeat("a", 64), pauseOp)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if receipt.Confirmed {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("completed provider lease did not finish", receipt)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if receipt.ActiveLeases != 0 || receipt.UncertainLeases != 0 || webhookHits.Load() != 0 {
+		t.Fatal("held event dispatched or wrong drain", receipt)
+	}
+	var count int
+	if err = db.QueryRow(`SELECT count(*) FROM webhook_legacy_originals`).Scan(&count); err != nil || count != 1 {
+		t.Fatal("rejected save was preserved/accepted", err)
+	}
+}
+
+func TestPostgresLegacySaveWriteFailureCannotLaunchProviders(t *testing.T) {
+	configureLegacyTest(t, true)
+	store, db := legacyPGStore(t)
+	var hits atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { hits.Add(1); w.WriteHeader(http.StatusOK) }))
+	defer server.Close()
+	if _, err := db.Exec(`CREATE FUNCTION synthetic_legacy_no_space() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic disk full'; END $$;
+ CREATE TRIGGER synthetic_no_space BEFORE INSERT ON webhook_legacy_originals FOR EACH ROW EXECUTE FUNCTION synthetic_legacy_no_space();`); err != nil {
+		t.Fatal(err)
+	}
+	settings := &model.Integration{UserID: 1, WebhookEnabled: true, WebhookURL: server.URL + "/webhook", WebhookSecret: "synthetic", BetulaEnabled: true, BetulaURL: server.URL, BetulaToken: "synthetic"}
+	if StartSaveEntry(store, legacyEntry(), settings) == nil {
+		t.Fatal("failed preservation falsely accepted")
+	}
+	var count int
+	if err := db.QueryRow(`SELECT count(*) FROM webhook_legacy_originals`).Scan(&count); err != nil || count != 0 {
+		t.Fatal("failed row survived", err)
+	}
+	receipt, err := handoff.Pause(context.Background(), db, strings.Repeat("a", 64), strings.Repeat("3", 64))
+	if err != nil || !receipt.Confirmed || hits.Load() != 0 {
+		t.Fatal("failed preservation started provider or lost lease", receipt, err)
+	}
+}
