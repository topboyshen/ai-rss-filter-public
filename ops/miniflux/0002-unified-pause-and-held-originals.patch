+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	for {
+		var ready bool
+		if err := db.QueryRowContext(ctx, query, args...).Scan(&ready); err != nil {
+			t.Fatal("database handshake failed", err)
+		}
+		if ready {
+			return
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal("database handshake absent")
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+}
+
+func TestPostgresHandoffBackgroundWritesKeepRealRouteLeaseUntilDBReturns(t *testing.T) {
+	for _, operation := range []struct {
+		name, table, method, path string
+		status                    int
+	}{
+		{"flush_history", "entries", "PUT", "/v1/flush-history", 202},
+		{"remove_user", "users", "DELETE", "/v1/users/2", 204},
+	} {
+		for _, enabled := range []bool{true, false} {
+			t.Run(fmt.Sprintf("%s/enforced=%t", operation.name, enabled), func(t *testing.T) {
+				fixture := newBackgroundWriteFixture(t, enabled)
+				key := time.Now().UnixNano()%1000000000 + 1000000000
+				blocker, err := fixture.db.Begin()
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer blocker.Rollback()
+				if _, err = blocker.Exec(`SELECT pg_advisory_xact_lock($1)`, key); err != nil {
+					t.Fatal(err)
+				}
+				trigger := fmt.Sprintf(`CREATE FUNCTION synthetic_background_block() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN PERFORM pg_advisory_xact_lock(%d::bigint); RETURN OLD; END $$;
+ CREATE TRIGGER synthetic_background_block BEFORE DELETE ON %s FOR EACH ROW EXECUTE FUNCTION synthetic_background_block();`, key, operation.table)
+				if _, err = fixture.db.Exec(trigger); err != nil {
+					t.Fatal(err)
+				}
+				result := fixture.request(operation.method, operation.path)
+				received := false
+				defer func() {
+					_ = blocker.Rollback()
+					if !received {
+						select {
+						case <-result:
+						case <-time.After(4 * time.Second):
+							t.Error("request did not exit after synthetic lock release")
+						}
+					}
+				}()
+				// Prove the actual DELETE reached a blocked PostgreSQL advisory lock; no
+				// arbitrary sleep is used to infer that background work has begun.
+				waitBackgroundDBCondition(t, fixture.db, `SELECT EXISTS(SELECT 1 FROM pg_locks WHERE locktype='advisory' AND classid=0 AND objid=$1::oid AND NOT granted)`, key)
+				if enabled {
+					select {
+					case status := <-result:
+						received = true
+						t.Fatalf("enforced route responded %d before its database write finished", status)
+					default:
+					}
+				} else {
+					select {
+					case status := <-result:
+						received = true
+						if status != operation.status {
+							t.Fatal("disabled async behavior changed", status)
+						}
+					case <-time.After(4 * time.Second):
+						t.Fatal("disabled old asynchronous response blocked")
+					}
+				}
+				pause, err := handoff.Pause(context.Background(), fixture.db, strings.Repeat("a", 64), strings.Repeat("2", 64))
+				if err != nil {
+					t.Fatal(err)
+				}
+				if enabled && (pause.Confirmed || pause.ActiveLeases != 1) {
+					t.Fatal("pause falsely drained an in-flight database write", pause)
+				}
+				if !enabled && (!pause.Confirmed || pause.ActiveLeases != 0) {
+					t.Fatal("disabled behavior unexpectedly registered work", pause)
+				}
+				if err = blocker.Rollback(); err != nil {
+					t.Fatal(err)
+				}
+				if !received {
+					select {
+					case status := <-result:
+						received = true
+						if status != operation.status {
+							t.Fatal("actual route completion failed", status)
+						}
+					case <-time.After(4 * time.Second):
+						t.Fatal("route did not finish after database release")
+					}
+				}
+				absence := `SELECT NOT EXISTS(SELECT 1 FROM entries WHERE id=1)`
+				if operation.table == "users" {
+					absence = `SELECT NOT EXISTS(SELECT 1 FROM users WHERE id=2)`
+				}
+				waitBackgroundDBCondition(t, fixture.db, absence)
+				closed, err := handoff.Query(context.Background(), fixture.db, strings.Repeat("a", 64), strings.Repeat("2", 64))
+				if err != nil || !closed.Confirmed || closed.ActiveLeases != 0 || closed.UncertainLeases != 0 {
+					t.Fatal("finished write did not permit exact pause confirmation", closed, err)
+				}
+			})
+		}
+	}
+}
+
+func TestPostgresHandoffBackgroundWriteFailureDoesNotReturnAcceptance(t *testing.T) {
+	for _, operation := range []struct{ table, method, path string }{{"entries", "DELETE", "/v1/flush-history"}, {"users", "DELETE", "/v1/users/2"}} {
+		t.Run(operation.table, func(t *testing.T) {
+			fixture := newBackgroundWriteFixture(t, true)
+			if _, err := fixture.db.Exec(`CREATE FUNCTION synthetic_background_reject() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic database failure'; END $$;
+ CREATE TRIGGER synthetic_background_reject BEFORE DELETE ON ` + operation.table + ` FOR EACH ROW EXECUTE FUNCTION synthetic_background_reject();`); err != nil {
+				t.Fatal(err)
+			}
+			result := fixture.request(operation.method, operation.path)
+			select {
+			case status := <-result:
+				if status != 500 {
+					t.Fatal("failed DB write falsely accepted", status)
+				}
+			case <-time.After(4 * time.Second):
+				t.Fatal("rejected route did not finish")
+			}
+			retained := `SELECT EXISTS(SELECT 1 FROM entries WHERE id=1)`
+			if operation.table == "users" {
+				retained = `SELECT EXISTS(SELECT 1 FROM users WHERE id=2)`
+			}
+			waitBackgroundDBCondition(t, fixture.db, retained)
+			closed, err := handoff.Pause(context.Background(), fixture.db, strings.Repeat("a", 64), strings.Repeat("2", 64))
+			if err != nil || !closed.Confirmed {
+				t.Fatal("completed failure is not in-flight work", closed, err)
+			}
+		})
+	}
+}
