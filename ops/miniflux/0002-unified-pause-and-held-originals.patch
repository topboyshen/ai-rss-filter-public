diff --git a/internal/cli/handoff_control.go b/internal/cli/handoff_control.go
new file mode 100644
index 0000000..03ea94c
--- /dev/null
+++ b/internal/cli/handoff_control.go
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: Apache-2.0
+package cli
+
+import (
+	"context"
+	"crypto/subtle"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/handoff"
+	"miniflux.app/v2/internal/storage"
+
+	"github.com/lib/pq"
+)
+
+// handoffCategoryHeader carries only a fixed diagnostic enum on refusals. The
+// JSON body, status code and acceptance rules are unchanged.
+const handoffCategoryHeader = "X-Handoff-Error-Category"
+
+func handoffErrorCategory(err error) string {
+	var pgErr *pq.Error
+	switch {
+	case err == nil:
+		return "unconfirmed"
+	case errors.Is(err, context.DeadlineExceeded), errors.Is(err, context.Canceled):
+		return "deadline"
+	case errors.Is(err, handoff.ErrUncertain):
+		return "uncertain"
+	case errors.Is(err, handoff.ErrConflict):
+		return "conflict"
+	case errors.Is(err, handoff.ErrClosed):
+		return "closed"
+	case errors.Is(err, sql.ErrNoRows):
+		return "no_rows"
+	case errors.As(err, &pgErr) && pgErr.Code == "55P03":
+		return "lock"
+	case errors.As(err, &pgErr) && pgErr.Code == "57014":
+		return "deadline"
+	case errors.As(err, &pgErr):
+		return "db"
+	}
+	return "other"
+}
+
+func handoffFields(r *http.Request) (map[string]string, error) {
+	defer r.Body.Close()
+	decoder := json.NewDecoder(io.LimitReader(r.Body, 1025))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, errors.New("object required")
+	}
+	values := map[string]string{}
+	for decoder.More() {
+		key, err := decoder.Token()
+		name, ok := key.(string)
+		if err != nil || !ok || (name != "operation_id" && name != "closed_operation_id") {
+			return nil, errors.New("invalid field")
+		}
+		if _, exists := values[name]; exists {
+			return nil, errors.New("duplicate field")
+		}
+		var value string
+		if decoder.Decode(&value) != nil {
+			return nil, errors.New("string required")
+		}
+		values[name] = value
+	}
+	if _, err := decoder.Token(); err != nil {
+		return nil, err
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return nil, errors.New("trailing data")
+	}
+	if values["operation_id"] == "" {
+		return nil, errors.New("operation required")
+	}
+	return values, nil
+}
+
+func handoffControlHandler(store *storage.Storage) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		want := "Bearer " + config.Opts.HandoffControlToken()
+		if subtle.ConstantTimeCompare([]byte(r.Header.Get("Authorization")), []byte(want)) != 1 {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		if r.Method == "GET" && r.URL.Path == "/registration" {
+			json.NewEncoder(w).Encode(map[string]any{"schema": 1, "manifest": config.Opts.HandoffManifest(), "protocol": "miniflux-pg-handoff-v1", "business_open_not_assumed": true})
+			return
+		}
+		ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+		defer cancel()
+		if r.Method == "GET" && r.URL.Path == "/activation-registration" {
+			if err := store.ActivationHandoffAvailable(ctx); err != nil {
+				w.Header().Set(handoffCategoryHeader, handoffErrorCategory(err))
+				http.Error(w, "activation capability unavailable", http.StatusConflict)
+				return
+			}
+			json.NewEncoder(w).Encode(map[string]any{"schema": 1, "manifest": config.Opts.HandoffManifest(), "protocol": "miniflux-pg-activation-v1", "database_schema": 135, "capabilities": []string{"initialize_closed", "production_resume"}, "business_open_not_assumed": true})
+			return
+		}
+		var result any
+		var err error
+		if r.Method == "GET" && strings.HasPrefix(r.URL.Path, "/operations/") {
+			result, err = store.QueryHandoff(ctx, strings.TrimPrefix(r.URL.Path, "/operations/"))
+		} else if r.Method == "POST" {
+			var fields map[string]string
+			fields, err = handoffFields(r)
+			if err == nil {
+				switch r.URL.Path {
+				case "/initialize-closed":
+					if len(fields) != 1 {
+						err = errors.New("exact closed initialize fields required")
+						break
+					}
+					result, err = store.InitializeClosedHandoff(ctx, fields["operation_id"])
+				case "/production-resume":
+					if len(fields) != 2 {
+						err = errors.New("exact production resume fields required")
+						break
+					}
+					result, err = store.ResumeProductionHandoff(ctx, fields["closed_operation_id"], fields["operation_id"])
+				case "/initialize":
+					result, err = store.InitializeHandoff(ctx, fields["operation_id"])
+				case "/stop-new":
+					result, err = store.StopNewHandoff(ctx, fields["operation_id"])
+				case "/pause":
+					result, err = store.PauseHandoff(ctx, fields["operation_id"])
+				case "/resume":
+					result, err = store.ResumeHandoff(ctx, fields["closed_operation_id"], fields["operation_id"])
+				default:
+					http.NotFound(w, r)
+					return
+				}
+			}
+		} else {
+			http.NotFound(w, r)
+			return
+		}
+		receipt, ok := result.(handoff.Receipt)
+		confirmed := err == nil && ok && receipt.Durable && receipt.Confirmed
+		if !confirmed {
+			w.Header().Set(handoffCategoryHeader, handoffErrorCategory(err))
+			w.WriteHeader(http.StatusConflict)
+		}
+		json.NewEncoder(w).Encode(map[string]any{"result": result, "confirmed": confirmed})
+	})
+}
+
+func startHandoffControl(store *storage.Storage) (*http.Server, error) {
+	if !config.Opts.HasHandoff() {
+		return nil, nil
+	}
+	listener, err := net.Listen("tcp", config.Opts.HandoffControlAddr())
+	if err != nil {
+		return nil, err
+	}
+	server := &http.Server{Handler: handoffControlHandler(store), ReadHeaderTimeout: time.Second,
+		ReadTimeout: 4 * time.Second, WriteTimeout: 4 * time.Second, IdleTimeout: time.Second}
+	go server.Serve(listener)
+	return server, nil
+}
