+
+func TestRejectMalformedIdentityWithoutDatabase(t *testing.T) {
+	for _, value := range []string{"", strings.Repeat("a", 63), strings.Repeat("A", 64), "../" + strings.Repeat("a", 61)} {
+		if validate(value, strings.Repeat("b", 64)) == nil {
