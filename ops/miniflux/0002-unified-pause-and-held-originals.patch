+
+func TestLegacyPreservedPayloadIsExactOriginalSerializationAndSignature(t *testing.T) {
+	configureLegacyTest(t, false)
+	entry := legacyEntry()
+	var received []byte
+	var signature string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		received, _ = io.ReadAll(r.Body)
+		signature = r.Header.Get("X-Miniflux-Signature")
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer server.Close()
+	settings := &model.Integration{UserID: 1, WebhookEnabled: true, WebhookURL: server.URL, WebhookSecret: "synthetic-key"}
