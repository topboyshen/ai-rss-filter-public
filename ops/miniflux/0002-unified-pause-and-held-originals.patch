+func TestEnforcedDirectLegacyPathsCannotDispatchAndUnboundSaveRejects(t *testing.T) {
+	configureLegacyTest(t, true)
+	var hits atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { hits.Add(1); w.WriteHeader(http.StatusAccepted) }))
+	defer server.Close()
+	entry := legacyEntry()
+	settings := &model.Integration{UserID: 1, WebhookEnabled: true, WebhookURL: server.URL, WebhookSecret: "synthetic"}
+	SendEntry(entry, settings)
+	PushEntries(entry.Feed, model.Entries{entry}, settings)
+	if err := webhook.NewClient(server.URL, "synthetic").SendSaveEntryWebhookEvent(entry); err == nil {
+		t.Fatal("direct webhook bypass allowed")
+	}
+	if err := webhook.NewClient(server.URL, "synthetic").SendNewEntriesWebhookEvent(entry.Feed, model.Entries{entry}); err == nil {
+		t.Fatal("direct new entries bypass allowed")
+	}
