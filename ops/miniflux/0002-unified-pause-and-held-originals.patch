--- /dev/null
+++ b/internal/worker/drain_integration_test.go
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: Apache-2.0
+package worker
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"miniflux.app/v2/internal/handoff"
+)
+
+func TestPostgresStopNewDrainsExactExistingBodyButFullPauseStopsClaims(t *testing.T) {
+	f := idlePostgres(t)
+	ctx := context.Background()
+	body := `{"synthetic":"durable before stop-new"}`
+	var seen atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, err := io.ReadAll(io.LimitReader(r.Body, 2048))
+		if err != nil || string(raw) != body {
+			t.Error("body changed", err)
+		}
+		seen.Add(1)
+		sum := sha256.Sum256(raw)
+		id := hex.EncodeToString(sum[:])
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusAccepted)
+		json.NewEncoder(w).Encode(map[string]any{"schema": 1, "durable": true, "delivery_id": id, "body_sha256": id})
+	}))
+	defer server.Close()
+	f.put(t, body, server.URL, "pending", false)
+	f.put(t, "retained held original", "https://must-not-send.invalid", "held", false)
+	r, err := handoff.StopNew(ctx, f.db, strings.Repeat("a", 64), strings.Repeat("e", 64))
+	if err != nil || !r.Confirmed || r.State != "draining" {
+		t.Fatal(r, err)
+	}
+	if _, err = f.store.BeginHandoff("manual_save"); err == nil {
+		t.Fatal("manual producer admitted")
+	}
+	runWebhookOutboxPass(ctx, f.store)
+	var state string
+	var attempts int
+	var raw []byte
+	if err = f.db.QueryRow(`SELECT state,attempts,body FROM webhook_outbox WHERE target_url=$1`, server.URL).Scan(&state, &attempts, &raw); err != nil || state != "acked" || attempts != 1 || string(raw) != body || seen.Load() != 1 {
+		t.Fatal(state, attempts, seen.Load(), err)
+	}
+	if err = f.db.QueryRow(`SELECT state,attempts,body FROM webhook_outbox WHERE target_url='https://must-not-send.invalid'`).Scan(&state, &attempts, &raw); err != nil || state != "held" || attempts != 0 || string(raw) != "retained held original" {
+		t.Fatal("held changed", state, attempts, err)
+	}
+	// Synthetic direct fixture insertion represents another durable backlog row.
+	f.put(t, "pending before full freeze", server.URL, "pending", false)
+	r, err = handoff.Pause(ctx, f.db, strings.Repeat("a", 64), strings.Repeat("d", 64))
+	if err != nil || !r.Confirmed {
+		t.Fatal(r, err)
+	}
+	before := f.leaseCount(t)
+	for range 3 {
+		runWebhookOutboxPass(ctx, f.store)
+	}
+	if seen.Load() != 1 || f.leaseCount(t) != before {
+		t.Fatal("full pause allowed another claim")
+	}
+	if err = f.db.QueryRow(`SELECT attempts FROM webhook_outbox WHERE state='pending'`).Scan(&attempts); err != nil || attempts != 0 {
+		t.Fatal("pending changed", attempts, err)
+	}
+}
+
+func TestPostgresOutboxPassCannotWasteFinalLeaseSlot(t *testing.T) {
+	f := idlePostgres(t)
+	f.put(t, "pending original", "https://must-not-send.invalid", "pending", false)
+	_, err := f.db.Exec(`INSERT INTO handoff_leases(lease_id,manifest,source,status,backend_pid,finished_at)
+ SELECT lpad(to_hex(n),32,'0'),$1,'retained_fixture','finished',1,now() FROM generate_series(1,$2) n`, strings.Repeat("a", 64), handoff.MaxRetainedRecords-1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	runWebhookOutboxPass(context.Background(), f.store)
+	if f.leaseCount(t) != handoff.MaxRetainedRecords-1 {
+		t.Fatal("pass consumed final slot without sender")
+	}
+	var attempts int
+	var body []byte
+	if err = f.db.QueryRow(`SELECT attempts,body FROM webhook_outbox`).Scan(&attempts, &body); err != nil || attempts != 0 || string(body) != "pending original" {
+		t.Fatal(attempts, string(body), err)
+	}
+}
+
+func TestPostgresReservedFirstSenderAlreadyClaimedFinishesWithoutSend(t *testing.T) {
+	f := idlePostgres(t)
+	f.put(t, "competing claim original", "https://must-not-send.invalid", "pending", false)
+	pass, sender, err := f.store.BeginOutboxPass()
+	if err != nil {
+		t.Fatal(err)
+	}
+	claim, err := f.store.ClaimWebhook(context.Background())
+	if err != nil || claim == nil {
+		t.Fatal(claim, err)
+	}
+	if runWebhookWithLease(context.Background(), f.store, sender, true) {
+		t.Fatal("reserved sender resent competing claim")
+	}
+	if err = pass.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	var active, attempts int
+	var state string
+	if err = f.db.QueryRow(`SELECT count(*) FROM handoff_leases WHERE status<>'finished'`).Scan(&active); err != nil || active != 0 {
+		t.Fatal(active, err)
+	}
+	if err = f.db.QueryRow(`SELECT state,attempts FROM webhook_outbox`).Scan(&state, &attempts); err != nil || state != "inflight" || attempts != 1 {
+		t.Fatal(state, attempts, err)
+	}
+}
