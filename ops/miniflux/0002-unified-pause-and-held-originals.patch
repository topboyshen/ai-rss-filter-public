+func legacyEntry() *model.Entry {
+	return &model.Entry{ID: 7, UserID: 1, FeedID: 3, Hash: "original-hash", Title: "Synthetic α & <value>", URL: "https://synthetic.invalid/article?q=1", Content: "original\ncontent", Date: time.Unix(1700000000, 0).UTC(), Feed: &model.Feed{ID: 3, UserID: 1, Category: &model.Category{ID: 2, Title: "Synthetic"}, FeedURL: "https://synthetic.invalid/feed"}}
