+	if err != nil || !r.Confirmed {
+		t.Fatal("failed pair retained a phantom lease", r, err)
+	}
+}
+
+func TestPGConcurrentOutboxPairsCannotStealFinalTwoSlots(t *testing.T) {
+	f := startGate(t)
+	upgradeDrain(t, f)
+	retainedFinished(t, f, MaxRetainedRecords-2)
+	type result struct {
+		pass, sender *Lease
+		err          error
+	}
+	start := make(chan struct{})
+	results := make(chan result, 2)
+	for range 2 {
+		go func() {
+			<-start
+			p, s, e := BeginOutboxPass(context.Background(), f.pool, testManifest)
+			results <- result{p, s, e}
+		}()
+	}
+	close(start)
+	var accepted []result
+	for range 2 {
+		r := <-results
+		if r.err == nil {
+			accepted = append(accepted, r)
+		}
+	}
+	if len(accepted) != 1 {
+		t.Fatalf("accepted pairs %d", len(accepted))
+	}
+	var count, active int
+	if err := f.db.QueryRow(`SELECT count(*),count(*) FILTER(WHERE status='active') FROM handoff_leases`).Scan(&count, &active); err != nil || count != MaxRetainedRecords || active != 2 {
+		t.Fatal(count, active, err)
+	}
+	r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || r.Confirmed || r.ActiveLeases != 2 {
+		t.Fatal(r, err)
+	}
+	if err = accepted[0].sender.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	if err = accepted[0].pass.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	r, err = Query(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !r.Confirmed {
+		t.Fatal(r, err)
+	}
+}
+
+func TestPGOutboxPairSecondConnectionFailureLeavesNoRowsOrLocks(t *testing.T) {
+	f := startGate(t)
+	upgradeDrain(t, f)
+	f.pool.SetMaxOpenConns(1)
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	if _, _, err := BeginOutboxPass(ctx, f.pool, testManifest); err == nil {
+		t.Fatal("second connection unexpectedly available")
+	}
+	var count int
+	if err := f.db.QueryRow(`SELECT count(*) FROM handoff_leases`).Scan(&count); err != nil || count != 0 {
+		t.Fatal(count, err)
+	}
+	r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !r.Confirmed {
+		t.Fatal("session lock leaked", r, err)
+	}
+}
+
+func TestPGOutboxPairSecondInsertFailureRollsBackBothRows(t *testing.T) {
+	f := startGate(t)
+	upgradeDrain(t, f)
+	_, err := f.db.Exec(`CREATE FUNCTION reject_second_pair() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.source='outbox_sender' THEN RAISE EXCEPTION 'synthetic second lease write failure'; END IF; RETURN NEW; END $$;
+ CREATE TRIGGER reject_second_pair BEFORE INSERT ON handoff_leases FOR EACH ROW EXECUTE FUNCTION reject_second_pair();`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = BeginOutboxPass(context.Background(), f.pool, testManifest); err == nil {
+		t.Fatal("second write accepted")
+	}
+	var count int
+	if err = f.db.QueryRow(`SELECT count(*) FROM handoff_leases`).Scan(&count); err != nil || count != 0 {
+		t.Fatal(count, err)
+	}
+	r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !r.Confirmed {
+		t.Fatal("rollback leaked lock", r, err)
+	}
+}
+
+func TestPGCommittedPairLostBeforeWorkerCannotConfirmFreeze(t *testing.T) {
+	f := startGate(t)
+	upgradeDrain(t, f)
+	pass, sender, err := BeginOutboxPass(context.Background(), f.pool, testManifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Actual session death after durable commit models losing the returned leases.
+	if _, err = f.db.Exec(`SELECT pg_terminate_backend(backend_pid) FROM handoff_leases WHERE status='active'`); err != nil {
+		t.Fatal(err)
+	}
+	if err = pass.Finish(); err == nil {
+		t.Fatal("dead pass falsely finished")
+	}
+	if err = sender.Finish(); err == nil {
+		t.Fatal("dead sender falsely finished")
+	}
+	stopped, err := StopNew(context.Background(), f.db, testManifest, stopNewOp)
+	if err != nil || !stopped.Confirmed || stopped.ActiveLeases != 2 {
+		t.Fatal("producer state or retained consumer evidence wrong", stopped, err)
+	}
+	for range 2 {
+		r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+		if err != nil || r.Confirmed || r.ActiveLeases != 2 {
+			t.Fatal("lost worker falsely froze", r, err)
+		}
+	}
+}
diff --git a/internal/http/request/handoff.go b/internal/http/request/handoff.go
new file mode 100644
index 0000000..3f7b10a
--- /dev/null
+++ b/internal/http/request/handoff.go
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+package request
+
+import (
+	"context"
+	"log/slog"
+	"net/http"
+	"sync"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/handoff"
+)
+
+type handoffScopeKey struct{}
+
+// HandoffScope owns a lazily acquired lease for the WHOLE request, including
+// authentication bookkeeping and response/session persistence. It does not
+// authenticate credentials. Only existing successful auth paths may Acquire.
+type HandoffScope struct {
+	mu                  sync.Mutex
+	acquire             func() (*handoff.Lease, error)
+	lease               *handoff.Lease
+	attempted, finished bool
+	err                 error
+}
+
+func WithHandoffScope(r *http.Request, acquire func() (*handoff.Lease, error)) (*http.Request, *HandoffScope) {
+	scope := &HandoffScope{acquire: acquire}
+	return r.WithContext(context.WithValue(r.Context(), handoffScopeKey{}, scope)), scope
+}
+
+// AcquireAuthenticatedHandoff must be called AFTER actual credential/session
+// validation and BEFORE the first auth timestamp, session or business write.
+// Missing outer request ownership fails closed when the feature is enabled.
+func AcquireAuthenticatedHandoff(w http.ResponseWriter, r *http.Request) bool {
+	if !config.Opts.HasHandoff() {
+		return true
+	}
+	scope, ok := r.Context().Value(handoffScopeKey{}).(*HandoffScope)
+	if !ok || scope == nil {
+		http.Error(w, "handoff request ownership missing", http.StatusServiceUnavailable)
+		return false
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.finished {
+		http.Error(w, "handoff request already finished", http.StatusServiceUnavailable)
+		return false
+	}
+	if !scope.attempted {
+		scope.attempted = true
+		if scope.acquire == nil {
+			scope.err = handoff.ErrConflict
+		} else {
+			scope.lease, scope.err = scope.acquire()
+		}
+		if scope.err == nil && scope.lease == nil {
+			scope.err = handoff.ErrUncertain
+		}
+	}
+	if scope.err != nil {
+		http.Error(w, "handoff closed or unconfirmed", http.StatusServiceUnavailable)
+		return false
+	}
+	return true
+}
+
+// FinishOnReturn is directly deferred by the outer HTTP wrapper. A panic is
+// retained as uncertain and rethrown, not converted to a finished lease.
+func (s *HandoffScope) FinishOnReturn() {
+	recovered := recover()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.finished {
+		s.finished = true
+		if s.lease != nil {
+			var err error
+			if recovered != nil {
+				err = s.lease.Abort()
+			} else {
+				err = s.lease.Finish()
+			}
+			if err != nil {
+				slog.Error("handoff HTTP completion remains unconfirmed", "error", err)
+			}
+		}
+	}
+	if recovered != nil {
+		panic(recovered)
+	}
+}
