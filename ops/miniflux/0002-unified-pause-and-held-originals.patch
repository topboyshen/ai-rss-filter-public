+
+func TestNilAndFabricatedLeaseFailClosed(t *testing.T) {
+	ctx := context.Background()
+	manifest := strings.Repeat("a", 64)
+	op := strings.Repeat("b", 64)
+	if _, e := Begin(ctx, nil, manifest, "scheduler"); e == nil {
+		t.Fatal("nil DB admitted")
+	}
+	if _, e := Initialize(ctx, nil, manifest, op); e == nil {
+		t.Fatal("nil DB initialized")
+	}
+	if _, e := Pause(ctx, nil, manifest, op); e == nil {
+		t.Fatal("nil DB paused")
+	}
+	if _, e := Query(ctx, nil, manifest, op); e == nil {
+		t.Fatal("nil DB queried")
+	}
+	if _, e := Resume(ctx, nil, manifest, op, strings.Repeat("c", 64)); e == nil {
+		t.Fatal("nil DB resumed")
+	}
+	for _, lease := range []*Lease{nil, {}} {
+		if e := lease.Check(ctx); e == nil {
+			t.Fatal("fabricated lease checked")
+		}
+		if e := lease.Matches(nil, manifest); e == nil {
+			t.Fatal("fabricated lease matched")
+		}
+		if e := lease.Finish(); e == nil {
+			t.Fatal("fabricated lease finished")
+		}
+		if e := lease.Abort(); e == nil {
+			t.Fatal("fabricated lease aborted")
+		}
+	}
+}
+
+func TestLeaseOutcomesAreNotInterchangeable(t *testing.T) {
+	l := &Lease{done: "finished"}
+	if e := l.Finish(); e != nil {
+		t.Fatal(e)
+	}
+	if e := l.Abort(); !errors.Is(e, ErrConflict) {
+		t.Fatalf("finished changed: %v", e)
+	}
+	l = &Lease{done: "uncertain"}
+	if e := l.Abort(); e != nil {
+		t.Fatal(e)
+	}
+	if e := l.Finish(); !errors.Is(e, ErrConflict) {
+		t.Fatalf("uncertain changed: %v", e)
+	}
+}
+
+func TestSchemaHasNoImplicitOpenAndRetainsEvidence(t *testing.T) {
+	if strings.Contains(SchemaSQL, "INSERT INTO") {
+		t.Fatal("migration opens gate")
+	}
+	for _, piece := range []string{"handoff_operations_guard", "handoff_leases_guard", "BEFORE UPDATE OR DELETE", "status IN ('active','finished','uncertain')"} {
+		if !strings.Contains(SchemaSQL, piece) {
+			t.Fatal(piece)
+		}
+	}
+	if MaxRetainedRecords != 10000 {
+		t.Fatal("retention bound changed")
+	}
+}
+
+func TestDeferredCompletionPreservesPanicIncludingDisabledGate(t *testing.T) {
+	for _, lease := range []*Lease{nil, {done: "uncertain"}} {
+		func() {
+			defer func() {
+				if recover() != "original panic" {
+					t.Error("panic changed or swallowed")
+				}
+			}()
+			defer FinishOnReturn(lease)
+			panic("original panic")
+		}()
+	}
+	func() { defer FinishOnReturn(nil) }()
+	func() { defer FinishOnReturn(&Lease{done: "finished"}) }()
+}
