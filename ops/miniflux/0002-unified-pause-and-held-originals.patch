+}
+
+func TestPostgresLegacyOriginalSharedByteCap(t *testing.T) {
+	store, _, _ := realOutboxStore(t)
+	// Synthetic historical outbox materialization bypasses admission ONLY to
+	// reach the real 256MiB boundary cheaply; final preservation is real SQL.
+	_, err := store.db.Exec(`INSERT INTO webhook_outbox(delivery_id,body_sha256,user_id,feed_id,entry_id,target_url,signature,contract,body)
+ SELECT encode(sha256(body),'hex'),encode(sha256(body),'hex'),1,1,-i,'https://receiver.invalid',repeat('a',64),'audit',body
+ FROM (SELECT i,(lpad(i::text,6,'0')||repeat('x',1048570))::bytea AS body FROM generate_series(1,256) i) originals`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = store.PreserveLegacyWebhook(legacyOriginal(7), 1, 1, 7); err == nil || !strings.Contains(err.Error(), "capacity") {
+		t.Fatal("shared byte limit bypass", err)
+	}
+	if legacyCount(t, store) != 0 {
+		t.Fatal("byte-full original committed")
+	}
+}
+
+func TestPostgresLegacyOriginalFailureBusyAndTimeoutHaveNoAcceptedRow(t *testing.T) {
+	store, _, _ := realOutboxStore(t)
+	tx, err := store.db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = tx.Exec(`SELECT pg_advisory_xact_lock(19500622)`); err != nil {
+		t.Fatal(err)
+	}
+	started := time.Now()
+	err = store.PreserveLegacyWebhook(legacyOriginal(7), 1, 1, 7)
+	if err == nil || time.Since(started) > time.Second {
+		t.Fatal("capacity lock did not immediately backpressure", err)
+	}
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	if legacyCount(t, store) != 0 {
+		t.Fatal("busy write committed")
+	}
+	_, err = store.db.Exec(`CREATE FUNCTION synthetic_legacy_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic disk unavailable'; END $$;
+ CREATE TRIGGER synthetic_legacy_fail BEFORE INSERT ON webhook_legacy_originals FOR EACH ROW EXECUTE FUNCTION synthetic_legacy_failure();`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if store.PreserveLegacyWebhook(legacyOriginal(7), 1, 1, 7) == nil || legacyCount(t, store) != 0 {
+		t.Fatal("write failure accepted")
+	}
+	_, err = store.db.Exec(`CREATE OR REPLACE FUNCTION synthetic_legacy_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN PERFORM pg_sleep(5); RETURN NEW; END $$;`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	started = time.Now()
+	err = store.PreserveLegacyWebhook(legacyOriginal(7), 1, 1, 7)
+	if err == nil || time.Since(started) > 4*time.Second || legacyCount(t, store) != 0 {
+		t.Fatal("bounded statement failure did not roll back", err)
+	}
+}
+
+func TestPostgresLegacyOriginalConcurrentExactDuplicates(t *testing.T) {
+	store, _, _ := realOutboxStore(t)
+	item := legacyOriginal(7)
+	var wait sync.WaitGroup
+	results := make(chan error, 16)
+	for range 16 {
+		wait.Add(1)
+		go func() { defer wait.Done(); results <- store.PreserveLegacyWebhook(item, 1, 1, 7) }()
+	}
+	wait.Wait()
+	close(results)
+	accepted := 0
+	for err := range results {
+		if err == nil {
+			accepted++
+		} else if !strings.Contains(err.Error(), "capacity lock unavailable") {
+			t.Fatal(err)
+		}
+	}
+	if accepted == 0 || legacyCount(t, store) != 1 {
+		t.Fatal("parallel preservation identity lost")
+	}
+	// Explicit isolated re-delivery confirms the retained bytes, not an internal
+	// retry loop or a production replay.
+	if err := store.PreserveLegacyWebhook(item, 1, 1, 7); err != nil {
+		t.Fatal(err)
+	}
+}
