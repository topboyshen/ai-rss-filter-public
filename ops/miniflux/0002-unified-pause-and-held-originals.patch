@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: Apache-2.0
+package cli
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/lib/pq"
+	"miniflux.app/v2/internal/handoff"
+)
+
+func TestHandoffControlStrictCommandBody(t *testing.T) {
+	for _, body := range []string{`{}`, `{"operation_id":"a","operation_id":"b"}`, `{"operation_id":true}`, `{"operation_id":"a","unknown":"b"}`, `{"operation_id":"a"} {}`, "{\"operation_id\":\"" + strings.Repeat("a", 1100) + "\"}"} {
+		if _, err := handoffFields(httptest.NewRequest("POST", "/pause", strings.NewReader(body))); err == nil {
+			t.Fatal("accepted malformed command")
+		}
+	}
+	fields, err := handoffFields(httptest.NewRequest("POST", "/pause", strings.NewReader(`{"operation_id":"exact"}`)))
+	if err != nil || fields["operation_id"] != "exact" {
+		t.Fatal("valid command rejected")
+	}
+}
+
+func TestHandoffErrorCategoryIsFixedEnum(t *testing.T) {
+	cases := map[string]error{
+		"unconfirmed": nil,
+		"deadline":    fmt.Errorf("wrapped: %w", context.DeadlineExceeded),
+		"uncertain":   handoff.ErrUncertain,
+		"conflict":    handoff.ErrConflict,
+		"closed":      handoff.ErrClosed,
+		"no_rows":     sql.ErrNoRows,
+		"lock":        &pq.Error{Code: "55P03", Message: "secret detail"},
+		"db":          &pq.Error{Code: "08006"},
+		"other":       errors.New("token=secret"),
+	}
+	for want, err := range cases {
+		if got := handoffErrorCategory(err); got != want {
+			t.Fatalf("%s: got %s", want, got)
+		}
+	}
+	if handoffErrorCategory(&pq.Error{Code: "57014"}) != "deadline" {
+		t.Fatal("statement cancel must be deadline")
+	}
+}
