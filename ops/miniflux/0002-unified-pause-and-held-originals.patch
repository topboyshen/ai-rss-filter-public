+	requestctx "miniflux.app/v2/internal/http/request"
+	"miniflux.app/v2/internal/storage"
+)
+
+func TestPostgresHandoffHTTPAllEntrancesRemainClosedAfterPause(t *testing.T) {
+	dsn := os.Getenv("MINIFLUX_OUTBOX_TEST_DSN")
+	if dsn == "" {
+		t.Skip("requires explicit isolated PostgreSQL")
+	}
+	u, err := url.Parse(dsn)
+	if err != nil || u.Hostname() != "127.0.0.1" || u.Path != "/synthetic_outbox" {
+		t.Fatal("synthetic loopback DB required")
+	}
+	db, err := sql.Open("postgres", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	schema := fmt.Sprintf("pause_http_%d", time.Now().UnixNano())
+	if _, err = db.Exec("CREATE SCHEMA " + schema); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err = sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	leaseDB, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer leaseDB.Close()
+	if err = database.Migrate(db); err != nil {
+		t.Fatal(err)
+	}
+	prior := config.Opts
+	t.Cleanup(func() { config.Opts = prior })
+	for key, value := range map[string]string{"HANDOFF_ENABLED": "1", "HANDOFF_MANIFEST": strings.Repeat("a", 64), "HANDOFF_CONTROL_TOKEN": strings.Repeat("b", 64), "HANDOFF_CONTROL_ADDR": "127.0.0.1:19002", "WEBHOOK_OUTBOX": "1", "WEBHOOK_OUTBOX_CONTRACT": "synthetic"} {
+		t.Setenv(key, value)
+	}
+	config.Opts, err = config.NewConfigParser().ParseEnvironmentVariables()
+	if err != nil {
+		t.Fatal(err)
+	}
+	store := storage.NewStorage(db)
+	store.ConfigureHandoff(leaseDB)
+	called := 0
+	// This protocol-only handler represents a successful credential check.
+	// The actual REST/Fever/Google/UI authentication paths are covered separately.
+	handler := handoffAdmission(store, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/healthz" && !requestctx.AcquireAuthenticatedHandoff(w, r) {
+			return
+		}
+		called++
+		w.WriteHeader(204)
+	}))
+	request := func(path string) int {
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, httptest.NewRequest("POST", path, nil))
+		return w.Code
+	}
+	if request("/v1/feeds/1/refresh") != 503 || called != 0 {
+		t.Fatal("missing initialize bypassed")
+	}
+	if _, err = handoff.Initialize(context.Background(), db, strings.Repeat("a", 64), strings.Repeat("c", 64)); err != nil {
+		t.Fatal(err)
+	}
+	if request("/v1/feeds/1/refresh") != 204 || called != 1 {
+		t.Fatal("initialized request rejected")
+	}
+	if _, err = handoff.Pause(context.Background(), db, strings.Repeat("a", 64), strings.Repeat("d", 64)); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"/v1/feeds/1/refresh", "/feeds/refresh", "/feed/1/refresh", "/v1/entries/1/save", "/entry/1/save", "/fever/", "/reader/api/0/"} {
+		if request(path) != 503 {
+			t.Fatal("closed route bypassed", path)
+		}
+	}
+	if called != 1 {
+		t.Fatal("paused handler executed")
+	}
+	if request("/healthz") != 204 {
+		t.Fatal("health should not claim business open")
+	}
+}
