+// SPDX-License-Identifier: Apache-2.0
+package server
+
+import (
+	"net/http"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/handoff"
+	"miniflux.app/v2/internal/http/request"
+	"miniflux.app/v2/internal/storage"
+)
+
+// Existing successful authentication paths acquire this request-owned lease
+// before their first write. Anonymous/static/OPTIONS failures do not fill the
+// retained lease registry. Health never proves business admission.
+func handoffAdmission(store *storage.Storage, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !config.Opts.HasHandoff() {
+			next.ServeHTTP(w, r)
+			return
+		}
+		switch r.URL.Path {
+		case "/liveness", "/healthz", "/readiness", "/readyz", "/healthcheck":
+			next.ServeHTTP(w, r)
+			return
+		}
+		r, scope := request.WithHandoffScope(r, func() (*handoff.Lease, error) { return store.BeginHandoff("authenticated_http") })
+		defer scope.FinishOnReturn()
+		next.ServeHTTP(w, r)
+	})
+}
