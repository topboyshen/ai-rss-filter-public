+)
+
+func handoffConfig(t *testing.T, enabled bool) {
+	t.Helper()
+	prior := config.Opts
+	t.Cleanup(func() { config.Opts = prior })
+	flag := "0"
+	if enabled {
+		flag = "1"
+	}
+	for k, v := range map[string]string{"HANDOFF_ENABLED": flag, "HANDOFF_MANIFEST": strings.Repeat("a", 64), "HANDOFF_CONTROL_TOKEN": strings.Repeat("b", 64), "HANDOFF_CONTROL_ADDR": "127.0.0.1:19002", "WEBHOOK_OUTBOX": "1", "WEBHOOK_OUTBOX_CONTRACT": "synthetic"} {
+		t.Setenv(k, v)
+	}
+	var err error
+	config.Opts, err = config.NewConfigParser().ParseEnvironmentVariables()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestHandoffScopeDisabledIsNoopWithoutOwner(t *testing.T) {
+	handoffConfig(t, false)
+	w := httptest.NewRecorder()
+	r := httptest.NewRequest("GET", "/unmatched", nil)
+	if !AcquireAuthenticatedHandoff(w, r) {
+		t.Fatal("disabled behavior changed")
+	}
+	r, _ = WithHandoffScope(r, func() (*handoff.Lease, error) { t.Fatal("disabled touched gate"); return nil, nil })
+	if !AcquireAuthenticatedHandoff(w, r) {
+		t.Fatal("disabled scope changed behavior")
+	}
+}
+
+func TestHandoffScopeEnabledMissingOwnerFailsClosed(t *testing.T) {
+	handoffConfig(t, true)
+	w := httptest.NewRecorder()
+	if AcquireAuthenticatedHandoff(w, httptest.NewRequest("GET", "/v1/me", nil)) || w.Code != 503 {
+		t.Fatal("unowned request passed")
+	}
+}
+
+func TestHandoffScopeFailedAcquireIsNeverRetriedInsideSameRequest(t *testing.T) {
+	handoffConfig(t, true)
+	calls := 0
+	r, scope := WithHandoffScope(httptest.NewRequest("GET", "/v1/me", nil), func() (*handoff.Lease, error) { calls++; return nil, errors.New("synthetic closed") })
+	for range 3 {
+		w := httptest.NewRecorder()
+		if AcquireAuthenticatedHandoff(w, r) || w.Code != 503 {
+			t.Fatal("failed acquisition passed")
+		}
+	}
+	scope.FinishOnReturn()
+	if calls != 1 {
+		t.Fatal("retried original uncertain acquisition", calls)
+	}
+}
+
+func TestHandoffScopeNilLeaseAndFinishedOwnerFailClosed(t *testing.T) {
+	handoffConfig(t, true)
+	calls := 0
+	r, scope := WithHandoffScope(httptest.NewRequest("GET", "/v1/me", nil), func() (*handoff.Lease, error) { calls++; return nil, nil })
+	if AcquireAuthenticatedHandoff(httptest.NewRecorder(), r) {
+		t.Fatal("nil lease passed")
+	}
+	scope.FinishOnReturn()
+	if AcquireAuthenticatedHandoff(httptest.NewRecorder(), r) {
+		t.Fatal("finished request passed")
+	}
+	if calls != 1 {
+		t.Fatal(calls)
+	}
+}
+
+func TestHandoffScopeAnonymousDoesNotAcquireAndPanicIsPreserved(t *testing.T) {
+	handoffConfig(t, true)
+	_, scope := WithHandoffScope(httptest.NewRequest("GET", "/unknown", nil), func() (*handoff.Lease, error) { t.Fatal("unauthenticated acquired"); return nil, nil })
+	func() {
+		defer func() {
+			if recover() != "original" {
+				t.Error("original panic changed")
+			}
+		}()
+		defer scope.FinishOnReturn()
+		panic("original")
+	}()
+	if !scope.finished {
+		t.Fatal("owner not finished")
+	}
+}
