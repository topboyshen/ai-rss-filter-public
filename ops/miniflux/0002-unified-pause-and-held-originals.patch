+ SELECT encode(sha256(i::text::bytea),'hex'),encode(sha256(i::text::bytea),'hex'),1,1,-i,'https://receiver.invalid',repeat('a',64),'audit',i::text::bytea FROM generate_series(1,4999) i`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = store.PreserveLegacyWebhook(item, 1, 1, 7); err != nil {
+		t.Fatal("durable exact duplicate rejected at full", err)
+	}
+	if err = store.PreserveLegacyWebhook(legacyOriginal(8), 1, 1, 8); err == nil || !strings.Contains(err.Error(), "capacity") {
+		t.Fatal("combined legacy limit bypass", err)
+	}
+	if _, err = store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("shared-full")}, false, prepare); err == nil || !strings.Contains(err.Error(), "capacity") {
+		t.Fatal("outbox ignored retained legacy charge", err)
+	}
+	entries, outbox := realCounts(t, store)
+	if entries != 0 || outbox != 4999 || legacyCount(t, store) != 1 {
+		t.Fatal("shared-full write was not atomic")
