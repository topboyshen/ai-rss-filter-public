+	if e = f.db.QueryRow(`SELECT (SELECT last_login_at IS NOT NULL FROM users WHERE username='synthetic') OR (SELECT last_used_at IS NOT NULL FROM api_keys WHERE token=$1)`, f.key).Scan(&wrote); e != nil {
+		t.Fatal(e)
