+	defer blocker.Rollback()
+	if _, e = blocker.Exec(`LOCK TABLE api_keys IN ACCESS EXCLUSIVE MODE`); e != nil {
+		t.Fatal(e)
+	}
+	result := make(chan int, 1)
+	go func() {
+		result <- f.serve("GET", "/v1/me", "", func(r *http.Request) { r.Header.Set("X-Auth-Token", f.key) }).Code
+	}()
+	defer func() { _ = blocker.Rollback() }()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	for {
+		var waiting bool
+		if e = f.db.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM pg_locks WHERE relation='api_keys'::regclass AND mode='AccessShareLock' AND NOT granted)`).Scan(&waiting); e != nil {
+			t.Fatal(e)
+		}
+		if waiting {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal("actual credential lookup did not block")
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+	f.pause(t)
+	if e = blocker.Rollback(); e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case status := <-result:
+		if status != 503 {
+			t.Fatal("authentication raced past closed gate", status)
+		}
+	case <-time.After(4 * time.Second):
