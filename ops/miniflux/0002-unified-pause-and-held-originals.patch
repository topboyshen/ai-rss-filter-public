+++ b/internal/worker/handoff_integration_test.go
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: Apache-2.0
+package worker
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/database"
+	"miniflux.app/v2/internal/handoff"
+	"miniflux.app/v2/internal/storage"
+)
+
+type idleFixture struct {
+	db    *sql.DB
+	store *storage.Storage
+}
+
+func idlePostgres(t *testing.T) idleFixture {
+	t.Helper()
+	raw := os.Getenv("MINIFLUX_OUTBOX_TEST_DSN")
+	if raw == "" {
+		t.Skip("explicit isolated PostgreSQL required; not persistence proof")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "postgres" || (u.Hostname() != "127.0.0.1" && u.Hostname() != "localhost") || u.Path != "/synthetic_outbox" {
+		t.Fatal("synthetic loopback PostgreSQL only")
+	}
+	admin, err := sql.Open("postgres", raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var random [12]byte
+	if _, err = rand.Read(random[:]); err != nil {
+		t.Fatal(err)
+	}
+	schema := "pause_worker_" + hex.EncodeToString(random[:])
+	if _, err = admin.Exec(`CREATE SCHEMA ` + schema); err != nil {
+		admin.Close()
+		t.Fatal(err)
+	}
+	admin.Close()
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(8)
+	leaseDB, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaseDB.SetMaxOpenConns(8)
+	t.Cleanup(func() { leaseDB.Close(); db.Close() })
+	if err = database.Migrate(db); err != nil {
+		t.Fatal(err)
+	}
+	prior := config.Opts
+	t.Cleanup(func() { config.Opts = prior })
+	for key, value := range map[string]string{"HANDOFF_ENABLED": "1", "HANDOFF_MANIFEST": strings.Repeat("a", 64), "HANDOFF_CONTROL_TOKEN": strings.Repeat("b", 64), "HANDOFF_CONTROL_ADDR": "127.0.0.1:19002", "WEBHOOK_OUTBOX": "1", "WEBHOOK_OUTBOX_CONTRACT": "synthetic", "INTEGRATION_ALLOW_PRIVATE_NETWORKS": "1"} {
+		t.Setenv(key, value)
+	}
+	config.Opts, err = config.NewConfigParser().ParseEnvironmentVariables()
+	if err != nil {
+		t.Fatal(err)
+	}
+	store := storage.NewStorage(db)
+	store.ConfigureHandoff(leaseDB)
+	if _, err = handoff.Initialize(context.Background(), db, strings.Repeat("a", 64), strings.Repeat("c", 64)); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("retained worker schema", schema)
+	return idleFixture{db, store}
+}
+
+func (f idleFixture) leaseCount(t *testing.T) int {
+	t.Helper()
+	var n int
+	if e := f.db.QueryRow(`SELECT count(*) FROM handoff_leases`).Scan(&n); e != nil {
+		t.Fatal(e)
+	}
+	return n
+}
+
+func (f idleFixture) put(t *testing.T, body, target, state string, old bool) {
+	t.Helper()
+	raw := []byte(body)
+	sum := sha256.Sum256(raw)
+	id := hex.EncodeToString(sum[:])
+	_, err := f.db.Exec(`INSERT INTO webhook_outbox(delivery_id,body_sha256,user_id,feed_id,entry_id,target_url,signature,contract,body,state,acked_at) VALUES($1,$1,1,1,(SELECT COALESCE(max(entry_id),0)+1 FROM webhook_outbox),$2,$3,'synthetic',$4,$5,CASE WHEN $6 THEN now()-interval '8 days' ELSE NULL END)`, id, target, strings.Repeat("b", 64), raw, state, old)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPostgresHandoffIdlePollsDoNotConsumeRetainedLeases(t *testing.T) {
+	f := idlePostgres(t)
+	ctx := context.Background()
+	for range 32 {
+		runWebhookOutboxPass(ctx, f.store)
+	}
+	if n := f.leaseCount(t); n != 0 {
+		t.Fatalf("empty polling consumed %d leases", n)
+	}
+	if ready, e := f.store.HasWebhookOutboxWork(ctx, true); e != nil || ready {
+		t.Fatal(ready, e)
+	}
+	r, e := handoff.Pause(ctx, f.db, strings.Repeat("a", 64), strings.Repeat("d", 64))
+	if e != nil || !r.Confirmed {
+		t.Fatal(r, e)
+	}
+	for range 4 {
+		runWebhookOutboxPass(ctx, f.store)
+	}
+	if n := f.leaseCount(t); n != 0 {
+		t.Fatal("closed empty poll admitted", n)
+	}
+}
+
+func TestPostgresHandoffDueDeliveryKeepsGuardAndDoesNotGenerateIdleLeases(t *testing.T) {
+	f := idlePostgres(t)
+	body := `{"synthetic":"original exact bytes"}`
+	var seen atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, e := io.ReadAll(io.LimitReader(r.Body, 2048))
+		if e != nil || string(raw) != body {
+			t.Error("original body changed", e)
+		}
+		seen.Add(1)
+		sum := sha256.Sum256(raw)
+		id := hex.EncodeToString(sum[:])
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusAccepted)
+		_ = json.NewEncoder(w).Encode(map[string]any{"schema": 1, "durable": true, "delivery_id": id, "body_sha256": id})
+	}))
+	defer server.Close()
+	f.put(t, body, server.URL, "pending", false)
+	if ready, e := f.store.HasWebhookOutboxWork(context.Background(), false); e != nil || !ready {
+		t.Fatal(ready, e)
+	}
+	runWebhookOutboxPass(context.Background(), f.store)
+	var state string
+	var attempts int
+	if e := f.db.QueryRow(`SELECT state,attempts FROM webhook_outbox`).Scan(&state, &attempts); e != nil {
+		t.Fatal(e)
+	}
+	if state != "acked" || attempts != 1 || seen.Load() != 1 {
+		t.Fatal(state, attempts, seen.Load())
+	}
+	n := f.leaseCount(t)
+	if n != 2 {
+		t.Fatalf("pass/send must each be guarded, got %d", n)
+	}
+	var unfinished int
+	if e := f.db.QueryRow(`SELECT count(*) FROM handoff_leases WHERE status<>'finished'`).Scan(&unfinished); e != nil || unfinished != 0 {
+		t.Fatal(unfinished, e)
+	}
+	for range 16 {
+		runWebhookOutboxPass(context.Background(), f.store)
+	}
+	if f.leaseCount(t) != n || seen.Load() != 1 {
+		t.Fatal("idle or fresh ACK was reprocessed")
+	}
+}
+
+func TestPostgresHandoffCleanupCandidateHasGuardButNoSendLease(t *testing.T) {
+	f := idlePostgres(t)
+	f.put(t, "synthetic retained receipt", "https://must-not-send.invalid", "acked", true)
+	ctx := context.Background()
+	if ready, e := f.store.HasWebhookOutboxWork(ctx, false); e != nil || ready {
+		t.Fatal("cleanup mistaken for delivery", ready, e)
+	}
+	if ready, e := f.store.HasWebhookOutboxWork(ctx, true); e != nil || !ready {
+		t.Fatal("cleanup missing", ready, e)
+	}
+	runWebhookOutboxPass(ctx, f.store)
+	if f.leaseCount(t) != 1 {
+		t.Fatal("cleanup guard missing or idle sender admitted")
+	}
+	var rows int
+	if e := f.db.QueryRow(`SELECT count(*) FROM webhook_outbox`).Scan(&rows); e != nil || rows != 0 {
+		t.Fatal(rows, e)
+	}
+	for range 8 {
+		runWebhookOutboxPass(ctx, f.store)
+	}
+	if f.leaseCount(t) != 1 {
+		t.Fatal("cleanup idle leases")
+	}
+}
+
+func TestPostgresHandoffPausedDueOrCleanupCannotMutateOriginals(t *testing.T) {
+	for _, item := range []struct {
+		state string
+		old   bool
+	}{{"pending", false}, {"acked", true}} {
+		t.Run(item.state, func(t *testing.T) {
+			f := idlePostgres(t)
+			f.put(t, "preserved after pause", "https://must-not-send.invalid", item.state, item.old)
+			ctx := context.Background()
+			r, e := handoff.Pause(ctx, f.db, strings.Repeat("a", 64), strings.Repeat("d", 64))
+			if e != nil || !r.Confirmed {
+				t.Fatal(r, e)
+			}
+			if ready, e := f.store.HasWebhookOutboxWork(ctx, true); e != nil || !ready {
+				t.Fatal("fixture not candidate", ready, e)
+			}
+			for range 4 {
+				runWebhookOutboxPass(ctx, f.store)
+			}
+			var state string
+			var raw []byte
+			var attempts int
+			if e = f.db.QueryRow(`SELECT state,body,attempts FROM webhook_outbox`).Scan(&state, &raw, &attempts); e != nil {
+				t.Fatal(e)
+			}
+			if state != item.state || string(raw) != "preserved after pause" || attempts != 0 || f.leaseCount(t) != 0 {
+				t.Fatal("paused worker mutated original", state, attempts)
+			}
+		})
+	}
+}
