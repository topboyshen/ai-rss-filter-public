+)
+
+func configureLegacyTest(t *testing.T, enabled bool) {
+	t.Helper()
+	previous := config.Opts
+	t.Cleanup(func() { config.Opts = previous })
+	value := "0"
+	if enabled {
+		value = "1"
+	}
+	t.Setenv("HANDOFF_ENABLED", value)
+	t.Setenv("WEBHOOK_OUTBOX", "1")
+	t.Setenv("WEBHOOK_OUTBOX_CONTRACT", "synthetic-contract")
+	t.Setenv("HANDOFF_MANIFEST", strings.Repeat("a", 64))
+	t.Setenv("HANDOFF_CONTROL_TOKEN", strings.Repeat("b", 64))
+	t.Setenv("HANDOFF_CONTROL_ADDR", "127.0.0.1:19002")
+	t.Setenv("INTEGRATION_ALLOW_PRIVATE_NETWORKS", "1")
+	opts, err := config.NewConfigParser().ParseEnvironmentVariables()
+	if err != nil {
+		t.Fatal(err)
+	}
