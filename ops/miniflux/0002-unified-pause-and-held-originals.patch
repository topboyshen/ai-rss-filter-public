diff --git a/internal/handoff/activation.go b/internal/handoff/activation.go
new file mode 100644
index 0000000..ea6385d
--- /dev/null
+++ b/internal/handoff/activation.go
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: Apache-2.0
+package handoff
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+)
+
+// Migration 135 is append-only. It does not rewrite any earlier receipt or
+// original. A closed initialization proves admission state, never queue emptiness
+// or coverage of sends that happened before instrumentation.
+const ActivationSchemaSQL = `
+ALTER TABLE handoff_operations DROP CONSTRAINT handoff_operations_action_check;
+ALTER TABLE handoff_operations ADD CONSTRAINT handoff_operations_action_check
+ CHECK(action IN ('initialize','initialize_closed','stop_new','pause','resume'));
+`
+
+func MigrateActivation(tx *sql.Tx) error { _, err := tx.Exec(ActivationSchemaSQL); return err }
+
+func activationSchema(ctx context.Context, tx *sql.Tx) error {
+	var count, supported int
+	if err := tx.QueryRowContext(ctx, `SELECT count(*),count(*) FILTER(WHERE version COLLATE "C"='135') FROM schema_version`).Scan(&count, &supported); err != nil {
+		return err
+	}
+	if count != 1 || supported != 1 {
+		return ErrConflict
+	}
+	return nil
+}
+
+// ActivationAvailable is a capability check, not an admission/open receipt.
+func ActivationAvailable(ctx context.Context, db *sql.DB) error {
+	if db == nil {
+		return ErrConflict
+	}
+	tx, err := db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true})
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if err = activationSchema(ctx, tx); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+func closedInitialReceipt(ctx context.Context, tx *sql.Tx, s state, manifest, op string) (Receipt, error) {
+	r, err := readReceipt(ctx, tx, manifest, op)
+	if err != nil {
+		return Receipt{}, err
+	}
+	if s.manifest != manifest || s.operation != op || s.phase != "closed" || s.generation != 0 || r.Action != "initialize_closed" || r.PreviousGeneration != -1 || r.Generation != 0 || !r.Confirmed || r.ActiveLeases != 0 || r.UncertainLeases != 0 {
+		return Receipt{}, ErrConflict
+	}
+	if err = activationSchema(ctx, tx); err != nil {
+		return Receipt{}, err
+	}
+	return r, nil
+}
+
+// InitializeClosed creates both the durable operation and CLOSED state in one
+// transaction. Missing state already refuses admission; no OPEN interval exists.
+// An unknown commit may only be recovered by querying the exact operation.
+func InitializeClosed(ctx context.Context, db *sql.DB, manifest, op string) (Receipt, error) {
+	var empty Receipt
+	if db == nil {
+		return empty, ErrConflict
+	}
+	if err := validate(manifest, op); err != nil {
+		return empty, err
+	}
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer discard(conn)
+	got, err := activity(ctx, conn, false)
+	if err != nil {
+		return empty, err
+	}
+	if !got {
+		return empty, ErrUncertain
+	}
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	if err = activationSchema(ctx, tx); err != nil {
+		return empty, err
+	}
+	s, err := readState(ctx, tx)
+	if err == nil {
+		r, e := closedInitialReceipt(ctx, tx, s, manifest, op)
+		if e != nil {
+			return empty, e
+		}
+		if e = tx.Commit(); e != nil {
+			return empty, e
+		}
+		r.Durable = true
+		return r, nil
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		return empty, err
+	}
+	var rows int
+	if err = tx.QueryRowContext(ctx, `SELECT (SELECT count(*) FROM handoff_operations)+(SELECT count(*) FROM handoff_leases)`).Scan(&rows); err != nil {
+		return empty, err
+	}
+	if rows != 0 {
+		return empty, ErrConflict
+	}
+	if err = insertOperation(ctx, tx, manifest, op, "initialize_closed", "", -1, true); err != nil {
+		return empty, err
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO handoff_state VALUES(1,$1,0,'closed',$2)`, manifest, op); err != nil {
+		return empty, err
+	}
+	s, err = readState(ctx, tx)
+	if err != nil {
+		return empty, err
+	}
+	r, err := closedInitialReceipt(ctx, tx, s, manifest, op)
+	if err != nil {
+		return empty, err
+	}
+	if err = tx.Commit(); err != nil {
+		return empty, err
+	}
+	r.Durable = true
+	return r, nil
+}
+
+// ResumeProduction requires the reviewed capability inside the same CAS
+// transaction. Receiver capability verification is the source-bound host
+// controller's job; this endpoint alone grants no cross-service safety proof.
+func ResumeProduction(ctx context.Context, db *sql.DB, manifest, closedOp, newOp string) (Receipt, error) {
+	return resume(ctx, db, manifest, closedOp, newOp, true)
+}
+
+func confirmInitialClosed(ctx context.Context, conn *sql.Conn, manifest, op string) (Receipt, error) {
+	got, err := exclusiveActivityBounded(ctx, conn)
+	if err != nil {
+		return Receipt{}, err
+	}
+	if !got {
+		return Receipt{}, ErrUncertain
+	}
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return Receipt{}, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if err != nil {
+		return Receipt{}, err
+	}
+	r, err := closedInitialReceipt(ctx, tx, s, manifest, op)
+	if err != nil {
+		return Receipt{}, err
+	}
+	if err = tx.Commit(); err != nil {
+		return Receipt{}, err
+	}
+	r.Durable = true
+	return r, nil
+}
