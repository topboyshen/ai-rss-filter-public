+	if e := json.Unmarshal(login.Body.Bytes(), &token); e != nil {
+		t.Fatal(e)
+	}
+	gr := func(r *http.Request) { r.Header.Set("Authorization", "GoogleLogin auth="+token["Auth"]) }
+	if w := f.serve("GET", "/reader/api/0/token", "", gr); w.Code != 200 {
+		t.Fatal(w.Code, w.Body.String())
+	}
+	if w := f.serve("GET", "/manifest.json", "", ui); w.Code != 200 {
+		t.Fatal(w.Code, w.Body.String())
+	}
+	if f.count(t) != 6 {
+		t.Fatal("actual credential paths not each owned", f.count(t))
+	}
+	f.pause(t)
+	var loginBefore, keyBefore string
+	if e := f.db.QueryRow(`SELECT last_login_at::text FROM users WHERE username='synthetic'`).Scan(&loginBefore); e != nil {
+		t.Fatal(e)
+	}
+	if e := f.db.QueryRow(`SELECT last_used_at::text FROM api_keys WHERE token=$1`, f.key).Scan(&keyBefore); e != nil {
+		t.Fatal(e)
+	}
+	for _, c := range []struct {
+		method, path, body string
+		prepare            func(*http.Request)
+	}{{"GET", "/v1/me", "", api}, {"GET", "/v1/me", "", basic}, {"POST", "/fever/", "api_key=synthetic-fever", nil}, {"POST", "/accounts/ClientLogin", "Email=synthetic-gr&Passwd=only-isolated-password", nil}, {"GET", "/reader/api/0/token", "", gr}, {"GET", "/manifest.json", "", ui}} {
+		if w := f.serve(c.method, c.path, c.body, c.prepare); w.Code != 503 {
+			t.Fatal("authenticated request crossed pause", c.path, w.Code)
+		}
+	}
+	var loginAfter, keyAfter string
+	_ = f.db.QueryRow(`SELECT last_login_at::text FROM users WHERE username='synthetic'`).Scan(&loginAfter)
+	_ = f.db.QueryRow(`SELECT last_used_at::text FROM api_keys WHERE token=$1`, f.key).Scan(&keyAfter)
+	if f.count(t) != 6 || loginBefore != loginAfter || keyBefore != keyAfter {
+		t.Fatal("paused credential path wrote before gate")
+	}
+}
