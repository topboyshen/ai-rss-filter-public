diff --git a/internal/storage/handoff.go b/internal/storage/handoff.go
new file mode 100644
index 0000000..274765b
--- /dev/null
+++ b/internal/storage/handoff.go
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+package storage
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"time"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/handoff"
+)
+
+// ConfigureHandoff must receive a separate bounded connection pool using the
+// same exact DSN. Held session locks must not starve ordinary business SQL.
+func (s *Storage) ConfigureHandoff(db *sql.DB) { s.handoffDB = db }
+
+func (s *Storage) BeginHandoff(source string) (*handoff.Lease, error) {
+	if !config.Opts.HasHandoff() {
+		return nil, nil
+	}
+	if s.handoffDB == nil {
+		return nil, errors.New("handoff lease pool not configured")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	return handoff.Begin(ctx, s.handoffDB, config.Opts.HandoffManifest(), source)
+}
+
+func (s *Storage) ValidateHandoffLease(lease *handoff.Lease) error {
+	if !config.Opts.HasHandoff() {
+		if lease != nil {
+			return errors.New("foreign lease while handoff disabled")
+		}
+		return nil
+	}
+	if lease == nil || s.handoffDB == nil {
+		return errors.New("missing admitted lease")
+	}
+	return lease.Matches(s.handoffDB, config.Opts.HandoffManifest())
+}
+
+func (s *Storage) InitializeHandoff(ctx context.Context, op string) (handoff.Receipt, error) {
+	return handoff.Initialize(ctx, s.db, config.Opts.HandoffManifest(), op)
+}
+func (s *Storage) PauseHandoff(ctx context.Context, op string) (handoff.Receipt, error) {
+	return handoff.Pause(ctx, s.db, config.Opts.HandoffManifest(), op)
+}
+func (s *Storage) QueryHandoff(ctx context.Context, op string) (handoff.Receipt, error) {
+	return handoff.Query(ctx, s.db, config.Opts.HandoffManifest(), op)
+}
+func (s *Storage) ResumeHandoff(ctx context.Context, closed, op string) (handoff.Receipt, error) {
+	return handoff.Resume(ctx, s.db, config.Opts.HandoffManifest(), closed, op)
+}
+
+// BeginOutboxHandoff is only for the durable outbox cleanup/claim/send lifecycle.
+func (s *Storage) BeginOutboxHandoff(source string) (*handoff.Lease, error) {
+	if !config.Opts.HasHandoff() {
+		return nil, nil
+	}
+	if s.handoffDB == nil {
+		return nil, errors.New("handoff lease pool not configured")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	return handoff.BeginOutbox(ctx, s.handoffDB, config.Opts.HandoffManifest(), source)
+}
+
+func (s *Storage) StopNewHandoff(ctx context.Context, op string) (handoff.Receipt, error) {
+	return handoff.StopNew(ctx, s.db, config.Opts.HandoffManifest(), op)
+}
+
+// BeginOutboxPass reserves both actual retained leases in one transaction.
+func (s *Storage) BeginOutboxPass() (*handoff.Lease, *handoff.Lease, error) {
+	if !config.Opts.HasHandoff() {
+		return nil, nil, nil
+	}
+	if s.handoffDB == nil {
+		return nil, nil, errors.New("handoff lease pool not configured")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	return handoff.BeginOutboxPass(ctx, s.handoffDB, config.Opts.HandoffManifest())
+}
+
+func (s *Storage) InitializeClosedHandoff(ctx context.Context, op string) (handoff.Receipt, error) {
+	return handoff.InitializeClosed(ctx, s.db, config.Opts.HandoffManifest(), op)
+}
+func (s *Storage) ResumeProductionHandoff(ctx context.Context, closed, op string) (handoff.Receipt, error) {
+	return handoff.ResumeProduction(ctx, s.db, config.Opts.HandoffManifest(), closed, op)
+}
+func (s *Storage) ActivationHandoffAvailable(ctx context.Context) error {
+	return handoff.ActivationAvailable(ctx, s.db)
+}
diff --git a/internal/storage/legacy_handoff.go b/internal/storage/legacy_handoff.go
new file mode 100644
index 0000000..ca7853b
--- /dev/null
+++ b/internal/storage/legacy_handoff.go
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: Apache-2.0
+package storage
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"regexp"
+
+	"miniflux.app/v2/internal/model"
+)
+
+var legacySignature = regexp.MustCompile(`^[a-f0-9]{64}$`)
+
+// PreserveLegacyWebhook freezes existing-entry save events BEFORE async work
+// or HTTP acceptance. It does not assert delivery, enqueue a send, or retry.
+func (s *Storage) PreserveLegacyWebhook(item *model.DurableWebhook, userID, feedID, entryID int64) error {
+	if item == nil || userID <= 0 || feedID <= 0 || entryID <= 0 || item.Contract == "" || !legacySignature.MatchString(item.Signature) || len(item.Body) == 0 || len(item.Body) > 1048576 {
+		return errors.New("legacy preservation: invalid original")
+	}
+	hash := sha256.Sum256(item.Body)
+	u, err := url.Parse(item.URL)
+	if item.DeliveryID != hex.EncodeToString(hash[:]) || item.BodySHA256 != item.DeliveryID || err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") || u.User != nil || u.Fragment != "" {
+		return errors.New("legacy preservation: original identity invalid")
+	}
+	var payload struct {
+		EventType string `json:"event_type"`
+		Entry     struct {
+			ID     int64 `json:"id"`
+			UserID int64 `json:"user_id"`
+			FeedID int64 `json:"feed_id"`
+		} `json:"entry"`
+	}
+	if err = json.Unmarshal(item.Body, &payload); err != nil || payload.EventType != "save_entry" || payload.Entry.ID != entryID || payload.Entry.UserID != userID || payload.Entry.FeedID != feedID {
+		return errors.New("legacy preservation: save payload identity mismatch")
+	}
+	tx, err := s.beginEntryTransaction(true)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err = tx.Exec(`SET LOCAL synchronous_commit=on; SET LOCAL statement_timeout='3s'; SET LOCAL lock_timeout='3s'`); err != nil {
+		return err
+	}
+	var durable, locked bool
+	if err = tx.QueryRow(`SELECT current_setting('fsync')='on' AND current_setting('full_page_writes')='on',pg_try_advisory_xact_lock(19500622)`).Scan(&durable, &locked); err != nil {
+		return err
+	}
+	if !durable || !locked {
+		return errors.New("legacy preservation: durability or shared capacity lock unavailable")
+	}
+	var raw []byte
+	var target, signature, contract string
+	var user, feed, entry int64
+	err = tx.QueryRow(`SELECT body,target_url,signature,contract,user_id,feed_id,entry_id FROM webhook_legacy_originals WHERE delivery_id=$1`, item.DeliveryID).Scan(&raw, &target, &signature, &contract, &user, &feed, &entry)
+	if err == nil {
+		if !bytes.Equal(raw, item.Body) || target != item.URL || signature != item.Signature || contract != item.Contract || user != userID || feed != feedID || entry != entryID {
+			return errors.New("legacy preservation: conflicting duplicate")
+		}
+		return tx.Commit()
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		return err
+	}
+	var count, size int64
+	err = tx.QueryRow(`SELECT count(*),COALESCE(sum(octet_length(body)+octet_length(target_url)+octet_length(contract)+1024),0)
+ FROM (SELECT body,target_url,contract FROM webhook_outbox UNION ALL SELECT body,target_url,contract FROM webhook_legacy_originals) originals`).Scan(&count, &size)
+	if err != nil {
+		return err
+	}
+	if count >= WebhookOutboxMaxRows || size+int64(len(item.Body)+len(item.URL)+len(item.Contract)+1024) > WebhookOutboxMaxBytes {
+		return errors.New("legacy preservation: shared capacity exhausted")
+	}
+	_, err = tx.Exec(`INSERT INTO webhook_legacy_originals(delivery_id,body_sha256,event_type,user_id,feed_id,entry_id,target_url,signature,contract,body)
+ VALUES($1,$2,'save_entry',$3,$4,$5,$6,$7,$8,$9)`, item.DeliveryID, item.BodySHA256, userID, feedID, entryID, item.URL, item.Signature, item.Contract, item.Body)
+	if err != nil {
+		return err
+	}
+	return tx.Commit()
+}
