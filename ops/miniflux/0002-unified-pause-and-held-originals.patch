+
+// Every phase logs before the next potentially failing operation. CI retains
+// the full log and schema, including failures; no original rows are deleted.
+func upgradeFixture(t *testing.T, version int) (*sql.DB, string) {
+	t.Helper()
+	raw := os.Getenv("MINIFLUX_OUTBOX_TEST_DSN")
+	if raw == "" {
+		t.Skip("actual synthetic PostgreSQL not configured")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "postgres" || (u.Hostname() != "127.0.0.1" && u.Hostname() != "localhost") || u.Path != "/synthetic_outbox" {
+		t.Fatal("refuse non-isolated migration database")
+	}
+	admin, err := sql.Open("postgres", raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Close()
+	var entropy [12]byte
+	if _, err = rand.Read(entropy[:]); err != nil {
+		t.Fatal(err)
+	}
+	schema := "handoff_upgrade_" + hex.EncodeToString(entropy[:])
+	if _, err = admin.Exec("CREATE SCHEMA " + schema); err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("phase=allocated retained_schema=%s target_start=%d", schema, version)
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(4)
+	t.Cleanup(func() { db.Close() })
+	for current := 0; current < version; current++ {
+		tx, e := db.Begin()
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = migrations[current](tx); e == nil {
+			_, e = tx.Exec("TRUNCATE schema_version")
+			if e == nil {
+				_, e = tx.Exec("INSERT INTO schema_version(version) VALUES($1)", current+1)
+			}
+		}
+		if e != nil {
+			tx.Rollback()
+			t.Fatal(current+1, e)
+		}
+		if e = tx.Commit(); e != nil {
+			t.Fatal(current+1, e)
+		}
+	}
+	t.Logf("phase=actual_prior_schema_committed version=%d", version)
+	return db, u.String()
+}
