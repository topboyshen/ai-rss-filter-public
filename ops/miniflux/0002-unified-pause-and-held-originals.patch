index 0000000..73d5293
--- /dev/null
+++ b/internal/integration/handoff.go
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: Apache-2.0
+package integration
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"log/slog"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/crypto"
+	"miniflux.app/v2/internal/integration/webhook"
+	"miniflux.app/v2/internal/model"
+	"miniflux.app/v2/internal/storage"
+)
+
+func prepareLegacySave(entry *model.Entry, settings *model.Integration) (*model.DurableWebhook, error) {
+	if entry == nil || entry.ID <= 0 || entry.Feed == nil || entry.Feed.Category == nil || entry.FeedID != entry.Feed.ID || entry.UserID != entry.Feed.UserID || settings == nil || settings.UserID != entry.UserID || settings.WebhookSecret == "" {
+		return nil, errors.New("legacy save original identity incomplete")
+	}
+	target := settings.WebhookURL
+	if entry.Feed.WebhookURL != "" {
+		target = entry.Feed.WebhookURL
+	}
+	body, err := json.Marshal(webhook.SaveEntryPayload(entry))
+	if err != nil {
+		return nil, err
+	}
+	if len(body) > webhook.MaxDurableBody {
+		return nil, errors.New("legacy save original exceeds bound")
+	}
+	hash := sha256.Sum256(body)
+	id := hex.EncodeToString(hash[:])
+	return &model.DurableWebhook{DeliveryID: id, BodySHA256: id, Body: body, URL: target, Signature: crypto.GenerateSHA256Hmac(settings.WebhookSecret, body), Contract: config.Opts.WebhookOutboxContract()}, nil
+}
+
+// StartSaveEntry preserves the exact unsupported save_entry webhook as held;
+// it NEVER sends that webhook. Only other providers run asynchronously. The
+// successful caller response means preservation, not receiver/scoring success.
+func StartSaveEntry(store *storage.Storage, entry *model.Entry, settings *model.Integration) error {
+	if !config.Opts.HasHandoff() {
+		go SendEntry(entry, settings)
+		return nil
+	}
+	lease, err := store.BeginHandoff("manual_save")
+	if err != nil {
+		return err
+	}
+	if settings == nil {
+		return errors.Join(errors.New("missing integration settings"), lease.Finish())
+	}
+	copySettings := *settings
+	if settings.WebhookEnabled {
+		original, err := prepareLegacySave(entry, settings)
+		if err == nil {
+			err = store.PreserveLegacyWebhook(original, entry.UserID, entry.FeedID, entry.ID)
+		}
+		if err != nil {
+			return errors.Join(err, lease.Finish())
+		}
+		copySettings.WebhookEnabled = false
+	}
+	go func() {
+		// Panic/crash leaves the durable lease unresolved, never a false paused
+		// marker. A provider error is already logged by its existing integration.
+		completed := false
+		defer func() {
+			if recover() != nil {
+				if err := lease.Abort(); err != nil {
+					slog.Error("Legacy integration abort unconfirmed")
+				}
+				slog.Error("Legacy integration panicked; handoff remains uncertain")
+				return
+			}
+			if completed {
+				if err := lease.Finish(); err != nil {
+					slog.Error("Legacy integration lease completion unconfirmed")
+				}
+			}
+		}()
+		sendEntry(entry, &copySettings)
+		completed = true
+	}()
+	return nil
+}
+
+// The enforced refresh caller retains its parent lease through this synchronous
+// work and subsequent feed updates. Disabled mode keeps the old async behavior.
+func StartPushEntries(feed *model.Feed, entries model.Entries, settings *model.Integration, finish func() error) error {
+	if !config.Opts.HasHandoff() {
+		go PushEntries(feed, entries, settings)
+		return nil
+	}
+	if settings == nil || settings.WebhookEnabled || !config.Opts.HasWebhookOutbox() {
+		return errors.New("unpreserved legacy refresh webhook refused")
+	}
+	pushEntries(feed, entries, settings)
+	if finish != nil {
+		return finish()
+	}
+	return nil
+}
