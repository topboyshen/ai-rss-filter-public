+		}
+		if validate(strings.Repeat("a", 64), value) == nil {
+			t.Fatalf("accepted invalid operation %q", value)
+		}
+	}
+	if err := validate(strings.Repeat("a", 64), strings.Repeat("b", 64)); err != nil {
+		t.Fatal(err)
+	}
