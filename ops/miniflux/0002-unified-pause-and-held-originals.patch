+func TestPGConcurrentPauseAndAdmitNoPostCloseEscape(t *testing.T) {
+	f := startGate(t)
+	ctx := context.Background()
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var accepted []*Lease
+	var errs []error
+	ready := make(chan struct{})
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-ready
+			l, e := Begin(ctx, f.pool, testManifest, "concurrent")
+			mu.Lock()
+			defer mu.Unlock()
+			if e == nil {
+				accepted = append(accepted, l)
+			} else if !errors.Is(e, ErrClosed) {
+				errs = append(errs, e)
+			}
+		}()
+	}
+	close(ready)
+	_, e := Pause(ctx, f.db, testManifest, pauseOp)
+	if e != nil {
+		t.Fatal(e)
+	}
+	wg.Wait()
+	if len(errs) > 0 {
+		t.Fatal(errs)
+	}
+	for _, l := range accepted {
+		if e = l.Finish(); e != nil {
+			t.Fatal(e)
+		}
+	}
+	r, e := Query(ctx, f.db, testManifest, pauseOp)
+	if e != nil || !r.Confirmed {
+		t.Fatal(r, e)
+	}
+	for range 3 {
+		if _, e = Begin(ctx, f.pool, testManifest, "after.close"); !errors.Is(e, ErrClosed) {
+			t.Fatal(e)
+		}
+	}
+}
+
+func TestPGConcurrentFinishDoesNotLeakOrChangeOutcome(t *testing.T) {
+	f := startGate(t)
+	ctx := context.Background()
+	l, e := Begin(ctx, f.pool, testManifest, "concurrent.finish")
+	if e != nil {
+		t.Fatal(e)
+	}
+	var wg sync.WaitGroup
+	errch := make(chan error, 8)
+	for range 8 {
+		wg.Add(1)
+		go func() { defer wg.Done(); errch <- l.Finish() }()
+	}
+	wg.Wait()
+	close(errch)
+	for e = range errch {
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+	if e = l.Abort(); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	r, e := Pause(ctx, f.db, testManifest, pauseOp)
+	if e != nil || !r.Confirmed {
+		t.Fatal("session leaked", r, e)
+	}
+}
+
+func TestPGLeaseCapacityRefusesNewWorkButFinishAndPauseStillWork(t *testing.T) {
+	f := startGate(t)
+	ctx := context.Background()
+	l, e := Begin(ctx, f.pool, testManifest, "last.admission")
+	if e != nil {
+		t.Fatal(e)
+	}
+	_, e = f.db.Exec(`INSERT INTO handoff_leases(lease_id,manifest,source,status,backend_pid,finished_at) SELECT lpad(to_hex(i),32,'0'),$1,'capacity.fixture','finished',1,clock_timestamp() FROM generate_series(1,$2) i`, testManifest, MaxRetainedRecords-1)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = Begin(ctx, f.pool, testManifest, "full"); e == nil || !strings.Contains(e.Error(), "capacity") {
+		t.Fatal("capacity bypass", e)
+	}
+	if e = l.Finish(); e != nil {
+		t.Fatal(e)
+	}
+	r, e := Pause(ctx, f.db, testManifest, pauseOp)
+	if e != nil || !r.Confirmed {
+		t.Fatal(r, e)
+	}
+	var count int
+	if e = f.db.QueryRow(`SELECT count(*) FROM handoff_leases`).Scan(&count); e != nil || count != MaxRetainedRecords {
+		t.Fatal(count, e)
+	}
+}
+
+func TestPGOperationEvidenceCannotBeRewrittenOrDeleted(t *testing.T) {
+	f := startGate(t)
+	ctx := context.Background()
+	r, e := Pause(ctx, f.db, testManifest, pauseOp)
+	if e != nil || !r.Confirmed {
+		t.Fatal(r, e)
+	}
+	for _, q := range []string{`DELETE FROM handoff_operations`, `UPDATE handoff_operations SET manifest=repeat('e',64)`, `UPDATE handoff_operations SET status='pending'`} {
+		if _, e = f.db.Exec(q); e == nil {
+			t.Fatal("evidence mutation allowed", q)
+		}
+	}
+	if _, e = Pause(ctx, f.db, testManifest, initializeOp); e == nil {
+		t.Fatal("operation id reused with different action")
+	}
+}
+
+func TestPGDeferredPanicLeavesUncertainAndPreservesOriginal(t *testing.T) {
+	f := startGate(t)
+	lease, err := Begin(context.Background(), f.pool, testManifest, "panicking.actual.work")
+	if err != nil {
+		t.Fatal(err)
+	}
+	func() {
+		defer func() {
+			if recover() != "synthetic work panic" {
+				t.Error("original panic lost")
+			}
+		}()
+		defer FinishOnReturn(lease)
+		panic("synthetic work panic")
+	}()
+	r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || r.Confirmed || r.UncertainLeases != 1 || r.ActiveLeases != 0 {
+		t.Fatal(r, err)
+	}
+}
+
+func TestPGOperationCapacityCannotSilentlyContinueAdmitting(t *testing.T) {
+	f := startGate(t)
+	_, err := f.db.Exec(`INSERT INTO handoff_operations(operation_id,manifest,action,previous_generation,generation,prior_operation,status,confirmed_at) SELECT lpad(to_hex(i),64,'0'),$1,'initialize',-1,0,'','confirmed',clock_timestamp() FROM generate_series(1,$2) i`, testManifest, MaxRetainedRecords-2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !r.Confirmed {
+		t.Fatal(r, err)
+	}
+	if _, err = Resume(context.Background(), f.db, testManifest, pauseOp, resumeOp); err == nil || !strings.Contains(err.Error(), "capacity") {
+		t.Fatal("capacity reopened", err)
+	}
+	if _, err = Begin(context.Background(), f.pool, testManifest, "full.registry"); err == nil {
+		t.Fatal("capacity admitted")
+	}
+}
+
+func TestPGResumeReservesCapacityForTheNextPause(t *testing.T) {
+	f := startGate(t)
+	_, err := f.db.Exec(`INSERT INTO handoff_operations(operation_id,manifest,action,previous_generation,generation,prior_operation,status,confirmed_at) SELECT lpad(to_hex(i),64,'0'),$1,'initialize',-1,0,'','confirmed',clock_timestamp() FROM generate_series(1,$2) i`, testManifest, MaxRetainedRecords-3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	paused, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !paused.Confirmed {
+		t.Fatal(paused, err)
+	}
+	if _, err = Resume(context.Background(), f.db, testManifest, pauseOp, resumeOp); err == nil || !strings.Contains(err.Error(), "capacity") {
+		t.Fatal("resumed without a future pause slot", err)
+	}
+	receipt, err := Query(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !receipt.Confirmed || receipt.State != "closed" {
+		t.Fatal("capacity rejection changed prior close proof", receipt, err)
+	}
+	var count int
+	if err = f.db.QueryRow(`SELECT count(*) FROM handoff_operations`).Scan(&count); err != nil || count != MaxRetainedRecords-1 {
+		t.Fatal("rejected resume changed retained evidence", count, err)
+	}
+}
