+func upgradeEvidence(t *testing.T, db *sql.DB, legacy bool) string {
+	t.Helper()
+	query := `SELECT jsonb_build_object('outbox',(SELECT jsonb_agg(to_jsonb(o) ORDER BY delivery_id) FROM webhook_outbox o))::text`
+	if legacy {
