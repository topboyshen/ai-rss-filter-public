+	basic := func(r *http.Request) { r.SetBasicAuth("synthetic", "only-isolated-password") }
+	ui := func(r *http.Request) { r.AddCookie(f.cookie) }
+	for _, prepare := range []func(*http.Request){api, basic} {
+		if w := f.serve("GET", "/v1/me", "", prepare); w.Code != 200 {
+			t.Fatal(w.Code, w.Body.String())
