+func TestPostgresHandoffAuthenticatedRequestScopeHoldsLeaseUntilHandlerReturns(t *testing.T) {
+	f := actualAuthFixture(t)
+	entered, finish := make(chan struct{}), make(chan struct{})
+	done := make(chan struct{})
+	wrapped := handoffAdmission(f.store, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Real credential verification is tested above; this handshake fixes the
+		// exact scheduling boundary after successful acquisition, before return.
+		if !requestctx.AcquireAuthenticatedHandoff(w, r) {
+			return
+		}
+		close(entered)
+		<-finish
+		w.WriteHeader(204)
+	}))
+	go func() {
+		defer close(done)
+		wrapped.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest("GET", "/synthetic-authenticated", nil))
+	}()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("handler did not acquire")
+	}
+	r, e := handoff.Pause(context.Background(), f.db, strings.Repeat("a", 64), strings.Repeat("d", 64))
+	if e != nil || r.Confirmed || r.ActiveLeases != 1 {
+		close(finish)
+		<-done
+		t.Fatal("request not counted in flight", r, e)
+	}
+	close(finish)
+	<-done
+	r, e = handoff.Query(context.Background(), f.db, strings.Repeat("a", 64), strings.Repeat("d", 64))
+	if e != nil || !r.Confirmed {
+		t.Fatal(r, e)
+	}
+}
