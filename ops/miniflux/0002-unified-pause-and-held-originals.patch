@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: Apache-2.0
+package config
+
+import (
+	"encoding/hex"
+	"errors"
+	"net"
+	"strconv"
+	"strings"
+)
+
+func (c *configOptions) HasHandoff() bool {
+	return c != nil && c.options["HANDOFF_ENABLED"].parsedBoolValue
+}
+func (c *configOptions) HandoffManifest() string {
+	return c.options["HANDOFF_MANIFEST"].parsedStringValue
+}
+func (c *configOptions) HandoffControlAddr() string {
+	return c.options["HANDOFF_CONTROL_ADDR"].parsedStringValue
+}
+func (c *configOptions) HandoffControlToken() string {
+	return c.options["HANDOFF_CONTROL_TOKEN"].parsedStringValue
+}
+
+func (c *configOptions) validateHandoff() error {
+	if !c.HasHandoff() {
+		return nil
+	}
+	if !c.HasWebhookOutbox() {
+		return errors.New("HANDOFF_ENABLED requires transactional WEBHOOK_OUTBOX; unpreserved legacy refresh is refused")
+	}
+	if strings.TrimSpace(c.WebhookOutboxContract()) == "" {
+		return errors.New("handoff requires a nonempty webhook outbox contract")
+	}
+	for _, value := range []string{c.HandoffManifest(), c.HandoffControlToken()} {
+		decoded, err := hex.DecodeString(value)
+		if err != nil || len(decoded) != 32 || value != strings.ToLower(value) {
+			return errors.New("handoff manifest and token require 64 hex characters")
+		}
+	}
+	host, port, err := net.SplitHostPort(c.HandoffControlAddr())
+	number, portErr := strconv.Atoi(port)
+	if err != nil || portErr != nil || number < 1 || number > 65535 || (host != "127.0.0.1" && host != "::1") {
+		return errors.New("handoff control must bind an explicit loopback port")
+	}
+	return nil
+}
