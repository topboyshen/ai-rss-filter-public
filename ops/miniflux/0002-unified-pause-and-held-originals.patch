+func realGate(t *testing.T) fixture {
+	t.Helper()
+	raw := os.Getenv("MINIFLUX_OUTBOX_TEST_DSN")
+	if raw == "" {
+		t.Skip("actual PostgreSQL not configured; no persistence claim")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "postgres" || (u.Hostname() != "127.0.0.1" && u.Hostname() != "localhost") || u.Path != "/synthetic_outbox" {
+		t.Fatal("refuse non-isolated PostgreSQL DSN")
+	}
+	admin, err := sql.Open("postgres", raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Close()
+	var random [12]byte
+	if _, err = rand.Read(random[:]); err != nil {
+		t.Fatal(err)
+	}
+	schema := "handoff_test_" + hex.EncodeToString(random[:])
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if _, err = admin.ExecContext(ctx, `CREATE SCHEMA `+schema); err != nil {
+		t.Fatal(err)
+	}
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(8)
+	pool, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool.SetMaxOpenConns(16)
+	t.Cleanup(func() { pool.Close(); db.Close() })
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = Migrate(tx); err != nil {
+		tx.Rollback()
+		t.Fatal(err)
+	}
+	if err = tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("retained isolated schema=%s", schema)
+	return fixture{db, pool, u.String()}
+}
