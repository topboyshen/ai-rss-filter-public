+	}
+	settings.WebhookEnabled = false
+	finished := false
+	if err := StartPushEntries(entry.Feed, model.Entries{entry}, settings, func() error { finished = true; return nil }); err != nil || !finished {
+		t.Fatal("safe nonwebhook synchronous completion failed", err)
+	}
+}
