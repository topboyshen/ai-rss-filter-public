+type lostUpgradeConnector struct {
+	original driver.Connector
+	commits  atomic.Int32
+	lose     int32
+}
+
+func (c *lostUpgradeConnector) Connect(ctx context.Context) (driver.Conn, error) {
+	conn, err := c.original.Connect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &lostUpgradeConn{Conn: conn, owner: c}, nil
+}
+func (c *lostUpgradeConnector) Driver() driver.Driver { return c.original.Driver() }
+
+type lostUpgradeConn struct {
+	driver.Conn
+	owner *lostUpgradeConnector
+}
+
+func (c *lostUpgradeConn) Begin() (driver.Tx, error) {
+	tx, err := c.Conn.Begin()
+	if err != nil {
+		return nil, err
+	}
+	return &lostUpgradeTx{Tx: tx, owner: c.owner}, nil
+}
+
+type lostUpgradeTx struct {
+	driver.Tx
+	owner *lostUpgradeConnector
+}
+
+func (t *lostUpgradeTx) Commit() error {
+	if err := t.Tx.Commit(); err != nil {
+		return err
+	}
+	if t.owner.commits.Add(1) == t.owner.lose {
+		return errors.New("synthetic ACK lost after actual PG commit")
+	}
+	return nil
+}
+
+func TestPGActualUpgradeLostCommitACKOnlyQueriesExactMarker(t *testing.T) {
+	for _, lose := range []int32{1, 2, 3} {
+		t.Run(fmt.Sprint(lose), func(t *testing.T) {
+			db, dsn := upgradeFixture(t, 132)
+			before := upgradeSeed(t, db, false)
+			connector, err := pq.NewConnector(dsn)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wrapped := &lostUpgradeConnector{original: connector, lose: lose}
+			lost := sql.OpenDB(wrapped)
+			t.Logf("phase=before_actual_Migrate simulate_ACK_loss_after_commit=%d", lose)
+			err = Migrate(lost)
+			lost.Close()
+			if err == nil || !strings.Contains(err.Error(), "ACK lost") {
+				t.Fatal(err)
+			}
+			want := 132 + int(lose)
+			upgradeVersion(t, db, want)
+			if upgradeEvidence(t, db, false) != before {
+				t.Fatal("unknown ACK damaged original")
+			}
+			if wrapped.commits.Load() != lose {
+				t.Fatal("automatic commit replay")
+			}
+			t.Logf("phase=recovery_read_only marker=%d committed_steps=%d no_replay_or_downgrade=true", want, lose)
+		})
+	}
+}
+
+func (c *lostUpgradeConn) ExecContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
+	if executor, ok := c.Conn.(driver.ExecerContext); ok {
+		return executor.ExecContext(ctx, query, args)
+	}
+	return nil, driver.ErrSkip
+}
+func (c *lostUpgradeConn) QueryContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Rows, error) {
+	if executor, ok := c.Conn.(driver.QueryerContext); ok {
+		return executor.QueryContext(ctx, query, args)
+	}
+	return nil, driver.ErrSkip
+}
