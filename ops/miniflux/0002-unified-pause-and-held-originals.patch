+func TestPostgresHandoffPauseWinningCredentialReadRacePreventsAuthWrites(t *testing.T) {
+	f := actualAuthFixture(t)
+	blocker, e := f.db.Begin()
+	if e != nil {
+		t.Fatal(e)
