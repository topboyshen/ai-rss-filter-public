+// SPDX-License-Identifier: Apache-2.0
+package database
+
+import "database/sql"
+
+// legacyHandoffMigration is part of reviewed migration 133, not an independent
+// automatic migration. These originals are held evidence, never delivery jobs.
+func legacyHandoffMigration(tx *sql.Tx) error {
+	_, err := tx.Exec(`CREATE TABLE webhook_legacy_originals (
+ delivery_id text PRIMARY KEY CHECK(delivery_id ~ '^[a-f0-9]{64}$'),
+ body_sha256 text NOT NULL CHECK(body_sha256=delivery_id),
+ event_type text NOT NULL CHECK(event_type='save_entry'),
+ user_id bigint NOT NULL CHECK(user_id>0), feed_id bigint NOT NULL CHECK(feed_id>0), entry_id bigint NOT NULL CHECK(entry_id>0),
+ target_url text NOT NULL, signature text NOT NULL CHECK(signature ~ '^[a-f0-9]{64}$'),
+ contract text NOT NULL CHECK(contract<>''), body bytea NOT NULL,
+ state text NOT NULL DEFAULT 'held' CHECK(state='held'),
+ reason text NOT NULL DEFAULT 'unsupported_save_entry_requires_manual_review',
+ created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ CHECK(octet_length(body) BETWEEN 1 AND 1048576), CHECK(encode(sha256(body),'hex')=body_sha256)
+ );
+ CREATE FUNCTION protect_legacy_handoff_original() RETURNS trigger LANGUAGE plpgsql AS $$
+ BEGIN RAISE EXCEPTION 'legacy original is immutable retained evidence'; END $$;
+ CREATE TRIGGER legacy_handoff_original_guard BEFORE UPDATE OR DELETE ON webhook_legacy_originals
+ FOR EACH ROW EXECUTE FUNCTION protect_legacy_handoff_original();`)
+	return err
+}
