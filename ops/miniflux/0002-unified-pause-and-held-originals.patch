+// SPDX-License-Identifier: Apache-2.0
+package handoff
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func closedGateWithShared(t *testing.T) (fixture, func(time.Duration)) {
+	t.Helper()
+	f := activationGate(t)
+	ctx := context.Background()
+	if _, err := InitializeClosed(ctx, f.db, testManifest, initializeOp); err != nil {
+		t.Fatal(err)
+	}
+	hold := func(d time.Duration) {
+		conn, err := f.pool.Conn(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = conn.ExecContext(ctx, `SELECT pg_advisory_lock_shared($1, 'handoff_state'::regclass::oid::integer)`, activityNamespace); err != nil {
+			t.Fatal(err)
+		}
+		go func() { time.Sleep(d); discard(conn) }()
+	}
+	return f, hold
+}
+
+func TestPGConfirmWaitsForBriefSharedActivity(t *testing.T) {
+	f, hold := closedGateWithShared(t)
+	hold(150 * time.Millisecond)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	r, err := Query(ctx, f.db, testManifest, initializeOp)
+	if err != nil || !r.Durable || !r.Confirmed || r.State != "closed" {
+		t.Fatal(r, err)
+	}
+}
+
+func TestPGConfirmFailsClosedBeyondActivityBound(t *testing.T) {
+	f, hold := closedGateWithShared(t)
+	hold(confirmActivityWait + 700*time.Millisecond)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	started := time.Now()
+	r, err := Query(ctx, f.db, testManifest, initializeOp)
+	if !errors.Is(err, ErrUncertain) || r != (Receipt{}) {
+		t.Fatal("must fail closed with empty receipt", r, err)
+	}
+	if elapsed := time.Since(started); elapsed > confirmActivityWait+500*time.Millisecond {
+		t.Fatal("wait exceeded bound", elapsed)
+	}
+}
+
+const stressMinConfirmations = 8
+
+func TestPGConfirmSurvivesClosedSchedulerBeginStress(t *testing.T) {
+	f, _ := closedGateWithShared(t)
+	ctx := context.Background()
+	var stop atomic.Bool
+	var wg sync.WaitGroup
+	var begins atomic.Int64
+	for range 4 {
+		wg.Go(func() {
+			for !stop.Load() {
+				if _, err := Begin(ctx, f.pool, testManifest, "scheduler"); !errors.Is(err, ErrClosed) {
+					t.Error("closed Begin must stay ErrClosed", err)
+					return
+				}
+				begins.Add(1)
+			}
+		})
+	}
+	fail, total := 0, 0
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		total++
+		qctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+		if _, err := Query(qctx, f.db, testManifest, initializeOp); err != nil {
+			fail++
+		}
+		cancel()
+	}
+	stop.Store(true)
+	wg.Wait()
+	t.Logf("closed Begin stress: %d/%d Query failed, %d closed Begin attempts", fail, total, begins.Load())
+	// Without the bounded wait every confirmation fails (922/922 locally). Slow
+	// hosted runners can still starve a rare retry window (1/16 seen in CI), so
+	// require enough attempts and at least 80% success instead of zero failures.
+	if total < stressMinConfirmations || fail*5 > total {
+		t.Fatalf("%d/%d confirmations failed under closed Begin stress (need >=%d attempts, >=80%% success)", fail, total, stressMinConfirmations)
+	}
+}
diff --git a/internal/handoff/drain.go b/internal/handoff/drain.go
new file mode 100644
index 0000000..b920da3
--- /dev/null
+++ b/internal/handoff/drain.go
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0
+package handoff
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+)
+
+// Migration 134 upgrades the existing 133 gate without rewriting its evidence.
+// Migration 133 remains byte-for-byte compatible with the previous release.
+const DrainSchemaSQL = `
+ALTER TABLE handoff_state DROP CONSTRAINT handoff_state_phase_check;
+ALTER TABLE handoff_state ADD CONSTRAINT handoff_state_phase_check CHECK(phase IN ('open','draining','closing','closed'));
+ALTER TABLE handoff_operations DROP CONSTRAINT handoff_operations_action_check;
+ALTER TABLE handoff_operations ADD CONSTRAINT handoff_operations_action_check CHECK(action IN ('initialize','stop_new','pause','resume'));
+`
+
+func MigrateDrain(tx *sql.Tx) error { _, err := tx.Exec(DrainSchemaSQL); return err }
+
+// StopNew durably closes producer admission, leaving durable outbox consumers
+// enabled. Confirmation waits for prior producers, NOT queue emptiness or ACKs.
+// After inventory is drained, Pause freezes consumers before any cutover.
+func StopNew(ctx context.Context, db *sql.DB, manifest, op string) (Receipt, error) {
+	var empty Receipt
+	if db == nil {
+		return empty, ErrConflict
+	}
+	if err := validate(manifest, op); err != nil {
+		return empty, err
+	}
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer discard(conn)
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if errors.Is(err, sql.ErrNoRows) {
+		return empty, ErrClosed
+	}
+	if err != nil {
+		return empty, err
+	}
+	if s.manifest != manifest {
+		return empty, ErrConflict
+	}
+	if s.operation == op {
+		r, e := readReceipt(ctx, tx, manifest, op)
+		if e != nil || r.Action != "stop_new" {
+			return empty, ErrConflict
+		}
+		if e = tx.Commit(); e != nil {
+			return empty, e
+		}
+		return confirmStopNew(ctx, conn, manifest, op)
+	}
+	if s.phase != "open" {
+		return empty, ErrClosed
+	}
+	if err = insertOperation(ctx, tx, manifest, op, "stop_new", s.operation, s.generation, false); err != nil {
+		return empty, err
+	}
+	_, err = tx.ExecContext(ctx, `UPDATE handoff_state SET phase='draining',generation=generation+1,current_operation=$1 WHERE id=1`, op)
+	if err != nil {
+		return empty, err
+	}
+	if err = tx.Commit(); err != nil {
+		return empty, err
+	}
+	return confirmStopNew(ctx, conn, manifest, op)
+}
+
+func confirmStopNew(ctx context.Context, conn *sql.Conn, manifest, op string) (Receipt, error) {
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return Receipt{}, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if err != nil {
+		return Receipt{}, err
+	}
+	if s.manifest != manifest || s.operation != op || s.phase != "draining" {
+		return Receipt{}, ErrConflict
+	}
+	r, err := readReceipt(ctx, tx, manifest, op)
+	if err != nil {
+		return r, err
+	}
+	if r.Action != "stop_new" || r.Generation != s.generation || r.ActiveProducerLeases == nil || r.UncertainProducerLeases == nil {
+		return r, ErrConflict
+	}
+	settled := *r.ActiveProducerLeases == 0 && *r.UncertainProducerLeases == 0
+	if settled && !r.Confirmed {
+		_, err = tx.ExecContext(ctx, `UPDATE handoff_operations SET status='confirmed',confirmed_at=clock_timestamp() WHERE operation_id=$1 AND status='pending'`, op)
+		if err != nil {
+			return r, err
+		}
+		r.Confirmed = true
+	}
+	if r.Confirmed && !settled {
+		return r, ErrConflict
+	}
+	if err = tx.Commit(); err != nil {
+		return Receipt{}, err
+	}
+	r.Durable = true
+	return r, nil
+}
diff --git a/internal/handoff/drain_integration_test.go b/internal/handoff/drain_integration_test.go
new file mode 100644
index 0000000..1d786c0
--- /dev/null
+++ b/internal/handoff/drain_integration_test.go
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: Apache-2.0
+package handoff
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"strings"
+	"testing"
+)
+
+const stopNewOp = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
+
+func upgradeDrain(t *testing.T, f fixture) {
+	t.Helper()
+	tx, err := f.db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	if err = MigrateDrain(tx); err != nil {
+		t.Fatal(err)
+	}
+	if err = tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPGStopNewPreservesOldEvidenceAndLetsOnlyOutboxDrain(t *testing.T) {
+	f := startGate(t) // Original migration 133 and evidence exist before upgrade.
+	ctx := context.Background()
+	producer, err := Begin(ctx, f.pool, testManifest, "manual_save")
+	if err != nil {
+		t.Fatal(err)
+	}
+	upgradeDrain(t, f)
+	consumer, err := BeginOutbox(ctx, f.pool, testManifest, "outbox_sender")
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := StopNew(ctx, f.db, testManifest, stopNewOp)
+	if err != nil || !r.Durable || r.Confirmed || r.State != "draining" || r.Generation != 1 || r.ActiveProducerLeases == nil || *r.ActiveProducerLeases != 1 || r.ActiveLeases != 2 {
+		t.Fatalf("pending %#v %v", r, err)
+	}
+	for _, source := range []string{"scheduler", "queued_refresh", "http", "manual_save", "legacy_async"} {
+		if _, err = Begin(ctx, f.pool, testManifest, source); !errors.Is(err, ErrClosed) {
+			t.Fatalf("producer %s admitted: %v", source, err)
+		}
+	}
+	if _, err = Begin(ctx, f.pool, testManifest, "outbox_sender"); !errors.Is(err, ErrConflict) {
+		t.Fatal("source label granted consumer privilege", err)
+	}
+	if _, err = BeginOutbox(ctx, f.pool, testManifest, "manual_save"); !errors.Is(err, ErrConflict) {
+		t.Fatal("arbitrary consumer source", err)
+	}
+	if err = producer.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	r, err = Query(ctx, f.db, testManifest, stopNewOp)
+	if err != nil || !r.Confirmed || *r.ActiveProducerLeases != 0 || *r.UncertainProducerLeases != 0 || r.ActiveLeases != 1 {
+		t.Fatalf("producer confirmation %#v %v", r, err)
+	}
+	// New process/pool must observe durable draining rather than auto-opening.
+	restarted, err := sql.Open("postgres", f.dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restarted.Close()
+	if _, err = Begin(ctx, restarted, testManifest, "scheduler"); !errors.Is(err, ErrClosed) {
+		t.Fatal(err)
+	}
+	second, err := BeginOutbox(ctx, restarted, testManifest, "outbox_pass")
+	if err != nil {
+		t.Fatal("restart could not drain", err)
+	}
+	if _, err = Resume(ctx, f.db, testManifest, stopNewOp, resumeOp); err == nil {
+		t.Fatal("draining resumed without full pause")
+	}
+	r, err = Pause(ctx, f.db, testManifest, pauseOp)
+	if err != nil || r.Confirmed || r.State != "closing" || r.ActiveLeases != 2 {
+		t.Fatalf("freeze %#v %v", r, err)
+	}
+	if _, err = BeginOutbox(ctx, restarted, testManifest, "outbox_sender"); !errors.Is(err, ErrClosed) {
+		t.Fatal("consumer admitted during freeze", err)
+	}
+	if _, err = Query(ctx, f.db, testManifest, stopNewOp); !errors.Is(err, ErrConflict) {
+		t.Fatal("stale stop receipt certified current state", err)
+	}
+	if err = consumer.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	if err = second.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	r, err = Query(ctx, f.db, testManifest, pauseOp)
+	if err != nil || !r.Confirmed || r.State != "closed" || r.ActiveLeases != 0 {
+		t.Fatalf("closed %#v %v", r, err)
+	}
+	if _, err = BeginOutbox(ctx, restarted, testManifest, "outbox_sender"); !errors.Is(err, ErrClosed) {
+		t.Fatal(err)
+	}
+	var original int
+	if err = f.db.QueryRow(`SELECT count(*) FROM handoff_operations WHERE operation_id=$1 AND action='initialize' AND generation=0`, initializeOp).Scan(&original); err != nil || original != 1 {
+		t.Fatal("upgrade lost original operation", err)
+	}
+}
+
+func TestPGStopNewCannotConfirmUncertainProducer(t *testing.T) {
+	f := startGate(t)
+	upgradeDrain(t, f)
+	ctx := context.Background()
+	producer, err := Begin(ctx, f.pool, testManifest, "manual_save")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = producer.Abort(); err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		r, err := StopNew(ctx, f.db, testManifest, stopNewOp)
+		if err != nil || r.Confirmed || !r.Durable || r.UncertainProducerLeases == nil || *r.UncertainProducerLeases != 1 {
+			t.Fatalf("uncertain %#v %v", r, err)
+		}
+	}
+	consumer, err := BeginOutbox(ctx, f.pool, testManifest, "outbox_sender")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = consumer.Finish(); err != nil {
+		t.Fatal(err)
+	}
+	r, err := Pause(ctx, f.db, testManifest, pauseOp)
+	if err != nil || r.Confirmed || r.UncertainLeases != 1 {
+		t.Fatal(r, err)
+	}
+}
+
+func TestPGStopNewReservesFinalPauseCapacity(t *testing.T) {
+	f := startGate(t)
+	upgradeDrain(t, f)
+	_, err := f.db.Exec(`INSERT INTO handoff_operations(operation_id,manifest,action,previous_generation,generation,prior_operation,status,confirmed_at)
+ SELECT lpad(to_hex(n),64,'0'),$1,'initialize',-1,0,'','confirmed',now() FROM generate_series(1,$2) n`, testManifest, MaxRetainedRecords-2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = StopNew(context.Background(), f.db, testManifest, stopNewOp); err == nil {
+		t.Fatal("stop-new consumed final pause slot")
+	}
+	var phase string
+	if err = f.db.QueryRow(`SELECT phase FROM handoff_state`).Scan(&phase); err != nil || phase != "open" {
+		t.Fatal(phase, err)
+	}
+	r, err := Pause(context.Background(), f.db, testManifest, pauseOp)
+	if err != nil || !r.Confirmed {
+		t.Fatal(r, err)
+	}
+}
+
+func TestDrainEntryPointsRejectFabricatedIdentityWithoutDatabase(t *testing.T) {
+	ctx := context.Background()
+	if _, err := StopNew(ctx, nil, testManifest, stopNewOp); err == nil {
+		t.Fatal("nil DB")
+	}
+	if _, err := BeginOutbox(ctx, nil, testManifest, "outbox_sender"); err == nil {
+		t.Fatal("nil DB")
+	}
+	if _, err := Begin(ctx, nil, testManifest, "outbox_sender"); !errors.Is(err, ErrConflict) {
+		t.Fatal(err)
+	}
+	if _, err := BeginOutbox(ctx, nil, testManifest, "scheduler"); !errors.Is(err, ErrConflict) {
+		t.Fatal(err)
+	}
+	if strings.Contains(DrainSchemaSQL, "DELETE") || strings.Contains(DrainSchemaSQL, "UPDATE") || strings.Contains(DrainSchemaSQL, "INSERT") {
+		t.Fatal("upgrade modifies old evidence")
+	}
+}
diff --git a/internal/handoff/handoff.go b/internal/handoff/handoff.go
new file mode 100644
index 0000000..bda12c4
--- /dev/null
+++ b/internal/handoff/handoff.go
@@ -0,0 +1,817 @@
+// SPDX-License-Identifier: Apache-2.0
+// Package handoff implements a durable admission gate, not a delivery ACK.
+// A retained active/uncertain lease blocks closing even after its backend dies.
+package handoff
+
+import (
+	"context"
+	"crypto/rand"
+	"database/sql"
+	"database/sql/driver"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"log/slog"
+	"regexp"
+	"sync"
+	"time"
+)
+
+var (
+	ErrClosed    = errors.New("handoff admission is closed or uninitialized")
+	ErrConflict  = errors.New("handoff identity or operation conflict")
+	ErrUncertain = errors.New("handoff work completion is uncertain")
+	identifier   = regexp.MustCompile(`^[a-f0-9]{64}$`)
+	sourceName   = regexp.MustCompile(`^[a-zA-Z0-9_.:-]{1,96}$`)
+)
+
+const metadataNamespace = 20261023
+const activityNamespace = 20261024
+
+// Records are retained rather than silently garbage collected. At this bound
+// admission/control refuse further records; an operator must review retention.
+const MaxRetainedRecords = 10000
+
+// SchemaSQL is installed only by migration 133. There is deliberately no OPEN
+// seed row: enabling the feature requires an explicit Initialize operation.
+const SchemaSQL = `
+CREATE TABLE handoff_state (
+ id integer PRIMARY KEY CHECK(id=1),
+ manifest text NOT NULL CHECK(manifest ~ '^[a-f0-9]{64}$'),
+ generation bigint NOT NULL CHECK(generation>=0),
+ phase text NOT NULL CHECK(phase IN ('open','closing','closed')),
+ current_operation text NOT NULL CHECK(current_operation ~ '^[a-f0-9]{64}$')
+);
+CREATE TABLE handoff_operations (
+ operation_id text PRIMARY KEY CHECK(operation_id ~ '^[a-f0-9]{64}$'),
+ manifest text NOT NULL CHECK(manifest ~ '^[a-f0-9]{64}$'),
+ action text NOT NULL CHECK(action IN ('initialize','pause','resume')),
+ previous_generation bigint NOT NULL CHECK(previous_generation>=-1),
+ generation bigint NOT NULL CHECK(generation=previous_generation+1),
+ prior_operation text NOT NULL,
+ status text NOT NULL CHECK(status IN ('pending','confirmed')),
+ created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ confirmed_at timestamptz
+);
+CREATE TABLE handoff_leases (
+ lease_id text PRIMARY KEY CHECK(lease_id ~ '^[a-f0-9]{32}$'),
+ manifest text NOT NULL CHECK(manifest ~ '^[a-f0-9]{64}$'),
+ source text NOT NULL CHECK(length(source) BETWEEN 1 AND 96),
+ status text NOT NULL CHECK(status IN ('active','finished','uncertain')),
+ backend_pid integer NOT NULL,
+ created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ finished_at timestamptz
+);
+CREATE INDEX handoff_unfinished_leases ON handoff_leases(status) WHERE status <> 'finished';
+CREATE FUNCTION handoff_preserve_evidence() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'handoff evidence cannot be deleted'; END IF;
+ IF TG_TABLE_NAME='handoff_operations' THEN
+  IF NEW.operation_id<>OLD.operation_id OR NEW.manifest<>OLD.manifest OR NEW.action<>OLD.action
+   OR NEW.previous_generation<>OLD.previous_generation OR NEW.generation<>OLD.generation
+   OR NEW.prior_operation<>OLD.prior_operation OR NEW.created_at<>OLD.created_at
+   OR OLD.status<>'pending' OR NEW.status<>'confirmed' OR NEW.confirmed_at IS NULL
+  THEN RAISE EXCEPTION 'handoff operation identity is immutable'; END IF;
+ ELSE
+  IF NEW.lease_id<>OLD.lease_id OR NEW.manifest<>OLD.manifest OR NEW.source<>OLD.source
+   OR NEW.backend_pid<>OLD.backend_pid OR NEW.created_at<>OLD.created_at
+   OR OLD.status<>'active' OR NEW.status NOT IN ('finished','uncertain') OR NEW.finished_at IS NULL
+  THEN RAISE EXCEPTION 'handoff lease identity is immutable'; END IF;
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER handoff_operations_guard BEFORE UPDATE OR DELETE ON handoff_operations
+ FOR EACH ROW EXECUTE FUNCTION handoff_preserve_evidence();
+CREATE TRIGGER handoff_leases_guard BEFORE UPDATE OR DELETE ON handoff_leases
+ FOR EACH ROW EXECUTE FUNCTION handoff_preserve_evidence();
+`
+
+func Migrate(tx *sql.Tx) error { _, err := tx.Exec(SchemaSQL); return err }
+
+type Receipt struct {
+	Schema                  int    `json:"schema"`
+	Manifest                string `json:"manifest"`
+	OperationID             string `json:"operation_id"`
+	Action                  string `json:"action"`
+	State                   string `json:"state"`
+	PreviousGeneration      int64  `json:"previous_generation"`
+	Generation              int64  `json:"generation"`
+	Durable                 bool   `json:"durable"`
+	Confirmed               bool   `json:"confirmed"`
+	ActiveLeases            int64  `json:"active_leases"`
+	UncertainLeases         int64  `json:"uncertain_leases"`
+	ActiveProducerLeases    *int64 `json:"active_producer_leases,omitempty"`
+	UncertainProducerLeases *int64 `json:"uncertain_producer_leases,omitempty"`
+}
+
+type state struct {
+	manifest, phase, operation string
+	generation                 int64
+}
+
+func validate(manifest, operation string) error {
+	if !identifier.MatchString(manifest) || !identifier.MatchString(operation) {
+		return ErrConflict
+	}
+	return nil
+}
+
+func beginTx(ctx context.Context, conn *sql.Conn) (*sql.Tx, error) {
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = tx.ExecContext(ctx, `SET LOCAL synchronous_commit=on`); err != nil {
+		tx.Rollback()
+		return nil, err
+	}
+	var durable bool
+	err = tx.QueryRowContext(ctx, `SELECT current_setting('fsync')='on' AND current_setting('full_page_writes')='on'`).Scan(&durable)
+	if err != nil || !durable {
+		tx.Rollback()
+		if err == nil {
+			err = errors.New("handoff requires fsync and full_page_writes")
+		}
+		return nil, err
+	}
+	if _, err = tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock($1, 'handoff_state'::regclass::oid::integer)`, metadataNamespace); err != nil {
+		tx.Rollback()
+		return nil, err
+	}
+	return tx, nil
+}
+
+func readState(ctx context.Context, tx *sql.Tx) (state, error) {
+	var s state
+	err := tx.QueryRowContext(ctx, `SELECT manifest,generation,phase,current_operation FROM handoff_state WHERE id=1 FOR UPDATE`).Scan(&s.manifest, &s.generation, &s.phase, &s.operation)
+	return s, err
+}
+
+// discard never returns a session advisory lock to the pool, including after
+// uncertain network failures. A lost backend leaves its durable lease active.
+func discard(conn *sql.Conn) {
+	if conn != nil {
+		_ = conn.Raw(func(any) error { return driver.ErrBadConn })
+		_ = conn.Close()
+	}
+}
+
+func activity(ctx context.Context, conn *sql.Conn, shared bool) (bool, error) {
+	query := `SELECT pg_try_advisory_lock($1, 'handoff_state'::regclass::oid::integer)`
+	if shared {
+		query = `SELECT pg_try_advisory_lock_shared($1, 'handoff_state'::regclass::oid::integer)`
+	}
+	var got bool
+	err := conn.QueryRowContext(ctx, query, activityNamespace).Scan(&got)
+	return got, err
+}
+
+// confirmActivityWait bounds how long a confirmation retries the exclusive
+// activity try-lock. Closed-state Begin* attempts hold the shared key only for
+// milliseconds; retrying (instead of queueing a blocking waiter) never delays
+// or refuses their shared try-lock. Timeout still fails closed (ErrUncertain).
+const (
+	confirmActivityWait  = time.Second
+	confirmActivityRetry = 5 * time.Millisecond
+)
+
+func exclusiveActivityBounded(ctx context.Context, conn *sql.Conn) (bool, error) {
+	deadline := time.Now().Add(confirmActivityWait)
+	for {
+		got, err := activity(ctx, conn, false)
+		if err != nil || got || !time.Now().Add(confirmActivityRetry).Before(deadline) {
+			return got, err
+		}
+		timer := time.NewTimer(confirmActivityRetry)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return false, ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
+
+// Lease owns a dedicated physical session until Finish or Abort. The supplied
+// pool MUST be separate from the business SQL pool to avoid pool starvation.
+type Lease struct {
+	mu           sync.Mutex
+	db           *sql.DB
+	conn         *sql.Conn
+	manifest, id string
+	done         string
+}
+
+// Begin admits producers only. Reserved consumer names cannot grant drain access.
+func Begin(ctx context.Context, db *sql.DB, manifest, source string) (*Lease, error) {
+	if outboxSource(source) {
+		return nil, ErrConflict
+	}
+	return begin(ctx, db, manifest, source, false)
+}
+
+func outboxSource(source string) bool { return source == "outbox_pass" || source == "outbox_sender" }
+
+// BeginOutbox is exclusively for consuming already durable webhook rows.
+// It cannot authorize refresh, manual saves, or direct legacy webhook sends.
+func BeginOutbox(ctx context.Context, db *sql.DB, manifest, source string) (*Lease, error) {
+	if !outboxSource(source) {
+		return nil, ErrConflict
+	}
+	return begin(ctx, db, manifest, source, true)
+}
+
+// BeginOutboxPass atomically admits a cleanup pass and its first sender.
+// Both retained rows and physical session locks exist before either is returned;
+// concurrent producers/passes cannot consume a merely estimated reservation.
+func BeginOutboxPass(ctx context.Context, db *sql.DB, manifest string) (*Lease, *Lease, error) {
+	leases, err := beginBatch(ctx, db, manifest, []string{"outbox_pass", "outbox_sender"}, true)
+	if err != nil {
+		return nil, nil, err
+	}
+	return leases[0], leases[1], nil
+}
+
+func begin(ctx context.Context, db *sql.DB, manifest, source string, consumer bool) (*Lease, error) {
+	leases, err := beginBatch(ctx, db, manifest, []string{source}, consumer)
+	if err != nil {
+		return nil, err
+	}
+	return leases[0], nil
+}
+
+func beginBatch(ctx context.Context, db *sql.DB, manifest string, sources []string, consumer bool) ([]*Lease, error) {
+	if db == nil || !identifier.MatchString(manifest) || len(sources) < 1 || len(sources) > 2 {
+		return nil, ErrConflict
+	}
+	for _, source := range sources {
+		if !sourceName.MatchString(source) {
+			return nil, ErrConflict
+		}
+	}
+	connections := make([]*sql.Conn, 0, len(sources))
+	pids := make([]int, 0, len(sources))
+	keep := false
+	defer func() {
+		if !keep {
+			for _, conn := range connections {
+				discard(conn)
+			}
+		}
+	}()
+	for range sources {
+		conn, err := db.Conn(ctx)
+		if err != nil {
+			return nil, err
+		}
+		connections = append(connections, conn)
+		got, err := activity(ctx, conn, true)
+		if err != nil {
+			return nil, err
+		}
+		if !got {
+			return nil, ErrClosed
+		}
+		var pid int
+		if err = conn.QueryRowContext(ctx, `SELECT pg_backend_pid()`).Scan(&pid); err != nil {
+			return nil, err
+		}
+		pids = append(pids, pid)
+	}
+	tx, err := beginTx(ctx, connections[0])
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrClosed
+	}
+	if err != nil {
+		return nil, err
+	}
+	if s.manifest != manifest {
+		return nil, ErrConflict
+	}
+	if s.phase != "open" && !(consumer && s.phase == "draining") {
+		return nil, ErrClosed
+	}
+	var count int
+	if err = tx.QueryRowContext(ctx, `SELECT count(*) FROM handoff_leases`).Scan(&count); err != nil {
+		return nil, err
+	}
+	if count+len(sources) > MaxRetainedRecords {
+		return nil, errors.New("handoff retained lease capacity reached")
+	}
+	if err = tx.QueryRowContext(ctx, `SELECT count(*) FROM handoff_operations`).Scan(&count); err != nil {
+		return nil, err
+	}
+	if count >= MaxRetainedRecords {
+		return nil, errors.New("handoff retained operation capacity reached")
+	}
+	leases := make([]*Lease, 0, len(sources))
+	for i, source := range sources {
+		var random [16]byte
+		if _, err = rand.Read(random[:]); err != nil {
+			return nil, err
+		}
+		id := hex.EncodeToString(random[:])
+		_, err = tx.ExecContext(ctx, `INSERT INTO handoff_leases(lease_id,manifest,source,status,backend_pid) VALUES($1,$2,$3,'active',$4)`, id, manifest, source, pids[i])
+		if err != nil {
+			return nil, err
+		}
+		leases = append(leases, &Lease{db: db, conn: connections[i], manifest: manifest, id: id})
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	keep = true
+	return leases, nil
+}
+
+func (l *Lease) check(ctx context.Context) error {
+	if l == nil || l.conn == nil || l.done != "" {
+		return ErrUncertain
+	}
+	var valid bool
+	err := l.conn.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM handoff_leases WHERE lease_id=$1 AND manifest=$2 AND status='active' AND backend_pid=pg_backend_pid()) AND EXISTS(SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND locktype='advisory' AND classid=$3::oid AND objid='handoff_state'::regclass::oid AND objsubid=2 AND mode='ShareLock' AND granted)`, l.id, l.manifest, activityNamespace).Scan(&valid)
+	if err != nil {
+		return err
+	}
+	if !valid {
+		return ErrUncertain
+	}
+	return nil
+}
+
+func (l *Lease) Check(ctx context.Context) error {
+	if l == nil {
+		return ErrConflict
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	err := l.check(ctx)
+	if err != nil {
+		discard(l.conn)
+		l.conn = nil
+	}
+	return err
+}
+
+func (l *Lease) Matches(db *sql.DB, manifest string) error {
+	if l == nil {
+		return ErrConflict
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.db != db || l.manifest != manifest {
+		return ErrConflict
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	err := l.check(ctx)
+	if err != nil {
+		discard(l.conn)
+		l.conn = nil
+	}
+	return err
+}
+
+func (l *Lease) finish(outcome string) error {
+	if l == nil {
+		return ErrConflict
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.done != "" {
+		if l.done == outcome {
+			return nil
+		}
+		return ErrConflict
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if err := l.check(ctx); err != nil {
+		discard(l.conn)
+		l.conn = nil
+		return err
+	}
+	tx, err := beginTx(ctx, l.conn)
+	if err != nil {
+		discard(l.conn)
+		l.conn = nil
+		return err
+	}
+	defer tx.Rollback()
+	res, err := tx.ExecContext(ctx, `UPDATE handoff_leases SET status=$1,finished_at=clock_timestamp() WHERE lease_id=$2 AND manifest=$3 AND status='active' AND backend_pid=pg_backend_pid()`, outcome, l.id, l.manifest)
+	if err == nil {
+		var n int64
+		n, err = res.RowsAffected()
+		if err == nil && n != 1 {
+			err = ErrConflict
+		}
+	}
+	if err == nil {
+		err = tx.Commit()
+	}
+	discard(l.conn)
+	l.conn = nil
+	if err == nil {
+		l.done = outcome
+	}
+	return err
+}
+
+func (l *Lease) Finish() error { return l.finish("finished") }
+func (l *Lease) Abort() error  { return l.finish("uncertain") }
+
+// FinishOnReturn must itself be directly deferred by the work owner. A panic
+// never turns the original active work into a successful completion marker.
+// SQL failure retains active/uncertain evidence and blocks drain confirmation.
+func FinishOnReturn(lease *Lease) {
+	if recovered := recover(); recovered != nil {
+		if lease != nil {
+			if err := lease.Abort(); err != nil {
+				slog.Error("handoff panic completion remains unconfirmed", "error", err)
+			}
+		}
+		panic(recovered)
+	}
+	if lease != nil {
+		if err := lease.Finish(); err != nil {
+			slog.Error("handoff work completion remains unconfirmed", "error", err)
+		}
+	}
+}
+
+func insertOperation(ctx context.Context, tx *sql.Tx, manifest, op, action, prior string, prev int64, confirmed bool) error {
+	var count int
+	if err := tx.QueryRowContext(ctx, `SELECT count(*) FROM handoff_operations`).Scan(&count); err != nil {
+		return err
+	}
+	limit := MaxRetainedRecords
+	if action == "resume" || action == "stop_new" {
+		// Opening or draining must retain a slot for a full durable pause.
+		limit--
+	}
+	if count >= limit {
+		return errors.New("handoff retained operation capacity reached")
+	}
+	status := "pending"
+	if confirmed {
+		status = "confirmed"
+	}
+	_, err := tx.ExecContext(ctx, `INSERT INTO handoff_operations(operation_id,manifest,action,previous_generation,generation,prior_operation,status,confirmed_at) VALUES($1,$2,$3,$4::bigint,$4::bigint+1,$5,$6,CASE WHEN $6='confirmed' THEN clock_timestamp() ELSE NULL END)`, op, manifest, action, prev, prior, status)
+	return err
+}
+
+func readReceipt(ctx context.Context, tx *sql.Tx, manifest, op string) (Receipt, error) {
+	r := Receipt{Schema: 1, Manifest: manifest, OperationID: op}
+	var stored, status string
+	err := tx.QueryRowContext(ctx, `SELECT manifest,action,previous_generation,generation,status FROM handoff_operations WHERE operation_id=$1`, op).Scan(&stored, &r.Action, &r.PreviousGeneration, &r.Generation, &status)
+	if err != nil {
+		return r, err
+	}
+	if stored != manifest {
+		return r, ErrConflict
+	}
+	r.Confirmed = status == "confirmed"
+	r.State = "open"
+	if r.Action == "initialize_closed" {
+		r.State = "closed"
+	}
+	if r.Action == "pause" {
+		r.State = "closing"
+		if r.Confirmed {
+			r.State = "closed"
+		}
+	}
+	err = tx.QueryRowContext(ctx, `SELECT count(*) FILTER(WHERE status='active'),count(*) FILTER(WHERE status='uncertain') FROM handoff_leases WHERE status<>'finished'`).Scan(&r.ActiveLeases, &r.UncertainLeases)
+	if err == nil && r.Action == "stop_new" {
+		r.State = "draining"
+		var active, uncertain int64
+		err = tx.QueryRowContext(ctx, `SELECT count(*) FILTER(WHERE status='active'),count(*) FILTER(WHERE status='uncertain') FROM handoff_leases WHERE status<>'finished' AND source NOT IN ('outbox_pass','outbox_sender')`).Scan(&active, &uncertain)
+		r.ActiveProducerLeases, r.UncertainProducerLeases = &active, &uncertain
+	}
+	return r, err
+}
+
+// Initialize is explicit, empty-state-only, and idempotent only for its exact
+// operation. Application startup must never call it automatically.
+func Initialize(ctx context.Context, db *sql.DB, manifest, op string) (Receipt, error) {
+	var empty Receipt
+	if db == nil {
+		return empty, ErrConflict
+	}
+	if err := validate(manifest, op); err != nil {
+		return empty, err
+	}
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer discard(conn)
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if err == nil {
+		if s.manifest != manifest || s.operation != op {
+			return empty, ErrConflict
+		}
+		r, e := readReceipt(ctx, tx, manifest, op)
+		if e != nil || r.Action != "initialize" {
+			return empty, ErrConflict
+		}
+		if e = tx.Commit(); e != nil {
+			return empty, e
+		}
+		r.Durable = true
+		return r, nil
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		return empty, err
+	}
+	var rows int
+	err = tx.QueryRowContext(ctx, `SELECT (SELECT count(*) FROM handoff_operations)+(SELECT count(*) FROM handoff_leases)`).Scan(&rows)
+	if err != nil {
+		return empty, err
+	}
+	if rows != 0 {
+		return empty, ErrConflict
+	}
+	if err = insertOperation(ctx, tx, manifest, op, "initialize", "", -1, true); err != nil {
+		return empty, err
+	}
+	_, err = tx.ExecContext(ctx, `INSERT INTO handoff_state VALUES(1,$1,0,'open',$2)`, manifest, op)
+	if err != nil {
+		return empty, err
+	}
+	r, err := readReceipt(ctx, tx, manifest, op)
+	if err != nil {
+		return empty, err
+	}
+	if err = tx.Commit(); err != nil {
+		return empty, err
+	}
+	r.Durable = true
+	return r, nil
+}
+
+// Pause first durably closes admission. If work remains, the returned receipt
+// is durable but NOT confirmed. Query the SAME operation later; never reset it.
+func Pause(ctx context.Context, db *sql.DB, manifest, op string) (Receipt, error) {
+	var empty Receipt
+	if db == nil {
+		return empty, ErrConflict
+	}
+	if err := validate(manifest, op); err != nil {
+		return empty, err
+	}
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer discard(conn)
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if errors.Is(err, sql.ErrNoRows) {
+		return empty, ErrClosed
+	}
+	if err != nil {
+		return empty, err
+	}
+	if s.manifest != manifest {
+		return empty, ErrConflict
+	}
+	if s.operation == op {
+		r, e := readReceipt(ctx, tx, manifest, op)
+		if e != nil || r.Action != "pause" {
+			return empty, ErrConflict
+		}
+		if e = tx.Commit(); e != nil {
+			return empty, e
+		}
+		return confirmPause(ctx, conn, manifest, op)
+	}
+	if s.phase != "open" && s.phase != "draining" {
+		return empty, ErrClosed
+	}
+	if err = insertOperation(ctx, tx, manifest, op, "pause", s.operation, s.generation, false); err != nil {
+		return empty, err
+	}
+	_, err = tx.ExecContext(ctx, `UPDATE handoff_state SET phase='closing',generation=generation+1,current_operation=$1 WHERE id=1`, op)
+	if err != nil {
+		return empty, err
+	}
+	if err = tx.Commit(); err != nil {
+		return empty, err
+	}
+	return confirmPause(ctx, conn, manifest, op)
+}
+
+func confirmPause(ctx context.Context, conn *sql.Conn, manifest, op string) (Receipt, error) {
+	got, err := exclusiveActivityBounded(ctx, conn)
+	if err != nil {
+		return Receipt{}, err
+	}
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return Receipt{}, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if err != nil {
+		return Receipt{}, err
+	}
+	if s.manifest != manifest || s.operation != op || s.phase == "open" {
+		return Receipt{}, ErrConflict
+	}
+	r, err := readReceipt(ctx, tx, manifest, op)
+	if err != nil {
+		return r, err
+	}
+	if r.Action != "pause" || r.Generation != s.generation {
+		return r, ErrConflict
+	}
+	if got && r.ActiveLeases == 0 && r.UncertainLeases == 0 && !r.Confirmed {
+		_, err = tx.ExecContext(ctx, `UPDATE handoff_operations SET status='confirmed',confirmed_at=clock_timestamp() WHERE operation_id=$1 AND status='pending'`, op)
+		if err != nil {
+			return r, err
+		}
+		_, err = tx.ExecContext(ctx, `UPDATE handoff_state SET phase='closed' WHERE id=1`)
+		if err != nil {
+			return r, err
+		}
+		r.Confirmed = true
+		r.State = "closed"
+	}
+	if r.Confirmed && (!got || r.ActiveLeases != 0 || r.UncertainLeases != 0 || s.phase != "closed" && r.State != "closed") {
+		return r, ErrConflict
+	}
+	if err = tx.Commit(); err != nil {
+		return Receipt{}, err
+	}
+	r.Durable = true
+	return r, nil
+}
+
+// Query may finish a previously recorded closing operation; it is not a
+// read-only endpoint. Historical operations cannot certify the current state.
+func Query(ctx context.Context, db *sql.DB, manifest, op string) (Receipt, error) {
+	var empty Receipt
+	if db == nil {
+		return empty, ErrConflict
+	}
+	if err := validate(manifest, op); err != nil {
+		return empty, err
+	}
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer discard(conn)
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	s, err := readState(ctx, tx)
+	if err != nil {
+		return empty, err
+	}
+	if s.manifest != manifest || s.operation != op {
+		return empty, ErrConflict
+	}
+	r, err := readReceipt(ctx, tx, manifest, op)
+	if err != nil {
+		return empty, err
+	}
+	if r.Generation != s.generation {
+		return empty, ErrConflict
+	}
+	if r.Action == "initialize_closed" {
+		r, err = closedInitialReceipt(ctx, tx, s, manifest, op)
+		if err != nil {
+			return empty, err
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return empty, err
+	}
+	if r.Action == "pause" {
+		return confirmPause(ctx, conn, manifest, op)
+	}
+	if r.Action == "stop_new" {
+		return confirmStopNew(ctx, conn, manifest, op)
+	}
+	if r.Action == "initialize_closed" {
+		return confirmInitialClosed(ctx, conn, manifest, op)
+	}
+	r.Durable = true
+	return r, nil
+}
+
+// Resume is an explicit CAS from one confirmed closed operation. It cannot
+// erase uncertain work, change the manifest, or reopen automatically on restart.
+func Resume(ctx context.Context, db *sql.DB, manifest, closedOp, newOp string) (Receipt, error) {
+	return resume(ctx, db, manifest, closedOp, newOp, false)
+}
+
+func resume(ctx context.Context, db *sql.DB, manifest, closedOp, newOp string, production bool) (Receipt, error) {
+	var empty Receipt
+	if db == nil {
+		return empty, ErrConflict
+	}
+	if err := validate(manifest, newOp); err != nil {
+		return empty, err
+	}
+	if !identifier.MatchString(closedOp) || closedOp == newOp {
+		return empty, ErrConflict
+	}
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer discard(conn)
+	got, err := activity(ctx, conn, false)
+	if err != nil {
+		return empty, err
+	}
+	if !got {
+		return empty, ErrUncertain
+	}
+	tx, err := beginTx(ctx, conn)
+	if err != nil {
+		return empty, err
+	}
+	defer tx.Rollback()
+	if production {
+		if err = activationSchema(ctx, tx); err != nil {
+			return empty, err
+		}
+	}
+	s, err := readState(ctx, tx)
+	if err != nil {
+		return empty, err
+	}
+	if s.manifest != manifest {
+		return empty, ErrConflict
+	}
+	if s.operation == newOp {
+		r, e := readReceipt(ctx, tx, manifest, newOp)
+		var prior string
+		if e == nil {
+			e = tx.QueryRowContext(ctx, `SELECT prior_operation FROM handoff_operations WHERE operation_id=$1`, newOp).Scan(&prior)
+		}
+		if e != nil || r.Action != "resume" || prior != closedOp || s.phase != "open" || r.Generation != s.generation || !r.Confirmed {
+			return empty, ErrConflict
+		}
+		if e = tx.Commit(); e != nil {
+			return empty, e
+		}
+		r.Durable = true
+		return r, nil
+	}
+	if s.phase != "closed" || s.operation != closedOp {
+		return empty, ErrClosed
+	}
+	prior, err := readReceipt(ctx, tx, manifest, closedOp)
+	if err != nil {
+		return empty, err
+	}
+	validClosed := prior.Action == "pause"
+	if production && prior.Action == "initialize_closed" {
+		_, err = closedInitialReceipt(ctx, tx, s, manifest, closedOp)
+		validClosed = err == nil
+	}
+	if !prior.Confirmed || !validClosed || prior.Generation != s.generation || prior.ActiveLeases != 0 || prior.UncertainLeases != 0 {
+		return empty, ErrUncertain
+	}
+	if err = insertOperation(ctx, tx, manifest, newOp, "resume", closedOp, s.generation, true); err != nil {
+		return empty, err
+	}
+	_, err = tx.ExecContext(ctx, `UPDATE handoff_state SET phase='open',generation=generation+1,current_operation=$1 WHERE id=1`, newOp)
+	if err != nil {
+		return empty, err
+	}
+	r, err := readReceipt(ctx, tx, manifest, newOp)
+	if err != nil {
+		return empty, err
+	}
+	if err = tx.Commit(); err != nil {
+		return empty, err
+	}
+	r.Durable = true
+	return r, nil
+}
+
+func (r Receipt) String() string {
+	return fmt.Sprintf("handoff %s generation=%d confirmed=%t", r.State, r.Generation, r.Confirmed)
+}
