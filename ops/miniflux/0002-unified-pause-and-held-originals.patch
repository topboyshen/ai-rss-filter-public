+	"miniflux.app/v2/internal/model"
+)
+
+func legacyOriginal(id int64) *model.DurableWebhook {
+	body := []byte(fmt.Sprintf(`{"event_type":"save_entry","entry":{"id":%d,"user_id":1,"feed_id":1,"title":"synthetic original"}}`, id))
+	hash := sha256.Sum256(body)
+	key := hex.EncodeToString(hash[:])
+	return &model.DurableWebhook{DeliveryID: key, BodySHA256: key, Body: body, URL: "https://receiver.invalid/webhook", Signature: crypto.GenerateSHA256Hmac("synthetic", body), Contract: "synthetic-contract"}
+}
+
+func legacyCount(t *testing.T, store *Storage) int {
+	t.Helper()
+	var n int
+	if err := store.db.QueryRow(`SELECT count(*) FROM webhook_legacy_originals`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestLegacyOriginalInvalidIdentityRejectedBeforeDB(t *testing.T) {
+	store := NewStorage(nil)
+	for _, mutate := range []func(*model.DurableWebhook){
+		func(m *model.DurableWebhook) { m.Body = []byte("changed") }, func(m *model.DurableWebhook) { m.BodySHA256 = strings.Repeat("0", 64) },
+		func(m *model.DurableWebhook) { m.URL = "https://account@receiver.invalid/webhook" }, func(m *model.DurableWebhook) { m.URL = "file:///tmp/endpoint" },
+		func(m *model.DurableWebhook) { m.Signature = "not-an-hmac" }, func(m *model.DurableWebhook) { m.Contract = "" },
+		func(m *model.DurableWebhook) { m.Body = make([]byte, 1048577) },
+	} {
+		item := legacyOriginal(7)
+		mutate(item)
+		if store.PreserveLegacyWebhook(item, 1, 1, 7) == nil {
+			t.Fatal("invalid original admitted")
+		}
+	}
+	if store.PreserveLegacyWebhook(legacyOriginal(7), 1, 1, 8) == nil {
+		t.Fatal("payload and requested entry identity differ")
+	}
+	if store.PreserveLegacyWebhook(nil, 1, 1, 7) == nil {
+		t.Fatal("nil original admitted")
+	}
+}
+
+func TestPostgresLegacyOriginalExactImmutableDurableDuplicate(t *testing.T) {
+	store, _, _ := realOutboxStore(t)
+	item := legacyOriginal(7)
+	// A caller's async/default setting must not weaken the preservation commit.
+	if _, err := store.db.Exec(`SET synchronous_commit=off`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.db.Exec(`CREATE FUNCTION assert_legacy_sync() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF current_setting('synchronous_commit')<>'on' THEN RAISE EXCEPTION 'unsynchronized original'; END IF; RETURN NEW; END $$;
+ CREATE TRIGGER require_sync BEFORE INSERT ON webhook_legacy_originals FOR EACH ROW EXECUTE FUNCTION assert_legacy_sync();`); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.PreserveLegacyWebhook(item, 1, 1, 7); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.PreserveLegacyWebhook(item, 1, 1, 7); err != nil {
+		t.Fatal("exact duplicate must remain confirmable", err)
+	}
+	var body []byte
+	var signature, target, state, reason string
+	if err := store.db.QueryRow(`SELECT body,signature,target_url,state,reason FROM webhook_legacy_originals WHERE delivery_id=$1`, item.DeliveryID).Scan(&body, &signature, &target, &state, &reason); err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != string(item.Body) || signature != item.Signature || target != item.URL || state != "held" || reason != "unsupported_save_entry_requires_manual_review" || legacyCount(t, store) != 1 {
+		t.Fatal("original mutated or falsely sent")
+	}
+	conflict := *item
+	conflict.URL = "https://changed.invalid/webhook"
+	if store.PreserveLegacyWebhook(&conflict, 1, 1, 7) == nil {
+		t.Fatal("same raw identity with changed endpoint admitted")
+	}
+	for _, query := range []string{`UPDATE webhook_legacy_originals SET state='held'`, `UPDATE webhook_legacy_originals SET signature=repeat('b',64)`, `DELETE FROM webhook_legacy_originals`} {
+		if _, err := store.db.Exec(query); err == nil {
+			t.Fatal("held original changed", query)
+		}
+	}
+	if err := store.CleanupWebhookReceipts(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if claim, err := store.ClaimWebhook(context.Background()); err != nil || claim != nil {
+		t.Fatal("unsupported legacy payload became sendable", err)
+	}
+	if legacyCount(t, store) != 1 {
+		t.Fatal("cleanup deleted held original")
+	}
+}
+
+func TestPostgresLegacyOriginalSharedRowsAndExactDuplicateAtFullCapacity(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	item := legacyOriginal(7)
+	if err := store.PreserveLegacyWebhook(item, 1, 1, 7); err != nil {
+		t.Fatal(err)
+	}
