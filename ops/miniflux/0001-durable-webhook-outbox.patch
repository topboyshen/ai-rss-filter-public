+// SPDX-License-Identifier: Apache-2.0
+package config
+
+import "testing"
+
+func TestWebhookOutboxConfigurationCombinations(t *testing.T) {
+	if NewConfigOptions().HasWebhookOutbox() {
+		t.Fatal("outbox enabled by default")
+	}
+	for _, tc := range []struct {
+		enabled, contract      string
+		wantEnabled, wantError bool
+	}{
+		{"0", "", false, false}, {"1", "", true, true},
+		{"1", "audit-v1", true, false}, {"0", "audit-v1", false, false},
+	} {
+		t.Run(tc.enabled+"/"+tc.contract, func(t *testing.T) {
+			parser := NewConfigParser()
+			err := parser.parseLines([]string{"WEBHOOK_OUTBOX=" + tc.enabled, "WEBHOOK_OUTBOX_CONTRACT=" + tc.contract})
+			if err != nil {
+				t.Fatal(err)
+			}
+			opts := parser.options
+			if opts.HasWebhookOutbox() != tc.wantEnabled || opts.WebhookOutboxContract() != tc.contract || (opts.Validate() != nil) != tc.wantError {
+				t.Fatal("unexpected outbox option combination")
+			}
+		})
+	}
+}
