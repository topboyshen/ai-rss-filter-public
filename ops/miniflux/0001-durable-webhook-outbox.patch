--- /dev/null
+++ b/internal/storage/webhook_outbox_test.go
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier: Apache-2.0
+package storage
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"miniflux.app/v2/internal/model"
+)
+
+// This driver asserts real Storage control flow and transaction ownership; it
+// does not pretend to validate PostgreSQL SQL, lock scheduling or disk fsync.
+type outboxTestDriver struct{}
+type outboxTestState struct {
+	events      []string
+	fail        string
+	count, size int64
+	existing    bool
+	rows        int64
+}
+type outboxTestConn struct {
+	state *outboxTestState
+	tx    bool
+}
+type outboxTestTx struct{ conn *outboxTestConn }
+type outboxTestRows struct {
+	columns []string
+	values  [][]driver.Value
+	index   int
+}
+
+var outboxStates sync.Map
+
+func init() { sql.Register("outbox-flow-test", outboxTestDriver{}) }
+func (outboxTestDriver) Open(name string) (driver.Conn, error) {
+	v, _ := outboxStates.Load(name)
+	return &outboxTestConn{state: v.(*outboxTestState)}, nil
+}
+func (c *outboxTestConn) Prepare(string) (driver.Stmt, error) {
+	return nil, errors.New("unsupported prepare")
+}
+func (c *outboxTestConn) Close() error { return nil }
+func (c *outboxTestConn) Begin() (driver.Tx, error) {
+	c.tx = true
+	c.state.events = append(c.state.events, "begin")
+	return &outboxTestTx{c}, nil
+}
+func (t *outboxTestTx) Commit() error {
+	t.conn.state.events = append(t.conn.state.events, "commit")
+	t.conn.tx = false
+	if t.conn.state.fail == "commit" {
+		return errors.New("synthetic ambiguous commit")
+	}
+	return nil
+}
+func (t *outboxTestTx) Rollback() error {
+	t.conn.state.events = append(t.conn.state.events, "rollback")
+	t.conn.tx = false
+	return nil
+}
+func (r *outboxTestRows) Columns() []string { return r.columns }
+func (r *outboxTestRows) Close() error      { return nil }
+func (r *outboxTestRows) Next(dest []driver.Value) error {
+	if r.index == len(r.values) {
+		return io.EOF
+	}
+	copy(dest, r.values[r.index])
+	r.index++
+	return nil
+}
+func (c *outboxTestConn) ExecContext(_ context.Context, q string, _ []driver.NamedValue) (driver.Result, error) {
+	name := ""
+	switch {
+	case strings.Contains(q, "SET LOCAL synchronous_commit"):
+		name = "sync_commit"
+	case strings.Contains(q, "INSERT INTO webhook_outbox"):
+		name = "outbox_insert"
+	case strings.Contains(q, "UPDATE webhook_outbox SET state=$1"):
+		name = "finish"
+	case strings.Contains(q, "SET state='held'"):
+		name = "hold_exhausted"
+	default:
+		return nil, fmt.Errorf("unexpected exec: %s", q)
+	}
+	if name != "finish" && !c.tx {
+		return nil, errors.New("write escaped entry transaction")
+	}
+	c.state.events = append(c.state.events, name)
+	if c.state.fail == name {
+		return nil, errors.New("synthetic " + name)
+	}
+	return driver.RowsAffected(c.state.rows), nil
+}
+func (c *outboxTestConn) QueryContext(_ context.Context, q string, _ []driver.NamedValue) (driver.Rows, error) {
+	if !c.tx {
+		return nil, errors.New("query escaped transaction")
+	}
+	switch {
+	case strings.Contains(q, "SELECT true FROM entries"):
+		rows := [][]driver.Value{}
+		if c.state.existing {
+			rows = append(rows, []driver.Value{true})
+		}
+		return &outboxTestRows{columns: []string{"exists"}, values: rows}, nil
+	case strings.Contains(q, "INSERT INTO entries"):
+		c.state.events = append(c.state.events, "entry_insert")
+		return &outboxTestRows{columns: []string{"id", "status", "created_at", "changed_at"}, values: [][]driver.Value{{int64(11), "unread", time.Unix(100, 0), time.Unix(100, 0)}}}, nil
+	case strings.Contains(q, "current_setting('fsync')"):
+		return &outboxTestRows{columns: []string{"durable"}, values: [][]driver.Value{{c.state.fail != "durability"}}}, nil
+	case strings.Contains(q, "pg_try_advisory_xact_lock"):
+		c.state.events = append(c.state.events, "quota_lock")
+		return &outboxTestRows{columns: []string{"locked"}, values: [][]driver.Value{{c.state.fail != "quota_lock"}}}, nil
+	case strings.Contains(q, "SELECT count(*)"):
+		return &outboxTestRows{columns: []string{"count", "size"}, values: [][]driver.Value{{c.state.count, c.state.size}}}, nil
+	case strings.Contains(q, "RETURNING delivery_id,body_sha256"):
+		c.state.events = append(c.state.events, "claim")
+		return &outboxTestRows{columns: []string{"delivery_id", "body_sha256", "target_url", "signature", "contract", "body", "attempts"}}, nil
+	default:
+		return nil, fmt.Errorf("unexpected query: %s", q)
+	}
+}
+
+func flowStore(t *testing.T, state *outboxTestState) *Storage {
+	t.Helper()
+	name := t.Name()
+	outboxStates.Store(name, state)
+	state.rows = 1
+	db, err := sql.Open("outbox-flow-test", name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { db.Close(); outboxStates.Delete(name) })
+	return NewStorage(db)
+}
+func flowEntry() *model.Entry {
+	return &model.Entry{Title: "synthetic", Content: "synthetic", Hash: "hash", URL: "https://synthetic.invalid/"}
+}
+func flowPrepare(entry *model.Entry) (*model.DurableWebhook, error) {
+	if entry.ID != 11 || entry.CreatedAt.IsZero() {
+		return nil, errors.New("entry not materialized before serialization")
+	}
+	return &model.DurableWebhook{Body: []byte("synthetic"), URL: "https://receiver.invalid", Contract: "audit"}, nil
+}
+
+func TestWebhookOutboxSameTransactionBeforeCommit(t *testing.T) {
+	state := &outboxTestState{}
+	store := flowStore(t, state)
+	rows, err := store.RefreshFeedEntriesWithOutbox(1, 2, model.Entries{flowEntry()}, false, flowPrepare)
+	if err != nil || len(rows) != 1 {
+		t.Fatalf("rows %v error %v", rows, err)
+	}
+	want := "begin,entry_insert,sync_commit,quota_lock,outbox_insert,commit"
+	if strings.Join(state.events, ",") != want {
+		t.Fatal(state.events)
+	}
+}
+
+func TestWebhookOutboxFailuresRollbackNewEntry(t *testing.T) {
+	for _, failure := range []string{"prepare", "sync_commit", "durability", "quota_lock", "outbox_insert", "row_limit", "byte_limit", "commit"} {
+		t.Run(failure, func(t *testing.T) {
+			state := &outboxTestState{fail: failure}
+			if failure == "row_limit" {
+				state.count = WebhookOutboxMaxRows
+			}
+			if failure == "byte_limit" {
+				state.size = WebhookOutboxMaxBytes
+			}
+			store := flowStore(t, state)
+			prepare := flowPrepare
+			if failure == "prepare" {
+				prepare = func(*model.Entry) (*model.DurableWebhook, error) { return nil, errors.New("serialize failed") }
+			}
+			rows, err := store.RefreshFeedEntriesWithOutbox(1, 2, model.Entries{flowEntry()}, false, prepare)
+			if err == nil || rows != nil {
+				t.Fatalf("failed delivery reported as accepted: %v %v", rows, err)
+			}
+			events := strings.Join(state.events, ",")
+			if failure != "commit" && (!strings.HasSuffix(events, "rollback") || slices.Contains(state.events, "commit")) {
+				t.Fatal(events)
+			}
+		})
+	}
+}
+
+func TestWebhookOutboxExistingEntryDoesNotReconstructOrResend(t *testing.T) {
+	state := &outboxTestState{existing: true}
+	store := flowStore(t, state)
+	rows, err := store.RefreshFeedEntriesWithOutbox(1, 2, model.Entries{flowEntry()}, false, func(*model.Entry) (*model.DurableWebhook, error) {
+		t.Fatal("existing entry reserialized")
+		return nil, nil
+	})
+	if err != nil || len(rows) != 0 || strings.Join(state.events, ",") != "begin,commit" {
+		t.Fatalf("%v %v %v", rows, err, state.events)
+	}
+}
+
+func TestWebhookOutboxNoDueRowsCommitsHeldState(t *testing.T) {
+	state := &outboxTestState{}
+	store := flowStore(t, state)
+	claim, err := store.ClaimWebhook(context.Background())
+	if err != nil || claim != nil || strings.Join(state.events, ",") != "begin,sync_commit,hold_exhausted,claim,commit" {
+		t.Fatalf("%v %v %v", claim, err, state.events)
+	}
+}
+
+func TestWebhookOutboxDisabledKeepsOriginalEntryPath(t *testing.T) {
+	state := &outboxTestState{}
+	store := flowStore(t, state)
+	rows, err := store.RefreshFeedEntries(1, 2, model.Entries{flowEntry()}, false)
+	if err != nil || len(rows) != 1 || strings.Join(state.events, ",") != "begin,entry_insert,commit" {
+		t.Fatalf("disabled path changed: rows=%v err=%v events=%v", rows, err, state.events)
+	}
+}
+
+func TestWebhookOutboxClaimDurabilityFailureReturnsNoDelivery(t *testing.T) {
+	for _, fail := range []string{"sync_commit", "durability"} {
+		t.Run(fail, func(t *testing.T) {
+			state := &outboxTestState{fail: fail}
+			claim, err := flowStore(t, state).ClaimWebhook(context.Background())
+			if claim != nil || err == nil || slices.Contains(state.events, "claim") || slices.Contains(state.events, "commit") || !slices.Contains(state.events, "rollback") {
+				t.Fatalf("claim escaped durability failure: %v %v %v", claim, err, state.events)
+			}
+		})
+	}
+}
+
+func TestWebhookOutboxStaleLeaseCannotAcknowledge(t *testing.T) {
+	state := &outboxTestState{}
+	store := flowStore(t, state)
+	state.rows = 0
+	err := store.FinishWebhook(context.Background(), &model.WebhookOutboxClaim{Lease: "stale", Attempts: 2}, true, false)
+	if err == nil || !strings.Contains(err.Error(), "stale lease") {
+		t.Fatal(err)
+	}
+}
