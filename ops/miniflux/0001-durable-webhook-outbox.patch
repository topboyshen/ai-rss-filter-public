diff --git a/internal/storage/webhook_outbox.go b/internal/storage/webhook_outbox.go
new file mode 100644
index 0000000..7fd5d78
--- /dev/null
+++ b/internal/storage/webhook_outbox.go
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: Apache-2.0
+package storage
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"time"
+
+	"miniflux.app/v2/internal/crypto"
+	"miniflux.app/v2/internal/model"
+)
+
+const WebhookOutboxMaxRows = 5000
+const WebhookOutboxMaxBytes = 256 * 1024 * 1024
+
+var ErrWebhookOutboxBusy = errors.New("outbox: quota lock busy; new entry transaction rolled back")
+
+// Existing non-outbox callers still receive a plain sql.Tx. Only the enabled
+// producer uses one shared deadline for its entry, enclosures and outbox writes.
+type entryTransaction interface {
+	Exec(string, ...any) (sql.Result, error)
+	QueryRow(string, ...any) *sql.Row
+	Commit() error
+	Rollback() error
+}
+
+type boundedEntryTransaction struct {
+	*sql.Tx
+	ctx    context.Context
+	cancel context.CancelFunc
+}
+
+func (tx *boundedEntryTransaction) Exec(query string, args ...any) (sql.Result, error) {
+	return tx.Tx.ExecContext(tx.ctx, query, args...)
+}
+func (tx *boundedEntryTransaction) QueryRow(query string, args ...any) *sql.Row {
+	return tx.Tx.QueryRowContext(tx.ctx, query, args...)
+}
+func (tx *boundedEntryTransaction) Commit() error {
+	defer tx.cancel()
+	return tx.Tx.Commit()
+}
+func (tx *boundedEntryTransaction) Rollback() error {
+	defer tx.cancel()
+	return tx.Tx.Rollback()
+}
+func (s *Storage) beginEntryTransaction(durable bool) (entryTransaction, error) {
+	if !durable {
+		return s.db.Begin()
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	return &boundedEntryTransaction{Tx: tx, ctx: ctx, cancel: cancel}, nil
+}
+
+func (s *Storage) enqueueWebhook(tx entryTransaction, item *model.DurableWebhook, userID, feedID, entryID int64) error {
+	if item == nil {
+		return errors.New("outbox: nil prepared delivery")
+	}
+	// Serialize quota checks across producers and ensure WAL flush before entry
+	// commit. No network occurs under this transaction/advisory lock.
+	if _, err := tx.Exec(`SET LOCAL synchronous_commit=on`); err != nil {
+		return err
+	}
+	var durable bool
+	if err := tx.QueryRow(`SELECT current_setting('fsync')='on' AND current_setting('full_page_writes')='on'`).Scan(&durable); err != nil {
+		return err
+	}
+	if !durable {
+		return errors.New("outbox: PostgreSQL durability settings disabled")
+	}
+	var locked bool
+	if err := tx.QueryRow(`SELECT pg_try_advisory_xact_lock(19500622)`).Scan(&locked); err != nil {
+		return err
+	}
+	if !locked {
+		return ErrWebhookOutboxBusy
+	}
+	var count, size int64
+	if err := tx.QueryRow(`SELECT count(*),COALESCE(sum(octet_length(body)+octet_length(target_url)+octet_length(contract)+1024),0) FROM webhook_outbox`).Scan(&count, &size); err != nil {
+		return err
+	}
+	if count >= WebhookOutboxMaxRows || size+int64(len(item.Body)+len(item.URL)+len(item.Contract)+1024) > WebhookOutboxMaxBytes {
+		return errors.New("outbox: capacity exceeded; new entry transaction rolled back")
+	}
+	_, err := tx.Exec(`INSERT INTO webhook_outbox(delivery_id,body_sha256,user_id,feed_id,entry_id,target_url,signature,contract,body)
+	 VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)`, item.DeliveryID, item.BodySHA256, userID, feedID, entryID, item.URL, item.Signature, item.Contract, item.Body)
+	return err
+}
+
+// ClaimWebhook uses PostgreSQL time and a renewable-by-reclaim lease. A process
+// dying after HTTP success cannot lose the row; the same bytes will be retried.
+func (s *Storage) ClaimWebhook(ctx context.Context) (*model.WebhookOutboxClaim, error) {
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	if _, err = tx.ExecContext(ctx, `SET LOCAL synchronous_commit=on`); err != nil {
+		return nil, err
+	}
+	var durable bool
+	if err = tx.QueryRowContext(ctx, `SELECT current_setting('fsync')='on' AND current_setting('full_page_writes')='on'`).Scan(&durable); err != nil {
+		return nil, err
+	}
+	if !durable {
+		return nil, errors.New("outbox: PostgreSQL durability settings disabled before claim")
+	}
+	// Exhaustion never deletes payloads or pretends delivery succeeded.
+	_, err = tx.ExecContext(ctx, `UPDATE webhook_outbox SET state='held',last_error='attempt_or_age_limit',lease_token=NULL,lease_until=NULL
+	 WHERE state IN ('pending','inflight') AND (lease_until IS NULL OR lease_until<now())
+	 AND (attempts>=20 OR created_at<now()-interval '7 days')`)
+	if err != nil {
+		return nil, err
+	}
+	claim := &model.WebhookOutboxClaim{Lease: crypto.GenerateRandomStringHex(16)}
+	query := `UPDATE webhook_outbox SET state='inflight',attempts=attempts+1,lease_token=$1,lease_until=now()+interval '30 seconds'
+	 WHERE delivery_id=(SELECT delivery_id FROM webhook_outbox
+	 WHERE ((state='pending' AND next_attempt_at<=now()) OR (state='inflight' AND lease_until<now()))
+	 AND attempts<20 AND created_at>=now()-interval '7 days'
+	 ORDER BY next_attempt_at,delivery_id FOR UPDATE SKIP LOCKED LIMIT 1)
+	 RETURNING delivery_id,body_sha256,target_url,signature,contract,body,attempts`
+	err = tx.QueryRowContext(ctx, query, claim.Lease).Scan(&claim.DeliveryID, &claim.BodySHA256, &claim.URL, &claim.Signature, &claim.Contract, &claim.Body, &claim.Attempts)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, tx.Commit()
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	return claim, nil
+}
+
+// FinishWebhook needs the current lease token; stale senders cannot acknowledge
+// or reschedule a newer claim. A failed DB acknowledgement remains replayable.
+func (s *Storage) FinishWebhook(ctx context.Context, claim *model.WebhookOutboxClaim, acknowledged, retry bool) error {
+	state, failure := "held", "receipt_or_status_requires_review"
+	if acknowledged {
+		state, failure = "acked", ""
+	} else if retry && claim.Attempts < 20 {
+		state, failure = "pending", "transport_or_backend_failure"
+	}
+	delay := 1 << min(claim.Attempts, 10)
+	result, err := s.db.ExecContext(ctx, `UPDATE webhook_outbox SET state=$1,last_error=$2,
+	 next_attempt_at=now()+($3 * interval '1 second'),lease_token=NULL,lease_until=NULL,
+	 acked_at=CASE WHEN $1='acked' THEN now() ELSE NULL END
+	 WHERE delivery_id=$4 AND state='inflight' AND lease_token=$5 AND lease_until>=now()`, state, failure, delay, claim.DeliveryID, claim.Lease)
+	if err != nil {
+		return err
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return fmt.Errorf("outbox: stale lease, no result recorded")
+	}
+	return nil
+}
+
+// CleanupWebhookReceipts removes only bounded acknowledged records after the
+// minimum seven-day receipt retention; unacknowledged bodies have no expiry.
+func (s *Storage) CleanupWebhookReceipts(ctx context.Context) error {
+	_, err := s.db.ExecContext(ctx, `DELETE FROM webhook_outbox WHERE delivery_id IN
+	 (SELECT delivery_id FROM webhook_outbox WHERE state='acked' AND acked_at<now()-interval '7 days'
+	 ORDER BY acked_at LIMIT 20)`)
+	return err
+}
diff --git a/internal/storage/webhook_outbox_integration_test.go b/internal/storage/webhook_outbox_integration_test.go
new file mode 100644
index 0000000..57aacd9
--- /dev/null
+++ b/internal/storage/webhook_outbox_integration_test.go
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: Apache-2.0
+package storage
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"miniflux.app/v2/internal/database"
+	"miniflux.app/v2/internal/integration/webhook"
+	"miniflux.app/v2/internal/model"
+)
+
+// Opt-in isolated PostgreSQL tests. Every test keeps its own schema for evidence;
+// never point this at production. The runner only exposes a fresh local volume.
+func realOutboxStore(t *testing.T) (*Storage, *model.Feed, model.PrepareEntryWebhook) {
+	t.Helper()
+	dsn := os.Getenv("MINIFLUX_OUTBOX_TEST_DSN")
+	if dsn == "" {
+		t.Skip("explicit isolated PostgreSQL DSN not configured")
+	}
+	u, err := url.Parse(dsn)
+	if err != nil || (u.Hostname() != "127.0.0.1" && u.Hostname() != "localhost") || u.Path != "/synthetic_outbox" {
+		t.Fatal("only explicit local synthetic_outbox database is allowed")
+	}
+	db, err := sql.Open("postgres", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	schema := fmt.Sprintf("outbox_test_%d", time.Now().UnixNano())
+	if _, err = db.Exec(`CREATE SCHEMA ` + schema); err != nil {
+		db.Close()
+		t.Fatal(err)
+	}
+	db.Close()
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err = sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(8)
+	t.Cleanup(func() { db.Close() })
+	if err = database.Migrate(db); err != nil {
+		t.Fatal(err)
+	}
+	_, err = db.Exec(`INSERT INTO users(id,username,password) VALUES(1,'synthetic','not-login-capable');
+	 INSERT INTO categories(id,user_id,title) VALUES(1,1,'synthetic');
+	 INSERT INTO feeds(id,user_id,category_id,title,feed_url,site_url) VALUES(1,1,1,'synthetic','https://synthetic.invalid/feed','https://synthetic.invalid');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	feed := &model.Feed{ID: 1, UserID: 1, Category: &model.Category{ID: 1, Title: "synthetic"}, FeedURL: "https://synthetic.invalid/feed"}
+	prepare := func(entry *model.Entry) (*model.DurableWebhook, error) {
+		return webhook.PrepareDurable(feed, entry, "https://receiver.invalid/webhook", "synthetic-key", "audit-contract")
+	}
+	t.Log("retained schema", schema)
+	return NewStorage(db), feed, prepare
+}
+
+func realEntry(hash string) *model.Entry {
+	return &model.Entry{Hash: hash, Title: "Synthetic " + hash, Content: "Only synthetic content", URL: "https://synthetic.invalid/" + hash, Date: time.Now().UTC()}
+}
+func realCounts(t *testing.T, store *Storage) (int, int) {
+	t.Helper()
+	var entries, outbox int
+	if err := store.db.QueryRow(`SELECT (SELECT count(*) FROM entries),(SELECT count(*) FROM webhook_outbox)`).Scan(&entries, &outbox); err != nil {
+		t.Fatal(err)
+	}
+	return entries, outbox
+}
+
+func TestPostgresOutboxAtomicRejectAndDuplicate(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("a")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("a")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	e, o := realCounts(t, store)
+	if e != 1 || o != 1 {
+		t.Fatalf("duplicate %d/%d", e, o)
+	}
+	_, err := store.db.Exec(`CREATE FUNCTION reject_outbox_insert() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic storage failure'; END $$;
+	 CREATE TRIGGER synthetic_outbox_full BEFORE INSERT ON webhook_outbox FOR EACH ROW EXECUTE FUNCTION reject_outbox_insert();`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("b")}, false, prepare); err == nil {
+		t.Fatal("outbox write failure ignored")
+	}
+	e, o = realCounts(t, store)
+	if e != 1 || o != 1 {
+		t.Fatalf("failed new entry survived %d/%d", e, o)
+	}
+}
+
+func TestPostgresOutboxLeaseRecoveryAndImmutableEvidence(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	ctx := context.Background()
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("lease")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	first, err := store.ClaimWebhook(ctx)
+	if err != nil || first == nil {
+		t.Fatal(err)
+	}
+	if second, err := store.ClaimWebhook(ctx); err != nil || second != nil {
+		t.Fatalf("active lease taken %v %v", second, err)
+	}
+	if _, err = store.db.Exec(`UPDATE webhook_outbox SET lease_until=now()-interval '1 second'`); err != nil {
+		t.Fatal(err)
+	}
+	second, err := store.ClaimWebhook(ctx)
+	if err != nil || second == nil {
+		t.Fatal(err)
+	}
+	if second.Attempts != 2 || second.Lease == first.Lease || string(second.Body) != string(first.Body) || second.Signature != first.Signature {
+		t.Fatal("recovery changed original")
+	}
+	if store.FinishWebhook(ctx, first, true, false) == nil {
+		t.Fatal("stale claimant acknowledged")
+	}
+	if _, err = store.db.Exec(`UPDATE webhook_outbox SET body='changed'::bytea`); err == nil {
+		t.Fatal("immutable body modified")
+	}
+	if _, err = store.db.Exec(`DELETE FROM webhook_outbox`); err == nil {
+		t.Fatal("unacknowledged evidence deleted")
+	}
+	if err = store.FinishWebhook(ctx, second, true, false); err != nil {
+		t.Fatal(err)
+	}
+	var state string
+	if err = store.db.QueryRow(`SELECT state FROM webhook_outbox`).Scan(&state); err != nil || state != "acked" {
+		t.Fatal(state, err)
+	}
+	if _, err = store.db.Exec(`DELETE FROM webhook_outbox`); err == nil {
+		t.Fatal("recent receipt deleted")
+	}
+	if _, err = store.db.Exec(`DELETE FROM feeds WHERE id=1`); err != nil {
+		t.Fatal(err)
+	}
+	e, o := realCounts(t, store)
+	if e != 0 || o != 1 {
+		t.Fatalf("feed cascade destroyed receipt %d/%d", e, o)
+	}
+}
+
+func TestPostgresOutboxAttemptExhaustionRetainsEvidence(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("held")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.db.Exec(`UPDATE webhook_outbox SET attempts=20`); err != nil {
+		t.Fatal(err)
+	}
+	if claim, err := store.ClaimWebhook(context.Background()); err != nil || claim != nil {
+		t.Fatalf("exhaustion dispatched %v %v", claim, err)
+	}
+	var state string
+	if err := store.db.QueryRow(`SELECT state FROM webhook_outbox`).Scan(&state); err != nil || state != "held" {
+		t.Fatal(state, err)
+	}
+	if err := store.CleanupWebhookReceipts(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	e, o := realCounts(t, store)
+	if e != 1 || o != 1 {
+		t.Fatal("held evidence lost")
+	}
+}
+
+func TestPostgresOutboxCapacityRollsBackNewEntry(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	_, err := store.db.Exec(`INSERT INTO webhook_outbox(delivery_id,body_sha256,user_id,feed_id,entry_id,target_url,signature,contract,body)
+	 SELECT encode(sha256(i::text::bytea),'hex'),encode(sha256(i::text::bytea),'hex'),1,1,-i,'https://receiver.invalid',repeat('a',64),'audit',i::text::bytea FROM generate_series(1,5000) i`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("full")}, false, prepare); err == nil || !strings.Contains(err.Error(), "capacity") {
+		t.Fatal(err)
+	}
+	e, o := realCounts(t, store)
+	if e != 0 || o != 5000 {
+		t.Fatalf("capacity atomicity %d/%d", e, o)
+	}
+}
+
+func TestPostgresOutboxConcurrentProducersAndClaims(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	var wait sync.WaitGroup
+	type admission struct {
+		id  int
+		err error
+	}
+	admissions := make(chan admission, 16)
+	for i := 0; i < 16; i++ {
+		wait.Add(1)
+		go func(i int) {
+			defer wait.Done()
+			_, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry(fmt.Sprint(i))}, false, prepare)
+			admissions <- admission{i, err}
+		}(i)
+	}
+	wait.Wait()
+	close(admissions)
+	accepted, rejected := 0, []int{}
+	for result := range admissions {
+		if result.err == nil {
+			accepted++
+		} else if errors.Is(result.err, ErrWebhookOutboxBusy) {
+			rejected = append(rejected, result.id)
+		} else {
+			t.Fatal(result.err)
+		}
+	}
+	e, o := realCounts(t, store)
+	if e != accepted || o != accepted {
+		t.Fatalf("admission not atomic: accepted=%d entries/outbox=%d/%d", accepted, e, o)
+	}
+	// This is an isolated re-delivery test, not an internal producer retry loop.
+	for _, id := range rejected {
+		var rejectedEntries, rejectedOutbox int
+		if err := store.db.QueryRow(`SELECT (SELECT count(*) FROM entries WHERE hash=$1),(SELECT count(*) FROM webhook_outbox WHERE convert_from(body,'UTF8')::jsonb->'entries'->0->>'hash'=$1)`, fmt.Sprint(id)).Scan(&rejectedEntries, &rejectedOutbox); err != nil {
+			t.Fatal(err)
+		}
+		if rejectedEntries != 0 || rejectedOutbox != 0 {
+			t.Fatal("backpressured entry or outbox survived")
+		}
+		if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry(fmt.Sprint(id))}, false, prepare); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 0; i < 16; i++ {
+		if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry(fmt.Sprint(i))}, false, prepare); err != nil {
+			t.Fatal(err)
+		}
+	}
+	e, o = realCounts(t, store)
+	if e != 16 || o != 16 {
+		t.Fatalf("re-delivery not idempotent %d/%d", e, o)
+	}
+	ids := make(chan string, 16)
+	results := make(chan error, 16)
+	for i := 0; i < 16; i++ {
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			claim, err := store.ClaimWebhook(context.Background())
+			if err != nil {
+				results <- err
+				return
+			}
+			if claim == nil {
+				results <- fmt.Errorf("missing due claim")
+				return
+			}
+			ids <- claim.DeliveryID
+		}()
+	}
+	wait.Wait()
+	close(ids)
+	close(results)
+	for err := range results {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	for id := range ids {
+		if seen[id] {
+			t.Fatal("duplicate concurrent ownership")
+		}
+		seen[id] = true
+	}
+	if len(seen) != 16 {
+		t.Fatal("missing ownership")
+	}
+}
+
+func TestPostgresOutboxHeldQuotaLockFailsWithoutWaiting(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	locked, err := store.db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer locked.Rollback()
+	if _, err := locked.Exec(`SELECT pg_advisory_xact_lock(19500622)`); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	rows, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("held-lock")}, false, prepare)
+	if !errors.Is(err, ErrWebhookOutboxBusy) || rows != nil || time.Since(start) > 2*time.Second {
+		t.Fatalf("quota wait not bounded: %v %v %s", rows, err, time.Since(start))
+	}
+	if e, o := realCounts(t, store); e != 0 || o != 0 {
+		t.Fatalf("failed admission survived %d/%d", e, o)
+	}
+	if err := locked.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("held-lock")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	if e, o := realCounts(t, store); e != 1 || o != 1 {
+		t.Fatalf("recovery not atomic %d/%d", e, o)
+	}
+}
+
+func TestPostgresOutboxEntrySQLSharesThreeSecondDeadline(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	_, err := store.db.Exec(`CREATE FUNCTION synthetic_entry_slow() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN PERFORM pg_sleep(8); RETURN NEW; END $$;
+	 CREATE TRIGGER synthetic_entry_sleep BEFORE INSERT ON entries FOR EACH ROW EXECUTE FUNCTION synthetic_entry_slow();`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	rows, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("slow")}, false, prepare)
+	elapsed := time.Since(start)
+	if err == nil || rows != nil || elapsed < 2500*time.Millisecond || elapsed > 5*time.Second {
+		t.Fatalf("entry deadline not enforced: %v %v %s", rows, err, elapsed)
+	}
+	if e, o := realCounts(t, store); e != 0 || o != 0 {
+		t.Fatalf("timed out entry survived %d/%d", e, o)
+	}
+}
+
+func TestPostgresOutboxClaimsForceSynchronousCommit(t *testing.T) {
+	store, _, prepare := realOutboxStore(t)
+	store.db.SetMaxOpenConns(1)
+	_, err := store.db.Exec(`SET synchronous_commit=off;
+	 CREATE TABLE synthetic_sync_audit(setting text);
+	 CREATE FUNCTION synthetic_record_sync() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN INSERT INTO synthetic_sync_audit VALUES(current_setting('synchronous_commit')); RETURN NEW; END $$;
+	 CREATE TRIGGER synthetic_sync_observer AFTER INSERT OR UPDATE ON webhook_outbox FOR EACH ROW EXECUTE FUNCTION synthetic_record_sync();`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("sync")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	claim, err := store.ClaimWebhook(context.Background())
+	if err != nil || claim == nil || claim.Attempts != 1 {
+		t.Fatalf("claim failed %v %v", claim, err)
+	}
+	var count, notOn int
+	if err := store.db.QueryRow(`SELECT count(*),count(*) FILTER(WHERE setting<>'on') FROM synthetic_sync_audit`).Scan(&count, &notOn); err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 || notOn != 0 {
+		t.Fatalf("entry or attempt not sync committed: observed=%d not_on=%d", count, notOn)
+	}
+	var outside string
+	if err := store.db.QueryRow(`SHOW synchronous_commit`).Scan(&outside); err != nil || outside != "off" {
+		t.Fatalf("session baseline changed %s %v", outside, err)
+	}
+}
+
+func TestPostgresOutboxDisabledPathDoesNotEnqueue(t *testing.T) {
+	store, _, _ := realOutboxStore(t)
+	rows, err := store.RefreshFeedEntries(1, 1, model.Entries{realEntry("old-path")}, false)
+	if err != nil || len(rows) != 1 {
+		t.Fatalf("default-off path failed %v %v", rows, err)
+	}
+	if e, o := realCounts(t, store); e != 1 || o != 0 {
+		t.Fatalf("default-off unexpectedly captured %d/%d", e, o)
+	}
+}
+
+// Separate processes plus a real isolated PostgreSQL restart are coordinated by
+// the local harness. These tests do not claim machine power-loss durability.
+func TestPostgresOutboxRestartPrepare(t *testing.T) {
+	if os.Getenv("MINIFLUX_OUTBOX_RESTART_PHASE") != "prepare" {
+		t.Skip("restart harness phase only")
+	}
+	store, _, prepare := realOutboxStore(t)
+	if _, err := store.RefreshFeedEntriesWithOutbox(1, 1, model.Entries{realEntry("restart")}, false, prepare); err != nil {
+		t.Fatal(err)
+	}
+	claim, err := store.ClaimWebhook(context.Background())
+	if err != nil || claim == nil {
+		t.Fatal(err)
+	}
+	// Expire the simulated dead sender's lease without a 30-second test sleep.
+	if _, err = store.db.Exec(`UPDATE webhook_outbox SET lease_until=now()-interval '1 second'`); err != nil {
+		t.Fatal(err)
+	}
+	_, err = store.db.Exec(`CREATE TABLE public.synthetic_outbox_restart_marker(schema_name text,delivery_id text,signature text,body bytea);
+	 INSERT INTO public.synthetic_outbox_restart_marker SELECT current_schema(),delivery_id,signature,body FROM webhook_outbox`)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPostgresOutboxRestartVerify(t *testing.T) {
+	if os.Getenv("MINIFLUX_OUTBOX_RESTART_PHASE") != "verify" {
+		t.Skip("restart harness phase only")
+	}
+	u, err := url.Parse(os.Getenv("MINIFLUX_OUTBOX_TEST_DSN"))
+	if err != nil || u.Hostname() != "127.0.0.1" || u.Path != "/synthetic_outbox" {
+		t.Fatal("isolated DSN required")
+	}
+	db, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	var schema, id, signature string
+	var body []byte
+	if err = db.QueryRow(`SELECT schema_name,delivery_id,signature,body FROM public.synthetic_outbox_restart_marker`).Scan(&schema, &id, &signature, &body); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(schema, "outbox_test_") {
+		t.Fatal("invalid evidence schema")
+	}
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	restarted, err := sql.Open("postgres", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restarted.Close()
+	store := NewStorage(restarted)
+	claim, err := store.ClaimWebhook(context.Background())
+	if err != nil || claim == nil {
+		t.Fatal(err)
+	}
+	if claim.DeliveryID != id || claim.Signature != signature || string(claim.Body) != string(body) || claim.Attempts != 2 {
+		t.Fatal("restart did not preserve exact original")
+	}
+	if err = store.FinishWebhook(context.Background(), claim, true, false); err != nil {
+		t.Fatal(err)
+	}
+}
