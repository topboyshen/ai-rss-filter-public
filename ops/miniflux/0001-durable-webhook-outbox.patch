+// SPDX-License-Identifier: Apache-2.0
+package worker
+
+import (
+	"context"
+	"log/slog"
+	"time"
+
+	"miniflux.app/v2/internal/integration/webhook"
+	"miniflux.app/v2/internal/storage"
+)
+
+// RunWebhookOutbox keeps a durable row until the exact receiver receipt is
+// acknowledged in PostgreSQL. It has no raw body/URL/key logging or silent
+// expiry. DB failure stops this polling pass; the next lease is re-read.
+func RunWebhookOutbox(ctx context.Context, store *storage.Storage) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		runWebhookOutboxPass(ctx, store)
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+func runWebhookOutboxPass(ctx context.Context, store *storage.Storage) {
+	dbCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	err := store.CleanupWebhookReceipts(dbCtx)
+	cancel()
+	if err != nil {
+		slog.Error("Webhook outbox cleanup failed; retaining pending evidence")
+		return
+	}
+	for i := 0; i < 10 && ctx.Err() == nil; i++ {
+		dbCtx, cancel = context.WithTimeout(ctx, 3*time.Second)
+		claim, err := store.ClaimWebhook(dbCtx)
+		cancel()
+		if err != nil {
+			slog.Error("Webhook outbox claim failed")
+			return
+		}
+		if claim == nil {
+			return
+		}
+		retry, sendErr := webhook.SendDurable(ctx, &claim.DurableWebhook)
+		if ctx.Err() != nil {
+			return
+		} // lease safely expires; do not acknowledge uncertainty
+		dbCtx, cancel = context.WithTimeout(ctx, 3*time.Second)
+		err = store.FinishWebhook(dbCtx, claim, sendErr == nil, retry)
+		cancel()
+		if err != nil {
+			slog.Error("Webhook outbox completion not recorded; evidence retained")
+			return
+		}
+		if sendErr != nil {
+			slog.Warn("Webhook outbox delivery retained", slog.String("delivery_id", claim.DeliveryID), slog.Bool("retry_scheduled", retry && claim.Attempts < 20))
+		}
+	}
+}
