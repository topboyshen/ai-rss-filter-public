+// SPDX-License-Identifier: Apache-2.0
+package database
+
+import "database/sql"
+
+func webhookOutboxMigration(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+		CREATE TABLE webhook_outbox (
+		 delivery_id text PRIMARY KEY CHECK(length(delivery_id)=64),
+		 body_sha256 text NOT NULL CHECK(body_sha256=delivery_id),
+		 user_id bigint NOT NULL, feed_id bigint NOT NULL, entry_id bigint NOT NULL,
+		 target_url text NOT NULL, signature text NOT NULL CHECK(length(signature)=64),
+		 contract text NOT NULL CHECK(contract<>''), body bytea NOT NULL,
+		 state text NOT NULL DEFAULT 'pending' CHECK(state IN ('pending','inflight','held','acked')),
+		 attempts integer NOT NULL DEFAULT 0 CHECK(attempts BETWEEN 0 AND 20),
+		 next_attempt_at timestamptz NOT NULL DEFAULT now(),
+		 lease_token text, lease_until timestamptz,
+		 created_at timestamptz NOT NULL DEFAULT now(), acked_at timestamptz,
+		 last_error text NOT NULL DEFAULT '',
+		 UNIQUE(user_id,feed_id,entry_id),
+		 CHECK(octet_length(body) BETWEEN 1 AND 1048576),
+		 CHECK(encode(sha256(body),'hex')=body_sha256)
+		);
+		CREATE INDEX webhook_outbox_due ON webhook_outbox(next_attempt_at,delivery_id)
+		 WHERE state IN ('pending','inflight');
+		CREATE FUNCTION protect_webhook_outbox() RETURNS trigger LANGUAGE plpgsql AS $$
+		BEGIN
+		 IF TG_OP='DELETE' THEN
+		  IF OLD.state<>'acked' OR OLD.acked_at IS NULL OR OLD.acked_at>now()-interval '7 days' THEN
+		   RAISE EXCEPTION 'unacknowledged or recent webhook evidence cannot be deleted';
+		  END IF;
+		  RETURN OLD;
+		 END IF;
+		 IF ROW(NEW.delivery_id,NEW.body_sha256,NEW.user_id,NEW.feed_id,NEW.entry_id,NEW.target_url,NEW.signature,NEW.contract,NEW.body,NEW.created_at)
+		  IS DISTINCT FROM ROW(OLD.delivery_id,OLD.body_sha256,OLD.user_id,OLD.feed_id,OLD.entry_id,OLD.target_url,OLD.signature,OLD.contract,OLD.body,OLD.created_at) THEN
+		  RAISE EXCEPTION 'immutable webhook evidence';
+		 END IF;
+		 RETURN NEW;
+		END $$;
+		CREATE TRIGGER webhook_outbox_guard BEFORE UPDATE OR DELETE ON webhook_outbox
+		 FOR EACH ROW EXECUTE FUNCTION protect_webhook_outbox();
+	`)
+	return err
+}
diff --git a/internal/integration/webhook/durable.go b/internal/integration/webhook/durable.go
new file mode 100644
index 0000000..e132d53
--- /dev/null
+++ b/internal/integration/webhook/durable.go
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: Apache-2.0
+package webhook
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/crypto"
+	"miniflux.app/v2/internal/http/client"
+	"miniflux.app/v2/internal/model"
+	"miniflux.app/v2/internal/version"
+)
+
+const MaxDurableBody = 1024 * 1024
+
+// PrepareDurable uses the existing JSON types and HMAC algorithm. A singleton
+// new_entries event lets each existing entry transaction own its own outbox row.
+func PrepareDurable(feed *model.Feed, entry *model.Entry, target, secret, contract string) (*model.DurableWebhook, error) {
+	u, err := url.Parse(target)
+	if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") || u.User != nil || u.Fragment != "" {
+		return nil, errors.New("outbox: invalid target")
+	}
+	if secret == "" || contract == "" || feed == nil || feed.Category == nil || entry == nil || entry.ID <= 0 || entry.FeedID != feed.ID || entry.UserID != feed.UserID {
+		return nil, errors.New("outbox: incomplete identity or secret")
+	}
+	body, err := json.Marshal(NewEntriesPayload(feed, model.Entries{entry}))
+	if err != nil {
+		return nil, err
+	}
+	if len(body) == 0 || len(body) > MaxDurableBody {
+		return nil, errors.New("outbox: body exceeds limit")
+	}
+	hash := sha256.Sum256(body)
+	digest := hex.EncodeToString(hash[:])
+	return &model.DurableWebhook{DeliveryID: digest, BodySHA256: digest, URL: target,
+		Signature: crypto.GenerateSHA256Hmac(secret, body), Contract: contract, Body: body}, nil
+}
+
+type DurableReceipt struct {
+	Schema     int    `json:"schema"`
+	Durable    bool   `json:"durable"`
+	BodySHA256 string `json:"body_sha256"`
+	DeliveryID string `json:"delivery_id"`
+}
+
+// SendDurable never treats ordinary 2xx, redirects or body-less 202 as ownership
+// transfer. The authenticated endpoint must implement this explicit receipt.
+// retry=false means retain the row for operator review, never discard it.
+func SendDurable(ctx context.Context, item *model.DurableWebhook) (retry bool, err error) {
+	httpClient := client.NewClientWithOptions(client.Options{Timeout: defaultClientTimeout,
+		BlockPrivateNetworks: !config.Opts.IntegrationAllowPrivateNetworks()})
+	httpClient.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	return sendDurable(ctx, item, httpClient)
+}
+
+func sendDurable(ctx context.Context, item *model.DurableWebhook, httpClient *http.Client) (bool, error) {
+	hash := sha256.Sum256(item.Body)
+	if item.BodySHA256 != hex.EncodeToString(hash[:]) || item.DeliveryID != item.BodySHA256 || len(item.Body) > MaxDurableBody {
+		return false, errors.New("outbox: immutable body mismatch")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, item.URL, bytes.NewReader(item.Body))
+	if err != nil {
+		return false, errors.New("outbox: invalid request")
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("User-Agent", "Miniflux/"+version.Version)
+	req.Header.Set("X-Miniflux-Signature", item.Signature)
+	req.Header.Set("X-Miniflux-Event-Type", NewEntriesEventType)
+	req.Header.Set("X-AI-Filter-Delivery-ID", item.DeliveryID)
+	res, err := httpClient.Do(req)
+	if err != nil {
+		return true, errors.New("outbox: transport failure")
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusAccepted {
+		return res.StatusCode == 429 || res.StatusCode >= 500, fmt.Errorf("outbox: status %d", res.StatusCode)
+	}
+	raw, err := io.ReadAll(io.LimitReader(res.Body, 4097))
+	if err != nil {
+		return true, errors.New("outbox: incomplete receipt")
+	}
+	if len(raw) > 4096 {
+		return false, errors.New("outbox: receipt exceeds bound")
+	}
+	var receipt DurableReceipt
+	// JSON's default last-key-wins behavior could turn contradictory durability
+	// evidence into success. Reject duplicate top-level receipt keys explicitly.
+	keys := json.NewDecoder(bytes.NewReader(raw))
+	start, keyErr := keys.Token()
+	if keyErr != nil || start != json.Delim('{') {
+		return false, errors.New("outbox: invalid receipt object")
+	}
+	seen := map[string]bool{}
+	for keys.More() {
+		key, keyErr := keys.Token()
+		name, ok := key.(string)
+		if keyErr != nil || !ok || seen[name] {
+			return false, errors.New("outbox: duplicate receipt key")
+		}
+		seen[name] = true
+		for _, reserved := range []string{"schema", "durable", "body_sha256", "delivery_id"} {
+			if name != reserved && strings.EqualFold(name, reserved) {
+				return false, errors.New("outbox: reserved receipt key alias")
+			}
+		}
+		var value json.RawMessage
+		if keys.Decode(&value) != nil {
+			return false, errors.New("outbox: invalid receipt value")
+		}
+		var target any
+		switch name {
+		case "schema":
+			target = &receipt.Schema
+		case "durable":
+			target = &receipt.Durable
+		case "body_sha256":
+			target = &receipt.BodySHA256
+		case "delivery_id":
+			target = &receipt.DeliveryID
+		}
+		if target != nil && json.Unmarshal(value, target) != nil {
+			return false, errors.New("outbox: invalid reserved receipt value")
+		}
+	}
+	if end, err := keys.Token(); err != nil || end != json.Delim('}') {
+		return false, errors.New("outbox: invalid receipt")
+	}
+	var trailing any
+	if keys.Decode(&trailing) != io.EOF || receipt.Schema != 1 || !receipt.Durable || receipt.DeliveryID != item.DeliveryID || receipt.BodySHA256 != item.BodySHA256 {
+		return false, errors.New("outbox: receipt identity mismatch")
+	}
+	return false, nil
+}
diff --git a/internal/integration/webhook/durable_test.go b/internal/integration/webhook/durable_test.go
new file mode 100644
index 0000000..faf2d03
--- /dev/null
+++ b/internal/integration/webhook/durable_test.go
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: Apache-2.0
+package webhook
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/model"
+)
+
+type durableTransport func(*http.Request) (*http.Response, error)
+
+func (f durableTransport) RoundTrip(req *http.Request) (*http.Response, error) { return f(req) }
+
+func fixtureDelivery(t *testing.T) *model.DurableWebhook {
+	t.Helper()
+	feed := &model.Feed{ID: 8, UserID: 3, Category: &model.Category{ID: 2, Title: "Synthetic"}, FeedURL: "https://synthetic.invalid/feed"}
+	entry := &model.Entry{ID: 11, UserID: 3, FeedID: 8, Title: "Example", Hash: "hash", Content: "Body", URL: "https://synthetic.invalid/item?q=1", CreatedAt: time.Unix(100, 0)}
+	item, err := PrepareDurable(feed, entry, "https://receiver.invalid/webhook", "synthetic-key", "audit-contract")
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected, err := json.Marshal(NewEntriesPayload(feed, model.Entries{entry}))
+	if err != nil || string(expected) != string(item.Body) {
+		t.Fatal("not exact existing payload serialization")
+	}
+	mac := hmac.New(sha256.New, []byte("synthetic-key"))
+	mac.Write(expected)
+	if item.Signature != hex.EncodeToString(mac.Sum(nil)) {
+		t.Fatal("original signature algorithm differs")
+	}
+	return item
+}
+
+func TestDurableExactOriginalAndReceipt(t *testing.T) {
+	item := fixtureDelivery(t)
+	client := &http.Client{Transport: durableTransport(func(req *http.Request) (*http.Response, error) {
+		body, _ := io.ReadAll(req.Body)
+		if string(body) != string(item.Body) || req.Header.Get("X-Miniflux-Signature") != item.Signature || req.Header.Get("X-Miniflux-Event-Type") != "new_entries" || req.Header.Get("X-AI-Filter-Delivery-ID") != item.DeliveryID {
+			t.Fatal("frozen delivery changed")
+		}
+		return &http.Response{StatusCode: 202, Body: io.NopCloser(strings.NewReader(`{"schema":1,"durable":true,"body_sha256":"` + item.BodySHA256 + `","delivery_id":"` + item.DeliveryID + `","accepted_strategy":"new-audit-only"}`))}, nil
+	})}
+	for i := 0; i < 2; i++ {
+		if _, err := sendDurable(context.Background(), item, client); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestDurableRejectsOrdinaryStatusAndWrongReceipts(t *testing.T) {
+	item := fixtureDelivery(t)
+	valid := `{"schema":1,"durable":true,"body_sha256":"` + item.BodySHA256 + `","delivery_id":"` + item.DeliveryID + `"}`
+	cases := []struct {
+		name  string
+		code  int
+		body  string
+		retry bool
+	}{
+		{"plain202", 202, `{}`, false}, {"plain200", 200, valid, false},
+		{"redirect", 302, valid, false}, {"unauthorized", 401, ``, false},
+		{"full", 503, ``, true}, {"throttle", 429, ``, true},
+		{"wrongHash", 202, strings.Replace(valid, item.BodySHA256, "wrong", 1), false},
+		{"notDurable", 202, strings.Replace(valid, "true", "false", 1), false},
+		{"badSchema", 202, strings.Replace(valid, `"schema":1`, `"schema":2`, 1), false},
+		{"trailing", 202, valid + `{}`, false}, {"oversize", 202, strings.Repeat(" ", 4097), false},
+		{"duplicate", 202, strings.Replace(valid, `"durable":true`, `"durable":false,"durable":true`, 1), false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			client := &http.Client{Transport: durableTransport(func(*http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: tc.code, Body: io.NopCloser(strings.NewReader(tc.body))}, nil
+			})}
+			retry, err := sendDurable(context.Background(), item, client)
+			if err == nil || retry != tc.retry {
+				t.Fatalf("retry=%v err=%v", retry, err)
+			}
+		})
+	}
+}
+
+func TestDurableTimeoutAndChangedBodyNeverAcknowledge(t *testing.T) {
+	item := fixtureDelivery(t)
+	calls := 0
+	client := &http.Client{Transport: durableTransport(func(*http.Request) (*http.Response, error) { calls++; return nil, errors.New("synthetic timeout") })}
+	retry, err := sendDurable(context.Background(), item, client)
+	if !retry || err == nil || calls != 1 {
+		t.Fatal("transport uncertainty lost")
+	}
+	item.Body = append(item.Body, ' ')
+	retry, err = sendDurable(context.Background(), item, client)
+	if retry || err == nil || calls != 1 {
+		t.Fatal("changed body sent")
+	}
+}
+
+func TestDurablePreparationBounds(t *testing.T) {
+	feed := &model.Feed{ID: 8, UserID: 3, Category: &model.Category{ID: 2}}
+	entry := &model.Entry{ID: 11, UserID: 3, FeedID: 8, Content: strings.Repeat("x", MaxDurableBody)}
+	if _, err := PrepareDurable(feed, entry, "https://receiver.invalid/webhook", "key", "contract"); err == nil {
+		t.Fatal("oversized body accepted")
+	}
+	entry.Content = "small"
+	for _, target := range []string{"", "file:///etc/passwd", "http://user:pass@receiver.invalid/webhook", "https://receiver.invalid/webhook#fragment"} {
+		if _, err := PrepareDurable(feed, entry, target, "key", "contract"); err == nil {
+			t.Fatal("invalid target accepted")
+		}
+	}
+	entry.UserID = 4
+	if _, err := PrepareDurable(feed, entry, "https://receiver.invalid/webhook", "key", "contract"); err == nil {
+		t.Fatal("mixed producer identity accepted")
+	}
+}
+
+func TestDurableRedirectDoesNotLeakFrozenBodyOrSignature(t *testing.T) {
+	t.Setenv("INTEGRATION_ALLOW_PRIVATE_NETWORKS", "1")
+	oldOptions := config.Opts
+	t.Cleanup(func() { config.Opts = oldOptions })
+	var err error
+	config.Opts, err = config.NewConfigParser().ParseEnvironmentVariables()
+	if err != nil {
+		t.Fatal(err)
+	}
+	item := fixtureDelivery(t)
+	var targetCalls atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		targetCalls.Add(1)
+		body, _ := io.ReadAll(req.Body)
+		if string(body) != string(item.Body) || req.Header.Get("X-Miniflux-Signature") != item.Signature {
+			t.Error("direct transport changed frozen delivery")
+		}
+		w.WriteHeader(http.StatusAccepted)
+		_ = json.NewEncoder(w).Encode(DurableReceipt{Schema: 1, Durable: true, BodySHA256: item.BodySHA256, DeliveryID: item.DeliveryID})
+	}))
+	defer target.Close()
+	for _, code := range []int{301, 302, 303, 307, 308} {
+		redirect := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			http.Redirect(w, req, target.URL, code)
+		}))
+		item.URL = redirect.URL
+		retry, err := SendDurable(context.Background(), item)
+		redirect.Close()
+		if retry || err == nil || targetCalls.Load() != 0 {
+			t.Fatalf("redirect %d leaked or acknowledged: retry=%v err=%v targetCalls=%d", code, retry, err, targetCalls.Load())
+		}
+	}
+	item.URL = target.URL
+	if retry, err := SendDurable(context.Background(), item); retry || err != nil || targetCalls.Load() != 1 {
+		t.Fatalf("direct endpoint did not acknowledge: retry=%v err=%v targetCalls=%d", retry, err, targetCalls.Load())
+	}
+}
+
+func TestDurableReservedKeyCaseAliasesNeverAcknowledge(t *testing.T) {
+	item := fixtureDelivery(t)
+	valid := `{"schema":1,"durable":true,"body_sha256":"` + item.BodySHA256 + `","delivery_id":"` + item.DeliveryID + `"}`
+	for _, field := range []struct{ key, good, bad string }{
+		{"schema", "1", "0"}, {"durable", "true", "false"},
+		{"body_sha256", `"` + item.BodySHA256 + `"`, `"wrong"`},
+		{"delivery_id", `"` + item.DeliveryID + `"`, `"wrong"`},
+	} {
+		variants := []string{""}
+		for _, char := range field.key {
+			next := []string{}
+			for _, prefix := range variants {
+				next = append(next, prefix+string(char))
+				if char >= 'a' && char <= 'z' {
+					next = append(next, prefix+strings.ToUpper(string(char)))
+				}
+			}
+			variants = next
+		}
+		for _, alias := range variants {
+			if alias == field.key {
+				continue
+			}
+			body := strings.Replace(valid, `"`+field.key+`":`+field.good,
+				`"`+field.key+`":`+field.bad+`,"`+alias+`":`+field.good, 1)
+			client := &http.Client{Transport: durableTransport(func(*http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: 202, Body: io.NopCloser(strings.NewReader(body))}, nil
+			})}
+			if retry, err := sendDurable(context.Background(), item, client); retry || err == nil {
+				t.Fatalf("reserved alias acknowledged: %s", alias)
+			}
+		}
+	}
+}
