# Optional overrides for /usr/local/sbin/ai-filter-ops-check.
# Install as /etc/ai-filter/ops-monitor.env with mode 0600. Never commit secrets.
AI_FILTER_ROOT=/root/ai-rss-filter
OPS_BACKUP_DIR=/root/backups/system
OPS_BACKUP_MAX_AGE_SECONDS=108000
OPS_ALERT_COOLDOWN_SECONDS=1800
OPS_RUN_BUDGET_SECONDS=55
OPS_COMMAND_TIMEOUT_SECONDS=10
OPS_METRICS_URL=http://127.0.0.1:5000/metrics
OPS_BACKUP_REVERIFY_SECONDS=86400
OPS_RESTORE_DRILL_MAX_AGE_SECONDS=691200
OPS_RESTORE_DRILL_RUNNING_GRACE_SECONDS=3000
OPS_REQUIRED_SERVICES=redis,rsshub,ai-filter-web,ai-filter-api,ai-filter-worker
OPS_APP_SERVICES=ai-filter-api,ai-filter-worker

# Keep 0 until an encrypted off-host hook is deliberately configured and tested.
OPS_REQUIRE_OFFSITE_UPLOAD=0
# SYSTEM_BACKUP_UPLOAD_HOOK=/absolute/root-owned/executable
# SYSTEM_BACKUP_UPLOAD_REQUIRED=0

# Optional Telegram channel. Prefer root-only environment/config injection.
# OPS_TELEGRAM_BOT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=
# If Telegram is unreachable directly, use a trusted loopback proxy and keep
# loopback metrics/API calls out of it.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,::1
